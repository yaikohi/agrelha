package pages

templ UpdateList(updates []ModUpdate) {
	if len(updates) == 0 {
		<p class="px-3 py-3 text-xs text-zinc-500">All installed mods are up to date.</p>
	} else {
		<ul class="max-h-72 divide-y divide-zinc-800 overflow-y-auto">
			for _, u := range updates {
				<li class="flex items-center gap-2 px-3 py-2 text-xs">
					<input type="checkbox" data-bind={ "selected." + u.Token } class="h-3.5 w-3.5 shrink-0 accent-emerald-500"/>
					<span class="min-w-0 flex-1 truncate font-mono text-zinc-300">{ u.Key }</span>
					<span class="shrink-0 text-zinc-500">{ u.Current }</span>
					<span class="shrink-0 text-zinc-600">→</span>
					<span class="shrink-0 font-medium text-emerald-300">{ u.Latest }</span>
				</li>
			}
		</ul>
	}
}
