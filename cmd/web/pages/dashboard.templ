package pages

templ Dashboard(grafanaURL, flashKind, flashMsg string) {
	@Layout("Agrelha") {
		@nav()
		@flashBanner(flashKind, flashMsg)
		<div data-signals="{players:'—',cpu:'—',mem:'—',uptime:'—',state:'unknown',backup:'—',backupinfo:''}" data-effect="@get('/sse')">
			<section class="grid grid-cols-2 gap-4 sm:grid-cols-4">
				@tile("Players", "players")
				@tile("CPU", "cpu")
				@tile("Memory", "mem")
				@tile("Uptime", "uptime")
			</section>
			<section class="mt-4 text-sm text-zinc-400">
				Last backup: <span class="text-zinc-200" data-text="$backup"></span>
				<span class="ml-2 text-zinc-600" data-text="$backupinfo"></span>
			</section>
			<section class="mt-6 flex flex-wrap gap-3">
				<form method="post" action="/server/restart">
					<button class="rounded bg-amber-600 px-4 py-2 text-sm font-medium hover:bg-amber-500">Restart</button>
				</form>
				<form method="post" action="/server/update">
					<button title="Restarts the server — the image installs any Valheim update on boot" class="rounded bg-sky-700 px-4 py-2 text-sm font-medium hover:bg-sky-600">Update</button>
				</form>
				<form method="post" action="/server/stop">
					<button class="rounded bg-red-700 px-4 py-2 text-sm font-medium hover:bg-red-600">Stop</button>
				</form>
				<form method="post" action="/server/start">
					<button class="rounded bg-emerald-700 px-4 py-2 text-sm font-medium hover:bg-emerald-600">Start</button>
				</form>
				if grafanaURL != "" {
					<a href={ templ.SafeURL(grafanaURL) } target="_blank" class="ml-auto rounded border border-zinc-700 px-4 py-2 text-sm hover:bg-zinc-800">Full metrics in Grafana ↗</a>
				}
			</section>
			<section class="mt-8">
				<h2 class="mb-2 text-sm font-medium text-zinc-400">Logs</h2>
				<pre id="logs" class="h-72 overflow-auto rounded bg-black/60 p-4 font-mono text-xs text-zinc-300"></pre>
			</section>
		</div>
	}
}

templ tile(label, signal string) {
	<div class="rounded-lg bg-zinc-900 p-4">
		<div class="text-xs uppercase tracking-wide text-zinc-500">{ label }</div>
		<div class="mt-1 text-2xl font-semibold" data-text={ "$" + signal }></div>
	</div>
}
