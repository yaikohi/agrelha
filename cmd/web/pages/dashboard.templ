package pages

// Dashboard: on load it opens the SSE stream (@get('/sse')) which patches the
// tile signals every 5s and appends log lines into #logs.
templ Dashboard(grafanaURL string) {
	@Layout("Valheim") {
		@nav()
		<div data-signals="{players:'—',cpu:'—',mem:'—',uptime:'—',state:'unknown'}" data-effect="@get('/sse')">
			<section class="grid grid-cols-2 gap-4 sm:grid-cols-4">
				@tile("Players", "players")
				@tile("CPU", "cpu")
				@tile("Memory", "mem")
				@tile("Uptime", "uptime")
			</section>
			<section class="mt-8 flex flex-wrap gap-3">
				<button data-on-click="@post('/server/restart')" class="rounded bg-amber-600 px-4 py-2 text-sm font-medium hover:bg-amber-500">Restart</button>
				<button data-on-click="@post('/server/stop')" class="rounded bg-red-700 px-4 py-2 text-sm font-medium hover:bg-red-600">Stop</button>
				<button data-on-click="@post('/server/start')" class="rounded bg-emerald-700 px-4 py-2 text-sm font-medium hover:bg-emerald-600">Start</button>
				if grafanaURL != "" {
					<a href={ templ.SafeURL(grafanaURL) } target="_blank" class="ml-auto rounded border border-zinc-700 px-4 py-2 text-sm hover:bg-zinc-800">Full metrics in Grafana ↗</a>
				}
			</section>
			<section class="mt-8">
				<h2 class="mb-2 text-sm font-medium text-zinc-400">Logs</h2>
				<pre id="logs" class="h-72 overflow-auto rounded bg-black/60 p-4 font-mono text-xs text-zinc-300"></pre>
			</section>
		</div>
	}
}

templ tile(label, signal string) {
	<div class="rounded-lg bg-zinc-900 p-4">
		<div class="text-xs uppercase tracking-wide text-zinc-500">{ label }</div>
		<div class="mt-1 text-2xl font-semibold" data-text={ "$" + signal }></div>
	</div>
}
