package pages

templ Dashboard(grafanaURL, flashKind, flashMsg string) {
	@Layout("Agrelha") {
		@nav()
		@flashBanner(flashKind, flashMsg)
		<div class="space-y-8">
			<!-- Game Servers Grid -->
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
				<!-- Valheim Dedicated Card -->
				<div class="rounded-lg border border-zinc-800 bg-zinc-900/60 p-5 flex flex-col justify-between">
					<div>
						<div class="flex items-center justify-between pb-3 border-b border-zinc-800">
							<div class="flex items-center gap-2.5">
								<span class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
								<h2 class="text-lg font-semibold text-zinc-100">Valheim Dedicated</h2>
							</div>
							<span class="rounded bg-zinc-800 px-2 py-0.5 text-xs text-zinc-400 font-mono">game-01</span>
						</div>
						<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
							@tile("Players", "players")
							@tile("CPU", "cpu")
							@tile("Memory", "mem")
							@tile("Uptime", "uptime")
						</div>
						<div class="mt-3 text-xs text-zinc-500">
							Last backup: <span class="text-zinc-300" data-text="$backup"></span>
							<span class="ml-1 text-zinc-600" data-text="$backupinfo"></span>
						</div>
					</div>
					<div class="mt-5 flex flex-wrap items-center gap-2 pt-4 border-t border-zinc-800/60">
						<button type="button" data-on:click="@post('/server/restart')" class="rounded bg-amber-600/90 px-3 py-1.5 text-xs font-medium hover:bg-amber-500">Restart</button>
						<button type="button" data-on:click="@post('/server/update')" title="Restarts the server — updates on boot" class="rounded bg-sky-700 px-3 py-1.5 text-xs font-medium hover:bg-sky-600">Update</button>
						<button type="button" data-on:click="@post('/server/stop')" class="rounded bg-red-800/80 px-3 py-1.5 text-xs font-medium hover:bg-red-700">Stop</button>
						<button type="button" data-on:click="@post('/server/start')" class="rounded bg-emerald-700 px-3 py-1.5 text-xs font-medium hover:bg-emerald-600">Start</button>
						<a href="/mods" class="ml-auto rounded border border-zinc-700 px-3 py-1.5 text-xs text-zinc-300 hover:bg-zinc-800">Manage Mods →</a>
					</div>
				</div>

				<!-- Minecraft NeoForge Card -->
				<div class="rounded-lg border border-zinc-800 bg-zinc-900/60 p-5 flex flex-col justify-between">
					<div>
						<div class="flex items-center justify-between pb-3 border-b border-zinc-800">
							<div class="flex items-center gap-2.5">
								<span class="h-2.5 w-2.5 rounded-full" data-class="{'bg-emerald-500 animate-pulse': $mc_state === 'Up', 'bg-amber-400 animate-pulse': $mc_state !== 'Up' && $mc_state !== 'Down' && $mc_state !== 'unknown', 'bg-red-500': $mc_state === 'Down' || $mc_state === 'unknown'}"></span>
								<h2 class="text-lg font-semibold text-zinc-100" data-text="'Minecraft ' + ($mc_loader || 'Modded')">Minecraft Modded</h2>
							</div>
							<span class="rounded bg-emerald-950/80 border border-emerald-800/40 px-2 py-0.5 text-xs text-emerald-400 font-mono">nf.ykhi.xyz</span>
						</div>
						<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
							@tile("Players", "mc_players")
							@tile("CPU", "mc_cpu")
							@tile("Memory", "mc_mem")
							@tile("Uptime", "mc_uptime")
						</div>
						<div class="mt-3 flex items-center justify-between text-xs text-zinc-500">
							<div>
								Engine: <span class="text-zinc-300 font-medium" data-text="$mc_loader || 'NeoForge'">NeoForge</span> · MC <span class="font-mono text-emerald-400">1.21.1</span> · Node <span class="text-zinc-300">game-01</span>
							</div>
							<div>
								State: <span class="text-zinc-300 font-medium" data-text="$mc_state"></span>
							</div>
						</div>
					</div>
					<div class="mt-5 flex flex-wrap items-center gap-2 pt-4 border-t border-zinc-800/60">
						<button type="button" data-on:click="@post('/minecraft/server/restart')" class="rounded bg-amber-600/90 px-3 py-1.5 text-xs font-medium hover:bg-amber-500">Restart</button>
						<button type="button" data-on:click="@post('/minecraft/server/stop')" class="rounded bg-red-800/80 px-3 py-1.5 text-xs font-medium hover:bg-red-700">Stop</button>
						<button type="button" data-on:click="@post('/minecraft/server/start')" class="rounded bg-emerald-700 px-3 py-1.5 text-xs font-medium hover:bg-emerald-600">Start</button>
						<a href="/minecraft/mods" class="ml-auto rounded bg-emerald-700 px-3 py-1.5 text-xs font-medium hover:bg-emerald-600">Mods →</a>
						<a href="/minecraft/configs" class="rounded border border-zinc-700 px-3 py-1.5 text-xs text-zinc-300 hover:bg-zinc-800">Configs</a>
						<a href="/minecraft/access" class="rounded border border-zinc-700 px-3 py-1.5 text-xs text-zinc-300 hover:bg-zinc-800">Access</a>
						if grafanaURL != "" {
							<a href={ templ.SafeURL(grafanaURL) } target="_blank" class="text-xs text-zinc-500 hover:text-zinc-300">Grafana ↗</a>
						}
					</div>
				</div>
			</div>

			<!-- Live Logs Section -->
			<section data-signals="{logServer: 'valheim'}" data-effect="@get('/sse/logs?server=' + $logServer)">
				<div class="mb-2 flex items-center justify-between">
					<h2 class="text-sm font-medium text-zinc-400">Live Server Logs</h2>
					<div class="flex items-center gap-1 rounded bg-zinc-900 p-0.5 text-xs">
						<button
							type="button"
							data-on:click="$logServer = 'valheim'; document.getElementById('logs').innerHTML = ''"
							data-class="{'bg-zinc-800 text-zinc-100 shadow-sm': $logServer === 'valheim', 'text-zinc-400 hover:text-zinc-200': $logServer !== 'valheim'}"
							class="rounded px-2.5 py-1 font-medium transition"
						>Valheim</button>
						<button
							type="button"
							data-on:click="$logServer = 'minecraft'; document.getElementById('logs').innerHTML = ''"
							data-class="{'bg-zinc-800 text-zinc-100 shadow-sm': $logServer === 'minecraft', 'text-zinc-400 hover:text-zinc-200': $logServer !== 'minecraft'}"
							class="rounded px-2.5 py-1 font-medium transition"
						>
							<span data-text="'Minecraft (' + ($mc_loader || 'NeoForge') + ')'">Minecraft</span>
						</button>
					</div>
				</div>
				<pre id="logs" class="h-64 overflow-auto rounded bg-black/60 p-4 font-mono text-xs text-zinc-300"></pre>
			</section>
		</div>
	}
}

templ tile(label, signal string) {
	<div class="rounded bg-zinc-950 p-3 border border-zinc-800/50">
		<div class="text-[10px] uppercase tracking-wide text-zinc-500">{ label }</div>
		<div class="mt-1 text-xl font-semibold" data-text={ "$" + signal }></div>
	</div>
}
