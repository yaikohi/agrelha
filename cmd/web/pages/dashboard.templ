package pages

import "fmt"

templ Dashboard(grafanaURL string, mcSummary MinecraftSummaryUI, isAdmin bool, flashKind, flashMsg string) {
	@Layout("Agrelha · Game Server Portal") {
		@nav(isAdmin)
		@flashBanner(flashKind, flashMsg)
		<div class="space-y-8">
			<!-- Header Banner -->
			<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-b border-zinc-800 pb-5">
				<div>
					<h1 class="text-2xl font-bold tracking-tight text-zinc-100">
						if isAdmin {
							Game Server Hub
						} else {
							Community Game Servers
						}
					</h1>
					<p class="mt-1 text-xs text-zinc-400">
						if isAdmin {
							Manage dedicated game servers on node <code class="text-zinc-300 font-mono">game-01</code>.
						} else {
							Direct-connect addresses and client modpack downloads for dedicated servers on the network.
						}
					</p>
				</div>
				<div class="flex items-center gap-2 text-xs">
					<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-950/70 border border-emerald-800/50 px-3 py-1 font-medium text-emerald-300">
						<span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
						Cluster Online
					</span>
					if isAdmin && grafanaURL != "" {
						<a
							href={ templ.SafeURL(grafanaURL) }
							target="_blank"
							rel="noopener noreferrer"
							class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1 font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition"
						>
							Grafana ↗
						</a>
					}
				</div>
			</div>

			<!-- Balanced Game Servers Grid -->
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
				<!-- CARD 1: VALHEIM DEDICATED -->
				<div class="flex flex-col justify-between rounded-2xl border border-zinc-800 bg-zinc-900/70 p-6 shadow-sm">
					<div>
						<!-- Top: Icon, Title, Address + Copy, Status, Access Pill -->
						<div class="flex items-start justify-between border-b border-zinc-800/80 pb-4">
							<div class="flex items-center gap-3">
								<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-950/40 text-2xl text-orange-400 ring-1 ring-orange-800/40">
									⚔️
								</div>
								<div>
									<div class="flex items-center gap-2">
										<h2 class="text-base font-semibold text-zinc-100">Valheim Dedicated</h2>
										<span class="rounded-full bg-zinc-800/80 px-2 py-0.5 text-[10px] font-medium text-zinc-400 border border-zinc-700/50">🔒 Password</span>
									</div>
									<div class="mt-0.5 flex items-center gap-2 font-mono text-xs text-zinc-400">
										<span>192.168.20.224:2456</span>
										<button
											type="button"
											data-on:click="navigator.clipboard.writeText('192.168.20.224:2456'); $toast = 'Copied Valheim address (192.168.20.224:2456) to clipboard!'; $toastkind = 'ok'"
											class="rounded bg-zinc-800 px-1.5 py-0.2 text-[10px] font-sans text-zinc-400 hover:bg-zinc-700 hover:text-zinc-200 transition"
										>
											Copy
										</button>
									</div>
								</div>
							</div>
							<div>
								<span
									class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium"
									data-class="{'bg-emerald-950/80 text-emerald-300 ring-1 ring-emerald-800/50': $state === 'running', 'bg-zinc-800 text-zinc-400': $state !== 'running'}"
								>
									<span
										class="h-1.5 w-1.5 rounded-full"
										data-class="{'bg-emerald-400 animate-pulse': $state === 'running', 'bg-zinc-500': $state !== 'running'}"
									></span>
									<span data-text="$state || 'Running'"></span>
								</span>
							</div>
						</div>

						<!-- Metrics grid -->
						if isAdmin {
							<div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
								@tile("Players", "players")
								@tile("CPU", "cpu")
								@tile("Memory", "mem")
								@tile("Uptime", "uptime")
							</div>
						} else {
							<div class="mt-5 grid grid-cols-2 gap-3">
								@tile("Online Players", "players")
								@tile("Server Uptime", "uptime")
							</div>
						}

						<!-- Modpack Download & Launcher Instructions -->
						<div class="mt-5 rounded-xl border border-emerald-900/40 bg-emerald-950/20 p-3.5">
							<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
								<div class="min-w-0">
									<div class="text-xs font-semibold text-emerald-200 flex items-center gap-1.5">
										<span>Client Modpack</span>
										<span class="rounded bg-emerald-900/60 px-1.5 py-0.2 text-[10px] font-mono text-emerald-300">.r2z</span>
									</div>
									<p class="mt-1 text-[11px] text-emerald-300/70 leading-relaxed">
										Import into <span class="text-emerald-200 font-medium">r2modman</span> or <span class="text-emerald-200 font-medium">Thunderstore Mod Manager</span> (Import &rarr; From file) to match all server mods.
									</p>
								</div>
								<a
									href="/mods/export"
									download
									class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white shadow hover:bg-emerald-600 transition"
								>
									📥 Download Modpack
								</a>
							</div>
						</div>

						<!-- Access notice -->
						<div class="mt-3 flex items-center justify-between text-[11px] text-zinc-500">
							<div>
								Password required — ask the host on Discord / WireGuard.
							</div>
							if isAdmin {
								<span class="font-mono text-zinc-400">game-01</span>
							}
						</div>
					</div>

					<!-- Bottom: Controls & Manager Link (Admin only) -->
					if isAdmin {
						<div class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-zinc-800/80 pt-4">
							<div class="flex flex-wrap items-center gap-1.5">
								<button type="button" data-on:click="@post('/server/restart')" class="rounded-lg bg-zinc-800 px-2.5 py-1 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white">Restart</button>
								<button type="button" data-on:click="@post('/server/update')" title="Restarts the server — updates on boot" class="rounded-lg bg-zinc-800 px-2.5 py-1 text-xs font-medium text-sky-300 hover:bg-zinc-700">Update</button>
								<button type="button" data-on:click="@post('/server/stop')" class="rounded-lg border border-amber-800/50 bg-amber-950/20 px-2.5 py-1 text-xs font-medium text-amber-200 hover:bg-amber-900/40">Stop</button>
								<button type="button" data-on:click="@post('/server/start')" class="rounded-lg bg-emerald-800/80 px-2.5 py-1 text-xs font-medium text-emerald-100 hover:bg-emerald-700">Start</button>
							</div>
							<a
								href="/mods"
								class="rounded-xl bg-emerald-700 px-4 py-1.5 text-xs font-semibold text-white shadow-md hover:bg-emerald-600 transition"
							>
								Open Valheim Manager &rarr;
							</a>
						</div>
					}
				</div>

				<!-- CARD 2: MINECRAFT WORLDS -->
				<div class="flex flex-col justify-between rounded-2xl border border-zinc-800 bg-zinc-900/70 p-6 shadow-sm">
					<div>
						<!-- Top: Icon, Title, Status, Access Pill -->
						<div class="flex items-start justify-between border-b border-zinc-800/80 pb-4">
							<div class="flex items-center gap-3">
								<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-950/40 text-2xl text-emerald-400 ring-1 ring-emerald-800/40">
									⛏️
								</div>
								<div>
									<div class="flex items-center gap-2">
										<h2 class="text-base font-semibold text-zinc-100">Minecraft Worlds</h2>
										<span class="rounded-full bg-zinc-800/80 px-2 py-0.5 text-[10px] font-medium text-zinc-400 border border-zinc-700/50">🛡️ Whitelist</span>
									</div>
									if isAdmin {
										<p class="font-mono text-xs text-zinc-400">{ fmt.Sprintf("%d / %d Worlds Saved", mcSummary.TotalInstances, mcSummary.MaxInstances) }</p>
									} else {
										<p class="text-xs text-zinc-400">Dedicated multi-world cluster</p>
									}
								</div>
							</div>
							<div>
								if mcSummary.RunningCount > 0 {
									<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-950/80 px-2.5 py-0.5 text-xs font-medium text-emerald-300 ring-1 ring-emerald-800/50">
										<span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
										{ fmt.Sprintf("%d Active", mcSummary.RunningCount) }
									</span>
								} else {
									<span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs font-medium text-zinc-400">
										<span class="h-1.5 w-1.5 rounded-full bg-zinc-500"></span>
										Offline
									</span>
								}
							</div>
						</div>

						<!-- Admin Metrics 4-tile grid -->
						if isAdmin {
							<div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
								<div class="rounded-xl bg-zinc-950 p-3 border border-zinc-800/50">
									<div class="text-[10px] uppercase tracking-wide text-zinc-500">Running</div>
									<div class="mt-1 text-xl font-semibold text-zinc-100">{ fmt.Sprintf("%d / %d", mcSummary.RunningCount, mcSummary.MaxRunning) }</div>
								</div>
								<div class="rounded-xl bg-zinc-950 p-3 border border-zinc-800/50">
									<div class="text-[10px] uppercase tracking-wide text-zinc-500">RAM Budget</div>
									<div class="mt-1 text-xl font-semibold text-emerald-400">{ fmt.Sprintf("%dG", mcSummary.UsedGiB) }<span class="text-xs text-zinc-500 font-normal"> / { fmt.Sprintf("%dG", mcSummary.TotalBudgetGiB) }</span></div>
								</div>
								@tile("Players", "mc_players")
								<div class="rounded-xl bg-zinc-950 p-3 border border-zinc-800/50">
									<div class="text-[10px] uppercase tracking-wide text-zinc-500">Capacity</div>
									<div class="mt-1 text-xl font-semibold text-zinc-100">{ fmt.Sprintf("%d / %d", mcSummary.TotalInstances, mcSummary.MaxInstances) }</div>
								</div>
							</div>
						}

						<!-- Active Worlds List for Players & Guests -->
						if len(mcSummary.ActiveInstances) > 0 {
							<div class="mt-5 space-y-3">
								for _, act := range mcSummary.ActiveInstances {
									<div class="rounded-xl border border-zinc-800 bg-zinc-950/70 p-4">
										<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-zinc-800/60 pb-3">
											<div>
												<div class="flex items-center gap-2">
													<span class="font-bold text-zinc-100">{ act.Name }</span>
													<span class="rounded bg-emerald-950 border border-emerald-800/60 px-1.5 py-0.2 text-[10px] font-medium text-emerald-300">Online</span>
													<span class="rounded bg-zinc-800 px-1.5 py-0.2 text-[10px] font-medium text-zinc-400">{ act.MCVersion } · { act.Loader }</span>
												</div>
												<div class="mt-1 flex items-center gap-2 font-mono text-xs text-emerald-400">
													<span>{ act.LBIP }:25565</span>
													<button
														type="button"
														data-on:click={ fmt.Sprintf("navigator.clipboard.writeText('%s:25565'); $toast = 'Copied %s address to clipboard!'; $toastkind = 'ok'", act.LBIP, act.Name) }
														class="rounded bg-zinc-800 px-1.5 py-0.2 text-[10px] font-sans text-zinc-400 hover:bg-zinc-700 hover:text-zinc-200 transition"
													>
														Copy
													</button>
												</div>
											</div>
											<a
												href={ templ.SafeURL(fmt.Sprintf("/api/minecraft/%d/mods/export", act.Number)) }
												download
												class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white shadow hover:bg-emerald-600 transition"
											>
												📥 Download Pack (.mrpack)
											</a>
										</div>
										<p class="mt-2.5 text-[11px] text-zinc-400 leading-relaxed">
											Import into <span class="text-zinc-200 font-medium">Prism Launcher</span> or <span class="text-zinc-200 font-medium">Modrinth App</span> (Add Instance &rarr; Import from zip) to install all required mods and configs.
										</p>
									</div>
								}
							</div>
						} else if mcSummary.ActiveInstance != nil {
							<div class="mt-5 rounded-xl border border-zinc-800 bg-zinc-950/70 p-4">
								<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-zinc-800/60 pb-3">
									<div>
										<div class="flex items-center gap-2">
											<span class="font-bold text-zinc-100">{ mcSummary.ActiveInstance.Name }</span>
											<span class="rounded bg-emerald-950 border border-emerald-800/60 px-1.5 py-0.2 text-[10px] font-medium text-emerald-300">Online</span>
											<span class="rounded bg-zinc-800 px-1.5 py-0.2 text-[10px] font-medium text-zinc-400">{ mcSummary.ActiveInstance.MCVersion } · { mcSummary.ActiveInstance.Loader }</span>
										</div>
										<div class="mt-1 flex items-center gap-2 font-mono text-xs text-emerald-400">
											<span>{ mcSummary.ActiveInstance.LBIP }:25565</span>
											<button
												type="button"
												data-on:click={ fmt.Sprintf("navigator.clipboard.writeText('%s:25565'); $toast = 'Copied %s address to clipboard!'; $toastkind = 'ok'", mcSummary.ActiveInstance.LBIP, mcSummary.ActiveInstance.Name) }
												class="rounded bg-zinc-800 px-1.5 py-0.2 text-[10px] font-sans text-zinc-400 hover:bg-zinc-700 hover:text-zinc-200 transition"
											>
												Copy
											</button>
										</div>
									</div>
									<a
										href={ templ.SafeURL(fmt.Sprintf("/api/minecraft/%d/mods/export", mcSummary.ActiveInstance.Number)) }
										download
										class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white shadow hover:bg-emerald-600 transition"
									>
										📥 Download Pack (.mrpack)
									</a>
								</div>
								<p class="mt-2.5 text-[11px] text-zinc-400 leading-relaxed">
									Import into <span class="text-zinc-200 font-medium">Prism Launcher</span> or <span class="text-zinc-200 font-medium">Modrinth App</span> (Add Instance &rarr; Import from zip) to install all required mods and configs.
								</p>
							</div>
						} else {
							<div class="mt-5 rounded-xl border border-zinc-800/80 bg-zinc-950/40 p-5 text-center">
								<p class="text-sm font-medium text-zinc-300">All Minecraft worlds are currently offline.</p>
								<p class="mt-1 text-xs text-zinc-500">Ask the server host on Discord / WireGuard to start a world!</p>
							</div>
						}

						<!-- Access notice -->
						<div class="mt-3 flex items-center justify-between text-[11px] text-zinc-500">
							<div>
								Whitelist required — ask the host on Discord / WireGuard to get added.
							</div>
							if isAdmin {
								<span class="font-mono text-zinc-400">game-01</span>
							}
						</div>
					</div>

					<!-- Bottom: Quick Controls & Portal Link (Admin only) -->
					if isAdmin {
						<div class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-zinc-800/80 pt-4">
							<div class="flex flex-wrap items-center gap-1.5">
								if mcSummary.ActiveInstance != nil {
									<button
										type="button"
										data-on:click={ fmt.Sprintf("@post('/api/minecraft/instances/%d/restart')", mcSummary.ActiveInstance.Number) }
										class="rounded-lg bg-zinc-800 px-2.5 py-1 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white"
									>
										Restart
									</button>
									<button
										type="button"
										data-on:click={ fmt.Sprintf("@post('/api/minecraft/instances/%d/stop')", mcSummary.ActiveInstance.Number) }
										class="rounded-lg border border-amber-800/50 bg-amber-950/20 px-2.5 py-1 text-xs font-medium text-amber-200 hover:bg-amber-900/40"
									>
										Stop
									</button>
									<a
										href={ templ.SafeURL(fmt.Sprintf("/minecraft/%d/configs", mcSummary.ActiveInstance.Number)) }
										class="rounded-lg border border-zinc-800 bg-zinc-800/50 px-2.5 py-1 text-xs text-zinc-300 hover:bg-zinc-700"
									>
										Configs
									</a>
								} else {
									<a
										href="/minecraft/create"
										class="rounded-lg bg-zinc-800 px-3 py-1 text-xs font-medium text-emerald-400 hover:bg-zinc-700"
									>
										+ Create World
									</a>
								}
								<a
									href="/minecraft/access"
									class="rounded-lg border border-zinc-800 bg-zinc-800/50 px-2.5 py-1 text-xs text-zinc-400 hover:bg-zinc-700 hover:text-zinc-200"
								>
									Access
								</a>
							</div>
							<a
								href="/minecraft"
								class="rounded-xl bg-emerald-700 px-4 py-1.5 text-xs font-semibold text-white shadow-md hover:bg-emerald-600 transition"
							>
								Open Minecraft Manager &rarr;
							</a>
						</div>
					}
				</div>
			</div>
		</div>
	}
}

templ tile(label, signal string) {
	<div class="rounded-xl bg-zinc-950 p-3 border border-zinc-800/50">
		<div class="text-[10px] uppercase tracking-wide text-zinc-500">{ label }</div>
		<div class="mt-1 text-xl font-semibold text-zinc-100" data-text={ "$" + signal }></div>
	</div>
}
