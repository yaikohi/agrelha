apiVersion: v1
kind: Service
metadata:
  name: {{ .ServiceName }}
  namespace: minecraft-modded
  labels:
    app: {{ .DeploymentName }}
    instance: "{{ .Number }}"
  annotations:
    io.cilium/lb-ipam-ips: "{{ .LBIP }}"
spec:
  type: LoadBalancer
  loadBalancerIP: {{ .LBIP }}
  selector:
    app: {{ .DeploymentName }}
  ports:
    - name: minecraft
      port: 25565
      targetPort: 25565
      protocol: TCP
    - name: query
      port: 25565
      targetPort: 25565
      protocol: UDP
    - name: rcon
      port: 25575
      targetPort: 25575
      protocol: TCP
