package pages

func isNavAdmin(admin []bool) bool {
	if len(admin) > 0 {
		return admin[0]
	}
	return true
}

templ nav(admin ...bool) {
	{{ isAdmin := isNavAdmin(admin) }}
	<nav class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-zinc-800/80 pb-4 text-sm">
		<!-- Left: Brand & Main Navigation -->
		<div class="flex flex-wrap items-center gap-4 sm:gap-6">
			<!-- Brand -->
			<a href="/" class="flex items-center gap-2 font-bold tracking-tight text-zinc-100 hover:text-white transition">
				<span class="flex h-6 w-6 items-center justify-center rounded-lg bg-emerald-500/20 text-emerald-400 font-mono text-xs ring-1 ring-emerald-500/30">A</span>
				<span>Agrelha</span>
			</a>

			<!-- Navigation Links -->
			<div class="flex flex-wrap items-center gap-1.5 text-xs">
				<a
					href="/"
					class="rounded-lg px-2.5 py-1 font-medium text-zinc-400 hover:bg-zinc-800/70 hover:text-zinc-100 transition"
				>
					Hub
				</a>

				if isAdmin {
					<a
						href="/valheim"
						class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 font-medium text-zinc-400 hover:bg-zinc-800/70 hover:text-zinc-100 transition"
					>
						Valheim
						<span
							data-show="$valheim_updates > 0"
							class="rounded-full border border-amber-800/60 bg-amber-950/70 px-1.5 py-0.5 text-[10px] font-semibold text-amber-300"
							title="Mod updates available"
							data-text="'↻ ' + $valheim_updates"
						></span>
					</a>

					<a
						href="/minecraft"
						class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 font-medium text-zinc-400 hover:bg-zinc-800/70 hover:text-zinc-100 transition"
					>
						Minecraft
						<span
							data-show="$mc_updates > 0"
							class="rounded-full border border-amber-800/60 bg-amber-950/70 px-1.5 py-0.5 text-[10px] font-semibold text-amber-300"
							title="Mod updates available"
							data-text="'↻ ' + $mc_updates"
						></span>
					</a>

					<!-- History -->
					<a
						href="/history"
						class="rounded-lg px-2.5 py-1 font-medium text-zinc-400 hover:bg-zinc-800/70 hover:text-zinc-100 transition"
					>
						History
					</a>
				}
			</div>
		</div>

		<!-- Right: Sign Out or Admin Sign In -->
		<div class="flex items-center gap-3">
			if isAdmin {
				<a
					href="/auth/logout"
					class="text-xs text-zinc-500 hover:text-zinc-300 transition"
				>
					Sign out
				</a>
			} else {
				<a
					href="/auth/login"
					class="rounded-lg border border-emerald-800/60 bg-emerald-950/40 px-3 py-1 text-xs font-medium text-emerald-300 hover:bg-emerald-900/60 hover:text-white transition"
				>
					Admin Sign In &rarr;
				</a>
			}
		</div>
	</nav>
}

// navGroup renders one game's nav cluster: the game entry plus its sub-pages.
templ navGroup(g NavGroupUI) {
	<div class="relative flex items-center gap-1 rounded-lg border border-zinc-800/60 bg-zinc-900/60 px-2 py-0.5">
		<a
			href={ templ.SafeURL(g.Href) }
			class="px-1 py-0.5 font-medium text-zinc-300 transition hover:text-white"
		>
			{ g.Label }
		</a>
		for _, l := range g.Links {
			<a
				href={ templ.SafeURL(l.Href) }
				class="px-1 py-0.5 text-[11px] text-zinc-500 transition hover:text-zinc-300"
			>{ l.Label }</a>
		}
		{ children... }
	</div>
}
