package pages

import "fmt"

templ incidentBadges(in IncidentUI) {
	if in.OOMKilled {
		<span class="rounded border border-red-700/60 bg-red-950/60 px-2 py-0.5 text-[10px] font-medium text-red-200">Out of memory</span>
	}
	if in.RestartCount > 0 {
		<span class="rounded border border-zinc-700 bg-zinc-900 px-2 py-0.5 font-mono text-[10px] text-zinc-300">
			{ fmt.Sprintf("%d restarts", in.RestartCount) }
		</span>
	}
	if in.ExitCode != 0 {
		<span class="rounded border border-zinc-700 bg-zinc-900 px-2 py-0.5 font-mono text-[10px] text-zinc-300">
			{ fmt.Sprintf("exit %d", in.ExitCode) }
		</span>
	}
}

templ IncidentList(d InstanceDetailUI) {
	<div class="space-y-4">
		<div>
			<h2 class="text-base font-semibold text-zinc-100">Crashes & failures</h2>
			<p class="mt-0.5 text-xs text-zinc-400">
				Every failure agrelha has recorded for this world, newest first. Dismissing one keeps it here but stops it appearing on the Overview.
			</p>
		</div>
		if len(d.Incidents) == 0 {
			<div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-8 text-center">
				<p class="text-sm font-medium text-zinc-300">No failures recorded</p>
				<p class="mt-1 text-xs text-zinc-500">This world has not crashed since agrelha started watching it.</p>
			</div>
		} else {
			<div class="space-y-3">
				for _, in := range d.Incidents {
					<div
						id={ fmt.Sprintf("incident-%d", in.ID) }
						class={ "rounded-xl border p-4 transition", templ.KV("border-red-900/60 bg-red-950/20", !in.Acknowledged), templ.KV("border-zinc-800 bg-zinc-900/40 opacity-60", in.Acknowledged) }
					>
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div class="min-w-0">
								<div class="flex items-center gap-2">
									<p class={ "text-sm font-semibold", templ.KV("text-red-100", !in.Acknowledged), templ.KV("text-zinc-400", in.Acknowledged) }>
										{ in.Summary }
									</p>
									if in.Acknowledged {
										<span class="rounded bg-zinc-800 px-1.5 py-0.5 text-[10px] font-medium text-zinc-400">dismissed</span>
									}
								</div>
								<p class="mt-0.5 text-xs text-zinc-500">
									{ in.When }
									if in.Ago != "" {
										<span class="text-zinc-600">{ " · " + in.Ago }</span>
									}
								</p>
							</div>
							<div class="flex flex-wrap items-center gap-1.5">
								@incidentBadges(in)
								if !in.Acknowledged {
									@dismissIncidentButton(in)
								}
							</div>
						</div>
						if in.LogTail != "" {
							<details class="mt-3">
								<summary class="cursor-pointer text-xs text-zinc-400 hover:text-zinc-200">Show the log from the crashed container</summary>
								<pre class="mt-2 max-h-80 overflow-auto rounded-lg border border-zinc-800 bg-zinc-950 p-3 font-mono text-[11px] leading-relaxed text-zinc-300">{ in.LogTail }</pre>
							</details>
						} else {
							<p class="mt-2 text-[11px] text-zinc-600">No log was captured — the container was replaced before agrelha could read it.</p>
						}
					</div>
				}
			</div>
		}
	</div>
}

templ dismissIncidentButton(in IncidentUI) {
	<button
		type="button"
		title="Dismiss this failure"
		aria-label="Dismiss this failure"
		data-on:click={ fmt.Sprintf("@post('/api/%s/%d/incidents/%d/dismiss')", in.GamePath, in.Number, in.ID) }
		class="flex h-6 w-6 items-center justify-center rounded-md border border-zinc-700 bg-zinc-900 text-xs text-zinc-400 transition hover:border-zinc-600 hover:bg-zinc-800 hover:text-zinc-100"
	>
		&times;
	</button>
}
