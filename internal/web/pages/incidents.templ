package pages

import "fmt"

templ incidentBadges(in IncidentUI) {
	if in.OOMKilled {
		<span class="font-pixel text-[11px] text-danger">out of memory</span>
	}
	if in.RestartCount > 0 {
		<span class="font-pixel text-[11px] text-ink-faint">{ fmt.Sprintf("%d restarts", in.RestartCount) }</span>
	}
	if in.ExitCode != 0 {
		<span class="font-pixel text-[11px] text-ink-faint">{ fmt.Sprintf("exit %d", in.ExitCode) }</span>
	}
}

templ incidentLog(tail string) {
	if tail != "" {
		<details class="mt-3">
			<summary class="focus-accent cursor-pointer font-pixel text-[11px] text-ink-muted transition-colors hover:text-accent">Show the log from the crashed container</summary>
			<pre class="mt-2 max-h-80 overflow-auto rounded-control border border-seam bg-seam p-3 font-pixel text-[11px] leading-relaxed text-ink-muted">{ tail }</pre>
		</details>
	} else {
		<p class="mt-2 font-pixel text-[11px] text-ink-faint">No log was captured — the container was replaced before agrelha could read it.</p>
	}
}

templ IncidentList(d InstanceDetailUI) {
	<div class="mt-8">
		<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
			<p class="max-w-prose font-display text-sm leading-relaxed text-ink-muted">
				A permanent record of every failure agrelha has seen for this world. Nothing here can be deleted; dismissing a failure on the Overview only stops it appearing there.
			</p>
			if len(d.Incidents) > 0 {
				@incidentSort(d)
			}
		</div>
		if len(d.Incidents) == 0 {
			<p class="mt-8 max-w-prose font-display text-base leading-relaxed text-ink-muted">
				Nothing has crashed. This world has not failed since agrelha started watching it.
			</p>
		} else {
			<div class="-mx-6 mt-8 border-t border-seam">
				for _, in := range d.Incidents {
					<article id={ fmt.Sprintf("incident-%d", in.ID) } class="border-b border-seam px-6 py-6">
						<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
							<div class="min-w-0">
								<p class={ "font-display text-lg font-semibold", templ.KV("text-ink", !in.Acknowledged), templ.KV("text-ink-faint", in.Acknowledged) }>
									{ in.Summary }
								</p>
								<p class="mt-1 flex flex-wrap items-baseline gap-x-3 font-pixel text-[11px] text-ink-faint">
									<span>{ in.When }</span>
									if in.Ago != "" {
										<span>{ in.Ago }</span>
									}
									if in.Acknowledged {
										<span>dismissed</span>
									}
								</p>
							</div>
							<div class="flex flex-wrap items-baseline gap-x-3">
								@incidentBadges(in)
							</div>
						</div>
						@incidentLog(in.LogTail)
					</article>
				}
			</div>
		}
	</div>
}

templ dismissIncidentButton(in IncidentUI) {
	<button
		type="button"
		title="Dismiss this failure"
		aria-label="Dismiss this failure"
		data-on:click={ fmt.Sprintf("@post('/api/%s/%d/incidents/%d/dismiss')", in.GamePath, in.Number, in.ID) }
		class="focus-accent rounded-control border border-edge px-2 py-0.5 font-pixel text-[11px] text-ink-muted transition-colors hover:border-accent hover:text-accent"
	>
		Dismiss
	</button>
}

templ incidentSort(d InstanceDetailUI) {
	<div class="flex shrink-0 items-baseline gap-4 font-pixel text-[11px]">
		<a
			href={ templ.SafeURL(fmt.Sprintf("/%s/%d/crashes?sort=newest", d.GamePath(), d.Number)) }
			aria-current={ ariaCurrent(!d.IncidentsOldestFirst) }
			class={ sortLinkClass(!d.IncidentsOldestFirst) }
		>
			Newest first
		</a>
		<a
			href={ templ.SafeURL(fmt.Sprintf("/%s/%d/crashes?sort=oldest", d.GamePath(), d.Number)) }
			aria-current={ ariaCurrent(d.IncidentsOldestFirst) }
			class={ sortLinkClass(d.IncidentsOldestFirst) }
		>
			Oldest first
		</a>
	</div>
}
