package pages

import (
	"fmt"

	"agrelha/internal/web/components"
)

// ValheimConfigsTab renders the BepInEx config editor for one world.
//
// It deliberately renders NO settings up front. Therzie.Warfare.cfg alone
// declares 1398 of them across 182 sections; putting that in the page is a
// multi-megabyte document and a hung browser. The operator picks a file, then a
// section or a search, and only the matches are fetched.
templ ValheimConfigsTab(d InstanceDetailUI) {
	<div
		data-signals={ fmt.Sprintf("{cfgFile: '', cfgSha: '', cfgSearch: '', cfgSection: '', cfgOnlyChanged: false, cfgRaw: false, cfgDirty: {}, cfgBusy: false, cfgNum: %d, cfgImport: '', cfgImportFile: '', cfgImportSha: '', cfgImportOpen: false}", d.Number) }
	>
		<div class="mt-10 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
			<div class="min-w-0">
				<h2 class="font-display text-xl font-semibold text-ink">Mod configuration</h2>
				<p class="mt-1 max-w-prose font-display text-sm leading-relaxed text-ink-muted">
					Settings come from the files the mods generate on the server. agrelha stores only the values you change, and applies them on the next restart.
				</p>
			</div>
			<div class="flex shrink-0 flex-wrap items-center gap-3">
				if d.ConfigsPublished != "" {
					<span class="font-pixel text-[11px] text-ink-faint">read { d.ConfigsPublished }</span>
				}
				if !d.ConfigsUnpublished && len(d.Configs) > 0 {
					<button
						type="button"
						data-on:click={ fmt.Sprintf("$cfgImportOpen = true; @get('/api/valheim/%d/configs/import')", d.Number) }
						class={ components.ButtonClass(components.VariantSecondary) }
					>
						Import config
					</button>
				}
			</div>
		</div>
		if d.RestartPending {
			@pendingRestartBanner(d)
		}
		if d.ConfigsError != "" {
			<p class="-mx-6 mt-6 border-y border-l-2 border-seam border-l-danger px-6 py-4 font-pixel text-xs text-danger">
				{ d.ConfigsError }
			</p>
		} else if d.ConfigsUnpublished {
			@configsNotPublished()
		} else if len(d.Configs) == 0 {
			<p class="mt-6 max-w-prose font-display text-sm leading-relaxed text-ink-muted">
				This world's mods have not written any configuration files.
			</p>
		} else {
			@configFileList(d)
			<div id="cfg-panel"></div>
		}
	</div>
}

// A world that has never started has published nothing. Saying "no configs"
// here would be a different, and wrong, claim.
templ configsNotPublished() {
	<div class="mt-6 max-w-prose space-y-2">
		<p class="font-display text-sm leading-relaxed text-ink-muted">No configuration has been published for this world yet.</p>
		<p class="font-display text-sm leading-relaxed text-ink-faint">
			Mods write their config files the first time the world runs. Start it once and they will appear here.
		</p>
	</div>
}

templ configFileList(d InstanceDetailUI) {
	<div class="-mx-6 mt-6 overflow-x-auto border-t border-seam">
		<table class="w-full text-left">
			<thead class="border-b border-seam">
				<tr class="font-pixel text-[11px] text-ink-faint">
					<th class="px-6 py-3 font-normal">Mod</th>
					<th class="px-6 py-3 text-right font-normal">Settings</th>
					<th class="px-6 py-3 text-right font-normal">Changed</th>
					<th class="px-6 py-3 text-right font-normal">Managed</th>
					<th class="px-6 py-3"></th>
				</tr>
			</thead>
			<tbody>
				for _, f := range d.Configs {
					<tr class="border-b border-seam transition-colors hover:bg-surface-raised">
						<td class="px-6 py-3">
							if f.Plugin != "" {
								<p class="flex flex-wrap items-baseline gap-x-3">
									<span class="font-display text-base font-semibold text-ink">{ f.Plugin }</span>
									if f.Version != "" {
										<span class="font-pixel text-[11px] text-ink-faint">v{ f.Version }</span>
									}
								</p>
								<p class="mt-0.5 break-all font-pixel text-[11px] text-ink-faint">{ f.Name }</p>
							} else {
								<p class="break-all font-pixel text-xs text-ink">{ f.Name }</p>
							}
						</td>
						<td class="px-6 py-3 text-right font-pixel text-xs tabular-nums text-ink-muted">
							if f.Parsable {
								{ fmt.Sprint(f.Settings) }
							} else {
								<span class="text-accent" title="agrelha could not read this file's structure; it opens in the raw editor">raw</span>
							}
						</td>
						<td class="px-6 py-3 text-right font-pixel text-xs tabular-nums">
							if f.Changed > 0 {
								<span class="text-accent" title="differ from the value the mod ships with">{ fmt.Sprint(f.Changed) }</span>
							} else {
								<span class="text-ink-faint">0</span>
							}
						</td>
						<td class="px-6 py-3 text-right font-pixel text-xs tabular-nums">
							if f.Overridden > 0 {
								<span class="text-ink" title="values agrelha pins in git">{ fmt.Sprint(f.Overridden) }</span>
							} else {
								<span class="text-ink-faint">0</span>
							}
						</td>
						<td class="px-6 py-3 text-right">
							<button
								type="button"
								data-on:click={ fmt.Sprintf("@get('/api/valheim/%d/configs/file?f=%s')", d.Number, f.Name) }
								class={ components.ButtonClass(components.VariantSecondary) }
							>
								Open
							</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// A change is committed but the running server has not read it: mods load
// their config once, at startup. The banner says what is waiting and why, and
// offers to overrule the wait.
templ pendingRestartBanner(d InstanceDetailUI) {
	<div class="-mx-6 mt-6 flex flex-wrap items-start justify-between gap-x-6 gap-y-3 border-y border-l-2 border-seam border-l-accent px-6 py-4">
		<div class="min-w-0">
			<p class="flex flex-wrap items-baseline gap-x-3">
				<span class="font-display text-base font-semibold text-accent">Waiting to restart</span>
				if d.RestartSince != "" {
					<span class="font-pixel text-[11px] text-ink-faint">waiting { d.RestartSince }</span>
				}
			</p>
			<p class="mt-1 max-w-prose font-display text-sm leading-relaxed text-ink-muted">{ d.RestartReason }</p>
			if d.RestartWaiting != "" {
				<p class="mt-1 max-w-prose font-display text-sm leading-relaxed text-ink-faint">Held because: { d.RestartWaiting }</p>
			} else {
				<p class="mt-1 max-w-prose font-display text-sm leading-relaxed text-ink-faint">The world is empty; this applies on the next check.</p>
			}
		</div>
		<button
			type="button"
			data-on:click={ fmt.Sprintf("if (confirm('Restart now?\\n\\nAnyone connected will be disconnected.')) { @post('/api/valheim/%d/restart/force') }", d.Number) }
			class={ "shrink-0 " + components.ButtonClass(components.VariantPrimary) }
		>
			Restart now
		</button>
	</div>
}
