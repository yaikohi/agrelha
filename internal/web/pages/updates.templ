package pages

import "fmt"
import "agrelha/internal/web/components"
import "strings"
import "agrelha/internal/web/shared"

templ ModUpdatePanel(d InstanceDetailUI) {
	<div class="mt-8">
		if len(d.ModsMissing) > 0 {
			<div class="-mx-6 border-y border-seam px-6 py-5">
				<p class="font-pixel text-[11px] text-danger">
					{ fmt.Sprintf("%d installed mod(s) are no longer published on %s", len(d.ModsMissing), d.UpstreamCatalogName()) }
				</p>
				<p class="mt-1 max-w-prose font-display text-sm leading-relaxed text-ink-muted">
					This world will fail to boot on its next restart — the setup step cannot download a package that no longer exists. Remove them, or pin a version you still have.
				</p>
				<p class="mt-2 break-all font-pixel text-[11px] text-ink">{ strings.Join(d.ModsMissing, ", ") }</p>
			</div>
		}
		<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
			<div class="min-w-0">
				if len(d.ModUpdates) > 0 {
					<p class="font-pixel text-[11px] text-accent">{ fmt.Sprintf("%d mod update(s) available", len(d.ModUpdates)) }</p>
				} else {
					<p class="font-pixel text-[11px] text-ink-faint">Mods are up to date</p>
				}
				<p class="mt-1 font-pixel text-[11px] text-ink-faint">{ checkSummary(d) }</p>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				if d.CanUndo {
					<button
						type="button"
						data-indicator="busy_undo_mods"
						data-attr:disabled="$busy_undo_mods"
						data-on:click={ undoClick(d) }
						class={ components.ButtonClass(components.VariantSecondary) }
						title={ "Restore the mod list from before the update applied " + d.UndoWhen }
					>
						<span data-show="!$busy_undo_mods">Undo last update</span>
						<span class="inline-flex items-center gap-1.5" data-show="$busy_undo_mods" style="display:none;">
							<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>
							<span>Restoring…</span>
						</span>
					</button>
				}
				<button
					type="button"
					data-indicator="busy_check_mods"
					data-attr:disabled="$busy_check_mods"
					data-on:click={ fmt.Sprintf("@post('/api/%s/%d/mods/updates/check')", d.GamePath(), d.Number) }
					class={ components.ButtonClass(components.VariantSecondary) }
				>
					<span data-show="!$busy_check_mods">Check now</span>
					<span class="inline-flex items-center gap-1.5" data-show="$busy_check_mods" style="display:none;">
						<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>
						<span>Checking…</span>
					</span>
				</button>
			</div>
		</div>
		if len(d.ModsUnreachable) > 0 {
			<p class="mt-3 max-w-prose font-display text-sm leading-relaxed text-ink-muted">
				Couldn't reach { d.UpstreamCatalogName() } for
				<span class="font-pixel text-xs text-ink">{ strings.Join(d.ModsUnreachable, ", ") }</span>
				— these were not checked.
			</p>
		}
		if d.UpdatesPending {
			<p class="mt-3 font-pixel text-[11px] text-accent">
				{ "Change committed" + shared.ConvergenceClause(d.Host, d.HostUnreachable) }
			</p>
		}
		if len(d.ModUpdates) > 0 {
			<div class="-mx-6 mt-5 max-h-80 overflow-y-auto border-t border-seam">
				for _, u := range d.ModUpdates {
					<label class="flex items-center gap-3 border-b border-seam px-6 py-3 font-pixel text-xs">
						<input type="checkbox" data-bind={ "selected." + u.Token } class="h-3.5 w-3.5 shrink-0 accent-accent"/>
						<span class="min-w-0 flex-1 truncate text-ink">{ u.FullName }</span>
						<span class="shrink-0 text-ink-faint">{ u.Current }</span>
						<span class="shrink-0 text-edge">to</span>
						<span class="shrink-0 text-accent">{ u.Latest }</span>
					</label>
				}
			</div>
			<div class="mt-4 flex flex-wrap items-center justify-end gap-2">
				<button
					type="button"
					data-indicator="busy_update_selected"
					data-attr:disabled="$busy_update_selected"
					data-on:click={ updateClick(d, "@post('/api/"+d.GamePath()+"/%d/mods/updates/apply', {payload: {selected: $selected}})") }
					disabled?={ d.UpdatesPending }
					class={ components.ButtonClass(components.VariantSecondary) + " disabled:opacity-40" }
				>
					<span data-show="!$busy_update_selected">Update selected</span>
					<span class="inline-flex items-center gap-1.5" data-show="$busy_update_selected" style="display:none;">
						<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>
						<span>Updating…</span>
					</span>
				</button>
				<button
					type="button"
					data-indicator="busy_update_all"
					data-attr:disabled="$busy_update_all"
					data-on:click={ updateClick(d, "@post('/api/"+d.GamePath()+"/%d/mods/updates/apply', {payload: {all: true}})") }
					disabled?={ d.UpdatesPending }
					class={ components.ButtonClass(components.VariantPrimary) + " disabled:opacity-40" }
				>
					<span data-show="!$busy_update_all">Update all</span>
					<span class="inline-flex items-center gap-1.5" data-show="$busy_update_all" style="display:none;">
						<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>
						<span>Updating…</span>
					</span>
				</button>
			</div>
		}
	</div>
}
