package pages

import "fmt"

templ ModUpdatePanel(d InstanceDetailUI) {
	<div class="rounded-xl border border-zinc-800 bg-zinc-900/80 overflow-hidden">
		<div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-800 bg-zinc-950/60 px-4 py-3">
			<div class="flex items-center gap-2.5">
				if len(d.ModUpdates) > 0 {
					<span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-900/50 text-sm font-bold text-amber-300">↻</span>
					<div>
						<h2 class="text-sm font-semibold text-amber-200">{ fmt.Sprintf("%d mod update(s) available", len(d.ModUpdates)) }</h2>
						<p class="text-xs text-zinc-500">Newer versions are published on Thunderstore. Applying one restarts this world.</p>
					</div>
				} else {
					<span class="flex h-7 w-7 items-center justify-center rounded-lg bg-zinc-800 text-sm text-zinc-400">✓</span>
					<div>
						<h2 class="text-sm font-semibold text-zinc-200">Mods are up to date</h2>
						<p class="text-xs text-zinc-500">
							if d.UpdatesError != "" {
								{ d.UpdatesError }
							} else if d.UpdatesChecked != "" {
								{ "Checked " + d.UpdatesChecked + " ago" }
							} else {
								Not checked yet.
							}
						</p>
					</div>
				}
			</div>
			<button
				type="button"
				data-on:click={ fmt.Sprintf("@post('/api/valheim/%d/mods/updates/check')", d.Number) }
				class="rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-1.5 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white transition"
			>Check now</button>
		</div>
		if d.UpdatesPending {
			<div class="flex items-center gap-2 border-b border-amber-800/50 bg-amber-950/40 px-4 py-2.5 text-xs text-amber-200">
				<span class="h-2 w-2 animate-pulse rounded-full bg-amber-400"></span>
				Update committed — this world restarts once ArgoCD syncs.
			</div>
		}
		if len(d.ModUpdates) > 0 {
			<ul class="max-h-80 divide-y divide-zinc-800/60 overflow-y-auto">
				for _, u := range d.ModUpdates {
					<li class="flex items-center gap-3 px-4 py-2.5 text-xs">
						<input type="checkbox" data-bind={ "selected." + u.Token } class="h-3.5 w-3.5 shrink-0 accent-emerald-500"/>
						<span class="min-w-0 flex-1 truncate font-mono text-zinc-200">{ u.FullName }</span>
						<span class="shrink-0 font-mono text-zinc-500">{ u.Current }</span>
						<span class="shrink-0 text-zinc-600">&rarr;</span>
						<span class="shrink-0 font-mono font-medium text-emerald-300">{ u.Latest }</span>
					</li>
				}
			</ul>
			<div class="flex items-center justify-end gap-2 border-t border-zinc-800 bg-zinc-950/60 px-4 py-2.5">
				<button
					type="button"
					data-on:click={ updateClick(d, "@post('/api/valheim/%d/mods/updates/apply', {payload: {selected: $selected}})") }
					disabled?={ d.UpdatesPending }
					class="rounded-lg border border-zinc-700 px-3 py-1.5 text-xs font-medium text-zinc-200 hover:bg-zinc-800 transition disabled:opacity-40"
				>Update selected</button>
				<button
					type="button"
					data-on:click={ updateClick(d, "@post('/api/valheim/%d/mods/updates/apply', {payload: {all: true}})") }
					disabled?={ d.UpdatesPending }
					class="rounded-lg bg-emerald-700 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-emerald-600 transition disabled:opacity-40"
				>Update all</button>
			</div>
		}
	</div>
}
