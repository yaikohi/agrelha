package pages

templ Dashboard(grafanaURL string, games []DashboardGameUI, isAdmin, signedIn bool, flashKind, flashMsg string) {
	if !isAdmin {
		@Panel(games, signedIn, flashKind, flashMsg)
	} else {
		@adminHub(grafanaURL, games, isAdmin, signedIn, flashKind, flashMsg)
	}
}

templ adminHub(grafanaURL string, games []DashboardGameUI, isAdmin, signedIn bool, flashKind, flashMsg string) {
	@AdminHub(grafanaURL, games, signedIn, flashKind, flashMsg)
}
