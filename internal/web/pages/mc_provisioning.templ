package pages

import (
	"agrelha/internal/web/components"
	"fmt"

	"agrelha/internal/web/shared"
)

templ MinecraftProvisioning(inst InstanceUI) {
	@Layout("Provisioning " + inst.Name) {
		@components.Nav(components.NavProps{Current: "minecraft", IsAdmin: inst.IsAdmin, SignedIn: true})
		<div
			class="mx-auto max-w-2xl space-y-6"
			data-signals={ fmt.Sprintf("{phase:'syncing',ready:false,slow:false,cause:'',problem:'',lb_ip:%q,instanceNumber:%d,detail:%q}", inst.LBIP, inst.Number, shared.ProvisioningDetail(inst.Host)) }
			data-effect={ fmt.Sprintf("@get('/api/minecraft/provisioning/%d/stream')", inst.Number) }
			data-computed-stopped="$phase == 'failed' || $phase == 'stalled'"
		>
			<div class="rounded-control border border-edge bg-surface-raised p-8 text-center">
				<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-control border border-accent text-3xl text-accent">
					<span data-show="!$ready && !$stopped()" class="animate-spin">⚙️</span>
					<span data-show="$ready">🎮</span>
					<span data-show="$stopped()">✕</span>
				</div>

				<h1 class="mt-4 text-xl font-bold text-ink">{ inst.Name }</h1>
				<p class="mt-1 font-pixel text-xs text-ink-muted">{ fmt.Sprintf("Instance #%02d · %s", inst.Number, inst.LBIP) }</p>

				<div class="mt-8 space-y-3 text-left">
					<!-- Step 1: desired state -->
					<div class="flex items-center gap-3 rounded-control border border-edge bg-seam p-3.5 text-xs">
						<span class="flex h-5 w-5 items-center justify-center rounded-full bg-accent text-accent-ink">✓</span>
						<span class="font-medium text-ink">{ shared.ProvisioningStepCommitted(inst.Host) }</span>
					</div>

					<!-- Step 2: reconcile -->
					<div class="flex items-center gap-3 rounded-control border border-edge bg-seam p-3.5 text-xs">
						<span data-show="$phase == 'syncing'" class="flex h-5 w-5 items-center justify-center rounded-full bg-accent text-accent-ink animate-pulse">⏳</span>
						<span data-show="$phase != 'syncing'" class="flex h-5 w-5 items-center justify-center rounded-full bg-accent text-accent-ink">✓</span>
						<span class="font-medium text-ink">{ shared.ProvisioningStepReconciling(inst.Host) }</span>
					</div>

					<!-- Step 3: server startup -->
					<div
						class="flex items-center gap-3 rounded-control border bg-seam p-3.5 text-xs"
						data-class="{'border-danger': $stopped(), 'border-edge': !$stopped()}"
					>
						<span data-show="$phase == 'booting'" class="flex h-5 w-5 items-center justify-center rounded-full bg-accent text-accent-ink animate-pulse">⏳</span>
						<span data-show="$phase == 'ready'" class="flex h-5 w-5 items-center justify-center rounded-full bg-accent text-accent-ink">✓</span>
						<span data-show="$phase == 'syncing'" class="flex h-5 w-5 items-center justify-center rounded-full bg-surface-raised text-ink-faint">○</span>
						<span data-show="$stopped()" class="flex h-5 w-5 items-center justify-center rounded-full bg-danger text-accent-ink">✕</span>
						<span class="font-medium text-ink">{ shared.ProvisioningStepStarting(inst.Host) }</span>
					</div>
				</div>

				<p data-show="$slow && !$ready && !$stopped()" class="mt-6 font-pixel text-[11px] text-ink-muted">
					This is taking longer than usual. A large modpack has hundreds of files to fetch, so a long wait here is normal — the page keeps watching.
				</p>

				<div data-show="$problem != ''" class="mt-6 rounded-control border border-danger p-4 text-left">
					<p class="font-pixel text-[11px] text-danger" data-text="$problem"></p>
					<p class="mt-1 font-pixel text-[11px] text-ink-faint">Still watching — this may clear on its own.</p>
				</div>

				<div data-show="$stopped()" class="mt-8 rounded-control border border-danger p-5 text-left">
					<h3 class="font-pixel text-xs text-danger" data-text="$phase == 'failed' ? 'This world did not come up' : 'Given up waiting'"></h3>
					<p class="mt-2 font-display text-sm leading-relaxed text-ink" data-text="$cause"></p>
				</div>

				<!-- Ready Banner -->
				<div data-show="$ready" class="mt-8 rounded-control border border-accent p-5">
					<h3 class="text-sm font-semibold text-accent">Server is Online & Ready!</h3>
					<p class="mt-1 text-xs text-ink">Connect in Minecraft via:</p>
					<div class="mt-2 font-pixel text-sm font-bold text-ink bg-surface-raised py-2 rounded-control border text-accent">
						<span data-text={ fmt.Sprintf("$lb_ip + ':%d'", MinecraftPort(inst)) }></span>
					</div>
				</div>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
					<a href="/minecraft" class={ components.ButtonClass(components.VariantSecondary) }>Return to Dashboard</a>
					<a
						data-show="$stopped()"
						href={ templ.SafeURL(fmt.Sprintf("/minecraft/%d/console", inst.Number)) }
						class={ components.ButtonClass(components.VariantSecondary) }
					>
						View logs
					</a>
					<button
						type="button"
						data-show="$stopped()"
						data-on:click={ fmt.Sprintf("@post('/api/minecraft/instances/%d/start'); window.location.reload()", inst.Number) }
						class={ components.ButtonClass(components.VariantPrimary) }
					>
						Try again
					</button>
					<a
						data-show="$ready"
						href={ templ.SafeURL(fmt.Sprintf("/minecraft/%d", inst.Number)) }
						class={ components.ButtonClass(components.VariantPrimary) }
					>
						Manage World &rarr;
					</a>
				</div>
			</div>
		</div>
	}
}
