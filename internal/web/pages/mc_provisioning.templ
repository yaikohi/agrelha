package pages

import (
	"agrelha/internal/web/components"
	"fmt"

	"agrelha/internal/web/shared"
)

templ MinecraftProvisioning(inst InstanceUI) {
	@Layout("Provisioning " + inst.Name) {
		@components.Nav(components.NavProps{IsAdmin: true, SignedIn: true})
		<div
			class="mx-auto max-w-2xl space-y-6"
			data-signals={ fmt.Sprintf("{phase:'syncing',ready:false,lb_ip:%q,num:%d,detail:%q}", inst.LBIP, inst.Number, shared.ProvisioningDetail(inst.Host)) }
			data-effect={ fmt.Sprintf("@get('/api/minecraft/provisioning/%d/stream')", inst.Number) }
		>
			<div class="rounded-control border border-edge bg-surface-raised p-8 text-center">
				<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-control text-accent text-3xl text-accent ring-1 text-accent">
					<span data-show="!$ready" class="animate-spin">⚙️</span>
					<span data-show="$ready">🎮</span>
				</div>

				<h1 class="mt-4 text-xl font-bold text-ink">{ inst.Name }</h1>
				<p class="mt-1 font-pixel text-xs text-ink-muted">{ fmt.Sprintf("Instance #%02d · %s", inst.Number, inst.LBIP) }</p>

				<div class="mt-8 space-y-3 text-left">
					<!-- Step 1: desired state -->
					<div class="flex items-center gap-3 rounded-control border border-edge bg-seam p-3.5 text-xs">
						<span class="flex h-5 w-5 items-center justify-center rounded-full text-accent text-accent">✓</span>
						<span class="font-medium text-ink">{ shared.ProvisioningStepCommitted(inst.Host) }</span>
					</div>

					<!-- Step 2: reconcile -->
					<div class="flex items-center gap-3 rounded-control border border-edge bg-seam p-3.5 text-xs">
						<span data-show="$phase == 'syncing'" class="flex h-5 w-5 items-center justify-center rounded-full text-accent text-accent animate-pulse">⏳</span>
						<span data-show="$phase != 'syncing'" class="flex h-5 w-5 items-center justify-center rounded-full text-accent text-accent">✓</span>
						<span class="font-medium text-ink">{ shared.ProvisioningStepReconciling(inst.Host) }</span>
					</div>

					<!-- Step 3: server startup -->
					<div class="flex items-center gap-3 rounded-control border border-edge bg-seam p-3.5 text-xs">
						<span data-show="$phase == 'booting'" class="flex h-5 w-5 items-center justify-center rounded-full text-accent text-accent animate-pulse">⏳</span>
						<span data-show="$phase == 'ready'" class="flex h-5 w-5 items-center justify-center rounded-full text-accent text-accent">✓</span>
						<span data-show="$phase == 'syncing'" class="flex h-5 w-5 items-center justify-center rounded-full bg-surface-raised text-ink-faint">○</span>
						<span class="font-medium text-ink">{ shared.ProvisioningStepStarting(inst.Host) }</span>
					</div>
				</div>

				<!-- Ready Banner -->
				<div data-show="$ready" class="mt-8 rounded-control border text-accent text-accent p-5">
					<h3 class="text-sm font-semibold text-accent">Server is Online & Ready!</h3>
					<p class="mt-1 text-xs text-ink">Connect in Minecraft via:</p>
					<div class="mt-2 font-pixel text-sm font-bold text-ink bg-surface-raised py-2 rounded-control border text-accent">
						<span data-text={ fmt.Sprintf("$lb_ip + ':%d'", MinecraftPort(inst)) }></span>
					</div>
				</div>

				<div class="mt-8 flex items-center justify-center gap-3">
					<a
						href="/minecraft"
						class="rounded-control bg-surface-raised px-5 py-2.5 text-xs font-semibold text-ink hover:text-accent"
					>
						Return to Dashboard
					</a>
					<a
						data-show="$ready"
						href={ templ.SafeURL(fmt.Sprintf("/minecraft/%d", inst.Number)) }
						class="rounded-control text-accent px-5 py-2.5 text-xs font-semibold text-ink hover:text-accent"
					>
						Manage World &rarr;
					</a>
				</div>
			</div>
		</div>
	}
}
