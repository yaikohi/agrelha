package pages

templ flashBanner(kind, msg string) {
	if msg != "" {
		if kind == "err" {
			<div class="mb-4 rounded border text-danger text-danger px-4 py-3 text-sm text-danger">{ msg }</div>
		} else {
			<div class="mb-4 rounded border border-accent px-4 py-3 text-sm text-accent">{ msg }</div>
		}
	}
}
