package pages

import "agrelha/internal/web/shared"

templ GModInstanceDetail(d InstanceDetailUI) {
	@instancePage(gmodInstanceSpec, d) {
		if d.ActiveTab == "overview" {
			@IncidentPanel(d.LastIncident)
			@instanceOverview(buildInstanceOverview(gmodInstanceSpec, d))
		}
		if d.ActiveTab == "console" {
			@instanceConsole("gmod", d.Number,
				shared.LogSourceNote(d.Host)+" Workshop downloads appear here while the world boots.",
				"Connecting to the Garry's Mod container logs…")
		}
		if d.ActiveTab == "crashes" {
			@IncidentList(d)
		}
	}
}
