package pages

import (
	"fmt"
	"agrelha/internal/web/components"
)

templ GModInstanceDetail(d InstanceDetailUI) {
	@Layout(d.Name + " · Garry's Mod") {
		@nav()
		<div class="space-y-6">
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<div class="flex items-center gap-2 text-xs text-zinc-500">
						<a href="/gmod" class="hover:text-zinc-300">Garry's Mod</a>
						<span>/</span>
						<span class="font-mono text-zinc-400">{ fmt.Sprintf("#%02d", d.Number) }</span>
						<span>/</span>
						<span class="font-semibold text-zinc-200">{ d.Name }</span>
					</div>
					<div class="mt-1 flex items-center gap-3">
						<h1 class="text-xl font-bold text-zinc-100">{ d.Name }</h1>
						@components.StatusPill(components.StatusPillProps{State: d.State})
					</div>
				</div>

				<div class="flex items-center gap-2">
					if d.State == "running" {
						@components.Button(components.ButtonProps{
							Variant: components.VariantWarning,
							Size:    components.SizeSm,
							OnClick: fmt.Sprintf("@post('/api/gmod/instances/%d/stop')", d.Number),
							Text:    "Stop Server",
						})
						@components.Button(components.ButtonProps{
							Variant: components.VariantSecondary,
							Size:    components.SizeSm,
							OnClick: fmt.Sprintf("@post('/api/gmod/instances/%d/restart')", d.Number),
							Text:    "Restart",
						})
					} else {
						@components.Button(components.ButtonProps{
							Variant: components.VariantSuccess,
							Size:    components.SizeSm,
							OnClick: fmt.Sprintf("@post('/api/gmod/instances/%d/start')", d.Number),
							Text:    "Start Server",
						})
					}
				</div>
			</div>

			<div class="space-y-6">
				if d.RestartPending {
					<div class="flex items-start justify-between gap-4 rounded-xl border border-amber-800/60 bg-amber-950/40 p-4">
						<div class="flex items-start gap-2.5">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-amber-900/60 text-sm font-bold text-amber-300">↻</span>
							<div class="min-w-0">
								<h2 class="text-sm font-semibold text-amber-200">Restart pending</h2>
								<p class="mt-0.5 text-xs text-amber-300/80">
									if d.RestartReason != "" {
										{ d.RestartReason }
									} else {
										Workshop collection was updated upstream. Restart the world to apply latest addons.
									}
								</p>
							</div>
						</div>
						if d.State == "running" {
							@components.Button(components.ButtonProps{
								Variant: components.VariantWarning,
								Size:    components.SizeSm,
								OnClick: fmt.Sprintf("@post('/api/gmod/instances/%d/restart')", d.Number),
								Text:    "Restart Now",
							})
						}
					</div>
				}

				@IncidentPanel(d.LastIncident)

				<div class="flex flex-col gap-4 rounded-2xl border border-zinc-800 bg-zinc-900/70 p-6 sm:flex-row sm:items-center sm:justify-between">
					<div>
						<span class="text-xs font-medium text-zinc-400 uppercase tracking-wider">Server Connection</span>
						<div class="mt-1 flex items-center gap-3">
							<code class="font-mono text-lg font-bold text-white">{ ConnectAddress(d.LBIP, 27015) }</code>
							if d.LBIP != "" {
								<button
									type="button"
									data-on:click={ fmt.Sprintf("navigator.clipboard.writeText('%s:27015')", d.LBIP) }
									class="rounded-lg border border-zinc-700 bg-zinc-800/80 px-2.5 py-1 text-[11px] text-zinc-300 hover:bg-zinc-700 hover:text-white"
								>
									Copy IP
								</button>
							}
						</div>
						if d.Password != "" {
							<p class="mt-1 text-xs text-zinc-400">
								Password: <code class="font-mono text-zinc-200 font-semibold">{ d.Password }</code>
							</p>
						} else {
							<p class="mt-1 text-xs text-zinc-500">No password required (public access)</p>
						}
					</div>

					if d.LBIP != "" {
						<div class="flex flex-wrap items-center gap-2">
							if d.Password != "" {
								<button
									type="button"
									data-on:click={ fmt.Sprintf("navigator.clipboard.writeText('connect %s:27015; password %s')", d.LBIP, d.Password) }
									class="rounded-xl border border-zinc-700 bg-zinc-800 px-3.5 py-2 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white transition"
								>
									Copy Console Command
								</button>
								<a
									href={ templ.SafeURL(fmt.Sprintf("steam://connect/%s:27015/%s", d.LBIP, d.Password)) }
									class="rounded-xl bg-zinc-100 px-4 py-2 text-xs font-semibold text-zinc-950 shadow hover:bg-white transition inline-flex items-center gap-1.5"
								>
									Join via Steam 🚀
								</a>
							} else {
								<button
									type="button"
									data-on:click={ fmt.Sprintf("navigator.clipboard.writeText('connect %s:27015')", d.LBIP) }
									class="rounded-xl border border-zinc-700 bg-zinc-800 px-3.5 py-2 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white transition"
								>
									Copy Console Command
								</button>
								<a
									href={ templ.SafeURL(fmt.Sprintf("steam://connect/%s:27015", d.LBIP)) }
									class="rounded-xl bg-zinc-100 px-4 py-2 text-xs font-semibold text-zinc-950 shadow hover:bg-white transition inline-flex items-center gap-1.5"
								>
									Join via Steam 🚀
								</a>
							}
						</div>
					}
				</div>

				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
					<div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4">
						<span class="text-xs font-medium text-zinc-500">Gamemode</span>
						<p class="mt-1 font-semibold text-zinc-200">
							if d.Gamemode != "" {
								{ d.Gamemode }
							} else {
								sandbox
							}
						</p>
					</div>

					<div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4">
						<span class="text-xs font-medium text-zinc-500">Map</span>
						<p class="mt-1 font-mono font-semibold text-zinc-200">
							if d.Map != "" {
								{ d.Map }
							} else {
								gm_construct
							}
						</p>
					</div>

					<div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4">
						<span class="text-xs font-medium text-zinc-500">Resource Tier</span>
						<p class="mt-1 font-semibold text-zinc-200">
							{ fmt.Sprintf("%s (%d GiB)", d.Tier, d.MemoryGiB) }
						</p>
					</div>

					<div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4">
						<span class="text-xs font-medium text-zinc-500">Workshop Collection</span>
						if d.CollectionID != "" {
							<p class="mt-1 font-mono text-sm text-sky-400">
								<a
									href={ templ.SafeURL(fmt.Sprintf("https://steamcommunity.com/sharedfiles/filedetails/?id=%s", d.CollectionID)) }
									target="_blank"
									rel="noopener noreferrer"
									class="hover:underline"
								>
									{ d.CollectionID } ↗
								</a>
							</p>
						} else {
							<p class="mt-1 text-xs text-zinc-500">None configured</p>
						}
					</div>
				</div>

				<div class="rounded-2xl border border-red-950/40 bg-red-950/10 p-6">
					<h3 class="text-sm font-semibold text-red-300">Danger Zone</h3>
					<p class="mt-1 text-xs text-zinc-400">
						Deleting this instance permanently removes all server configurations and persistent data.
					</p>
					<div class="mt-4">
						@components.Button(components.ButtonProps{
							Variant: components.VariantDanger,
							Size:    components.SizeSm,
							OnClick: fmt.Sprintf("if (confirm('Delete Garry\\'s Mod instance #%02d (%s)? World data will be removed.')) @delete('/api/gmod/instances/%d')", d.Number, d.Name, d.Number),
							Text:    "Delete World",
						})
					</div>
				</div>
			</div>
		</div>
	}
}
