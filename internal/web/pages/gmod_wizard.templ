package pages

import (
	"fmt"
	"agrelha/internal/web/components"
)

templ GModWizard(budget BudgetUI) {
	@Layout("Create Garry's Mod World") {
		@components.Nav(components.NavProps{Current: "gmod", IsAdmin: true, SignedIn: true})
		<div
			class="space-y-6"
			data-signals="{step:1,name:'',nameError:'',password:'',gamemode:'sandbox',map:'gm_construct',collectionID:'',tier:'small',creating:false,redirect:''}"
			data-effect="if ($redirect) { window.location.href = $redirect }"
		>
			@components.StepIndicator(components.StepIndicatorProps{
				Steps: []components.StepItem{
					{Number: 1, Label: "World & Workshop"},
					{Number: 2, Label: "Tier & Review"},
				},
			})

			<div data-show="$step == 1" class="rounded-control border border-edge bg-surface-raised p-8">
				<h2 class="font-display text-xl font-semibold tracking-tight text-ink">Garry's Mod server configuration</h2>
				<p class="mt-1 text-xs text-ink-muted">Configure your world title, Workshop collection ID, gamemode, and map.</p>
				<p data-show="$nameError" class="mt-2 font-pixel text-xs text-danger" data-text="$nameError" style="display:none;"></p>

				<div class="mt-6 max-w-md space-y-4">
					@components.Input(components.InputProps{
						Label: "World / Server Name",
						Required: true,
						Placeholder: "e.g. Trouble in Terrorist Town",
						Bind: "name",
					})

					@components.Input(components.InputProps{
						Label: "Steam Workshop Collection ID (Optional)",
						Placeholder: "e.g. 104604903",
						Bind: "collectionID",
						Class: "font-pixel",
						HelperText: "Addons in this collection will be mounted automatically by the server.",
					})

					@components.Input(components.InputProps{
						Label: "Gamemode",
						Placeholder: "e.g. sandbox, terrortown, darkrp",
						Bind: "gamemode",
						HelperText: "Defaults to sandbox if empty.",
					})

					@components.Input(components.InputProps{
						Label: "Map",
						Placeholder: "e.g. gm_construct, gm_flatgrass, ttt_minecraft_b5",
						Bind: "map",
						Class: "font-pixel",
						HelperText: "Initial map to load upon server boot.",
					})

					@components.Input(components.InputProps{
						Label: "Server Password (Optional)",
						Placeholder: "e.g. secret123",
						Bind: "password",
						HelperText: "Leave empty for a public server.",
					})

					<div class="pt-4 flex justify-end">
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Size: components.SizeMd,
							OnClick: "if ($name.trim()) { $nameError = ''; $step = 2 } else { $nameError = 'Please enter a world name'; $toast = 'Please enter a world name'; $toastkind = 'err' }",
							Text: "Next: Resource tier",
						})
					</div>
				</div>
			</div>

			<div data-show="$step == 2" class="rounded-control border border-edge bg-surface-raised p-8">
				<h2 class="font-display text-xl font-semibold tracking-tight text-ink">Resource tier & review</h2>
				<p class="mt-1 text-xs text-ink-muted">Select memory allocation and verify server details.</p>

				<div class="mt-6 space-y-6 max-w-md">
					<div>
						<label class="block text-xs font-medium text-ink">Memory Tier</label>
						<div class="mt-2 space-y-2">
							@components.OptionCard(components.OptionCardProps{
								Name: "tier",
								Value: "small",
								BindSignal: "tier",
								Title: "Small (2 GiB)",
								Subtitle: "Lightweight Sandbox or TTT, up to 12 players",
								Badge: "2 GiB",
							})
							@components.OptionCard(components.OptionCardProps{
								Name: "tier",
								Value: "medium",
								BindSignal: "tier",
								Title: "Medium (4 GiB)",
								Subtitle: "Standard modded collections and game modes, up to 24 players",
								Badge: "4 GiB",
							})
							@components.OptionCard(components.OptionCardProps{
								Name: "tier",
								Value: "large",
								BindSignal: "tier",
								Title: "Large (8 GiB)",
								Subtitle: "Heavy DarkRP or extensive custom prop/content collections",
								Badge: "8 GiB",
							})
						</div>
					</div>

					<div class="rounded-control border border-edge bg-seam/80 p-4 space-y-2 text-xs">
						<div class="flex justify-between">
							<span class="text-ink-faint">Server Name:</span>
							<span class="font-semibold text-ink" data-text="$name"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-ink-faint">Gamemode:</span>
							<span class="text-ink" data-text="$gamemode || 'sandbox'"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-ink-faint">Map:</span>
							<span class="font-pixel text-ink" data-text="$map || 'gm_construct'"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-ink-faint">Workshop Collection:</span>
							<span class="font-pixel text-ink" data-text="$collectionID || 'None'"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-ink-faint">Password:</span>
							<span class="font-pixel text-ink" data-text="$password ? $password : 'None (Public)'"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-ink-faint">Memory Budget:</span>
							<span class="font-pixel text-ink">{ fmt.Sprintf("%d / %d GiB used", budget.UsedGiB, budget.TotalBudgetGiB) }</span>
						</div>
					</div>

					<div class="pt-4 flex justify-between">
						@components.Button(components.ButtonProps{
							Variant: components.VariantSecondary,
							Size: components.SizeMd,
							OnClick: "if (!$creating) $step = 1",
							Indicator: "creating",
							Text: "Back",
						})
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Size: components.SizeMd,
							Indicator: "creating",
							LoadingText: "Creating Garry's Mod world…",
							OnClick: "if ($creating) return; @post('/api/gmod/wizard/create')",
							Text: "Create Garry's Mod world",
						})
					</div>
				</div>
			</div>
		</div>
	}
}
