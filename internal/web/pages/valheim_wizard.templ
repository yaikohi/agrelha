package pages

import (
	"fmt"
	"agrelha/internal/web/components"
)

templ ValheimWizard(budget BudgetUI) {
	@Layout("Create Valheim World") {
		@nav()
		<div
			class="space-y-6"
			data-signals="{step:1,name:'',password:'',seed:'',source:'vanilla',tier:'medium',cart:[],wizardModSearch:'',wizardModSearchLoading:false,showWizardModDetail:false,manualSlug:'',raw_mods:'',importError:'',importLoading:false,redirect:''}"
			data-effect="if ($redirect) { window.location.href = $redirect }"
		>
			<!-- Stepper progress header -->
			@components.StepIndicator(components.StepIndicatorProps{
				Steps: []components.StepItem{
					{Number: 1, Label: "Identity"},
					{Number: 2, Label: "Content & Mods"},
					{Number: 3, Label: "Tier & Review"},
				},
			})

			<!-- STEP 1: IDENTITY -->
			<div data-show="$step == 1" class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-8 shadow-sm">
				<h2 class="text-lg font-bold text-zinc-100">Step 1: Name Your Valheim Server</h2>
				<p class="mt-1 text-xs text-zinc-400">Give your world a title, an optional join password, and a world seed.</p>

				<div class="mt-6 max-w-md space-y-4">
					@components.Input(components.InputProps{
						Label:       "World / Server Name",
						Required:    true,
						Placeholder: "e.g. Valheim Legends",
						Bind:        "name",
					})

					@components.Input(components.InputProps{
						Label:       "Server Password (Optional)",
						Placeholder: "e.g. secret123 (minimum 5 characters if set)",
						Bind:        "password",
						HelperText:  "Valheim requires passwords to be at least 5 characters long. Leave empty for public.",
					})

					@components.Input(components.InputProps{
						Label:       "World Seed (Optional)",
						Placeholder: "e.g. OdinRealm (random if blank)",
						Bind:        "seed",
						Class:       "font-mono",
					})

					<div class="pt-4 flex justify-end">
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Size:    components.SizeMd,
							OnClick: "if ($name.trim()) { $step = 2 } else { alert('Please enter a world name') }",
							Text:    "Next: Choose Content →",
						})
					</div>
				</div>
			</div>

			<!-- STEP 2: CONTENT & MODS -->
			<div data-show="$step == 2" class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-8 shadow-sm">
				<h2 class="text-lg font-bold text-zinc-100">Step 2: Content & Modding</h2>
				<p class="mt-1 text-xs text-zinc-400">Choose between clean BepInEx, starter Thunderstore mods, or import an r2modman profile.</p>

				<div class="mt-6 space-y-6 max-w-3xl">
					<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
						@components.OptionCard(components.OptionCardProps{
							Name:        "source",
							Value:       "vanilla",
							BindSignal:  "source",
							Title:       "Clean BepInEx",
							Description: "Vanilla gameplay with BepInEx loader pre-installed for future mods.",
						})
						@components.OptionCard(components.OptionCardProps{
							Name:        "source",
							Value:       "scratch",
							BindSignal:  "source",
							Title:       "Custom Mods",
							Description: "Browse Thunderstore community mods or add custom packages to your cart.",
						})
						@components.OptionCard(components.OptionCardProps{
							Name:        "source",
							Value:       "modpack",
							BindSignal:  "source",
							Title:       "Import Profile",
							Description: "Import an existing .r2z or export.r2x Thunderstore modpack profile.",
						})
					</div>

					<!-- Scratch mods browsing & cart -->
					<div data-show="$source == 'scratch'" class="space-y-4">
						<!-- Mod Search Input -->
						<div class="flex gap-2">
							<input
								type="text"
								data-bind="wizardModSearch"
								data-on:keydown="if (evt.key === 'Enter') { evt.preventDefault(); @post('/api/valheim/wizard/mods/search', {payload: {wizardModSearch: $wizardModSearch}}) }"
								placeholder="Search Thunderstore mods (e.g. Mining, Jotunn, Equipment, PlantEasily)..."
								class="flex-1 rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none"
							/>
							<button
								type="button"
								data-indicator="wizardModSearchLoading"
								data-on:click="@post('/api/valheim/wizard/mods/search', {payload: {wizardModSearch: $wizardModSearch}})"
								class="rounded-xl bg-zinc-100 px-5 py-2.5 text-xs font-semibold text-zinc-950 hover:bg-white transition"
							>
								<span data-show="!$wizardModSearchLoading">Search</span>
								<span data-show="$wizardModSearchLoading" class="animate-pulse">Searching...</span>
							</button>
						</div>

						<!-- Selected Mods Cart Tray -->
						<div class="rounded-xl border border-zinc-800 bg-zinc-950/60 p-4">
							<div class="flex items-center justify-between pb-2 border-b border-zinc-800/80">
								<div class="flex items-center gap-2">
									<h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-300">Selected Mods</h4>
									<span class="rounded-full bg-zinc-800 border border-zinc-700 px-2 py-0.5 text-[11px] font-mono font-medium text-zinc-300" data-text="$cart.length"></span>
								</div>
								<button
									type="button"
									data-show="$cart.length > 0"
									data-on:click="$cart = []; @post('/api/valheim/wizard/cart/sync')"
									class="text-xs text-zinc-500 hover:text-red-400 transition"
								>
									Clear All
								</button>
							</div>
							<div id="wizard-valheim-cart-items" class="mt-3">
								<span class="text-xs text-zinc-500 py-1">No mods added yet. Search or click "+ Add" on popular mods below.</span>
							</div>
						</div>

						<!-- Results container populated via SSE -->
						<div
							id="wizard-valheim-mod-results"
							class="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-[500px] overflow-y-auto pr-1"
							data-effect="@post('/api/valheim/wizard/mods/search', {payload: {wizardModSearch: ''}})"
						>
							<div class="col-span-full py-12 text-center text-xs text-zinc-500 animate-pulse">
								Loading popular Thunderstore mods...
							</div>
						</div>

						<!-- Collapsible exact slug / manual package entry -->
						<details class="pt-2 border-t border-zinc-800/80">
							<summary class="text-xs text-zinc-500 cursor-pointer hover:text-zinc-300">Or add custom package slugs manually...</summary>
							<div class="mt-3 space-y-3">
								<div class="flex items-center gap-2">
									<input
										type="text"
										data-bind="manualSlug"
										data-on:keydown="if (evt.key === 'Enter') { evt.preventDefault(); if ($manualSlug.trim()) { if (!$cart.includes($manualSlug.trim())) { $cart = [...$cart, $manualSlug.trim()] }; $manualSlug = ''; @post('/api/valheim/wizard/cart/sync') } }"
										placeholder="e.g. denikson-BepInExPack_Valheim or ValheimModding-Jotunn"
										class="flex-1 rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-1.5 text-xs text-zinc-100 placeholder-zinc-500 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none font-mono"
									/>
									<button
										type="button"
										data-on:click="if ($manualSlug.trim()) { if (!$cart.includes($manualSlug.trim())) { $cart = [...$cart, $manualSlug.trim()] }; $manualSlug = ''; @post('/api/valheim/wizard/cart/sync') }"
										class="rounded-lg bg-zinc-800 border border-zinc-700 px-3 py-1.5 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white transition"
									>
										+ Add Slug
									</button>
								</div>
								@components.Textarea(components.TextareaProps{
									Label:       "Bulk package identifiers (one per line)",
									Rows:        3,
									Placeholder: "denikson-BepInExPack_Valheim\nValheimModding-Jotunn",
									Bind:        "raw_mods",
									HelperText:  "You can paste multiple identifiers here. They will be merged with your selected mods on creation.",
								})
							</div>
						</details>
					</div>

					<!-- Import modpack file -->
					<div data-show="$source == 'modpack'" class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-4 space-y-3">
						<label class="block text-xs font-medium text-zinc-300">Upload Modpack Profile (.r2z or export.r2x)</label>
						<input
							type="file"
							accept=".r2z,.r2x,.zip"
							data-on:change="@post('/api/valheim/wizard/import', {contentType: 'form'})"
							class="block w-full text-xs text-zinc-400 file:mr-4 file:rounded-xl file:border-0 file:bg-zinc-800 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-zinc-200 hover:file:bg-zinc-700"
						/>
						<div data-show="$importError" class="text-xs text-red-400" data-text="$importError"></div>
					</div>

					<div class="pt-4 flex justify-between">
						@components.Button(components.ButtonProps{
							Variant: components.VariantSecondary,
							Size:    components.SizeMd,
							OnClick: "$step = 1",
							Text:    "← Back",
						})
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Size:    components.SizeMd,
							OnClick: "$step = 3",
							Text:    "Next: Resource Tier →",
						})
					</div>
				</div>
			</div>

			<!-- STEP 3: TIER & REVIEW -->
			<div data-show="$step == 3" class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-8 shadow-sm">
				<h2 class="text-lg font-bold text-zinc-100">Step 3: Resource Tier & Review</h2>
				<p class="mt-1 text-xs text-zinc-400">Select memory allocation and verify server details.</p>

				<div class="mt-6 space-y-6 max-w-md">
					<div>
						<label class="block text-xs font-medium text-zinc-300">Memory Tier</label>
						<div class="mt-2 space-y-2">
							@components.OptionCard(components.OptionCardProps{
								Name:        "tier",
								Value:       "small",
								BindSignal:  "tier",
								Title:       "Small",
								Subtitle:    "Lightweight vanilla / minimal mods, up to 4 players",
								Badge:       "4 GiB",
							})
							@components.OptionCard(components.OptionCardProps{
								Name:        "tier",
								Value:       "medium",
								BindSignal:  "tier",
								Title:       "Medium - Standard",
								Subtitle:    "Standard modded Valheim gameplay, up to 10 players",
								Badge:       "6 GiB",
							})
							@components.OptionCard(components.OptionCardProps{
								Name:        "tier",
								Value:       "large",
								BindSignal:  "tier",
								Title:       "Large",
								Subtitle:    "Heavy modpacks with extensive assets, up to 10 players",
								Badge:       "8 GiB",
							})
						</div>
					</div>

					<!-- Review Summary Card -->
					<div class="rounded-xl border border-zinc-800 bg-zinc-950/80 p-4 space-y-2 text-xs">
						<div class="flex justify-between">
							<span class="text-zinc-500">Server Name:</span>
							<span class="font-semibold text-zinc-200" data-text="$name"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-zinc-500">Password:</span>
							<span class="font-mono text-zinc-200" data-text="$password ? $password : 'None (Public)'"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-zinc-500">Seed:</span>
							<span class="font-mono text-zinc-200" data-text="$seed ? $seed : 'Random'"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-zinc-500">Content Mode:</span>
							<span class="capitalize text-zinc-200" data-text="$source"></span>
						</div>
						<div data-show="$source == 'scratch'" class="flex justify-between">
							<span class="text-zinc-500">Selected Mods:</span>
							<span class="font-mono text-zinc-200" data-text="$cart.length + ' mods'"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-zinc-500">Memory Budget:</span>
							<span class="font-mono text-zinc-200">{ fmt.Sprintf("%d / %d GiB used", budget.UsedGiB, budget.TotalBudgetGiB) }</span>
						</div>
					</div>

					<div class="pt-4 flex justify-between">
						@components.Button(components.ButtonProps{
							Variant: components.VariantSecondary,
							Size:    components.SizeMd,
							OnClick: "$step = 2",
							Text:    "← Back",
						})
						@components.Button(components.ButtonProps{
							Variant: components.VariantPrimary,
							Size:    components.SizeMd,
							OnClick: "@post('/api/valheim/wizard/create', {contentType: 'json'})",
							Text:    "Provision & Launch Server 🚀",
						})
					</div>
				</div>
			</div>

			<!-- Slide-over Mod Detail Drawer Modal in Wizard -->
			<div
				data-show="$showWizardModDetail"
				class="fixed inset-0 z-50 flex justify-end bg-black/60 backdrop-blur-xs transition-opacity duration-300"
				style="display: none;"
			>
				<!-- Backdrop dismiss click -->
				<div class="fixed inset-0" data-on:click="$showWizardModDetail = false"></div>
				<!-- Drawer Panel -->
				<div class="relative z-10 w-full max-w-2xl bg-zinc-900 border-l border-zinc-800 shadow-2xl overflow-y-auto h-full flex flex-col">
					<div id="wizard-valheim-mod-detail-content">
						<div class="p-8 text-center text-zinc-500 text-sm animate-pulse">Loading mod details...</div>
					</div>
				</div>
			</div>
		</div>
	}
}
