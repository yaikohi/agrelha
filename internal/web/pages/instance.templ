package pages

import "agrelha/internal/web/components"

templ instancePage(spec instanceSpec, d InstanceDetailUI) {
	@LayoutHearth(d.Name + " · " + spec.label) {
		@components.Nav(components.NavProps{Current: spec.game, IsAdmin: d.IsAdmin, SignedIn: true, GrafanaURL: ""})
		if d.HostUnreachable {
			@HostUnreachableBanner(d.Host)
		}
		@instanceHead(buildInstanceHead(spec, d))
		{ children... }
		@panelColophon()
	}
}

templ instanceHead(h InstanceHeadUI) {
	<header class="mt-8">
		<div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
			<div class="min-w-0">
				<p class="flex flex-wrap items-baseline gap-2 font-pixel text-[11px]">
					<a href={ templ.SafeURL("/" + h.Game) } class={ "focus-accent transition-colors hover:text-accent " + h.Tint }>{ h.GameLabel }</a>
					<span class="text-edge">/</span>
					<span class="text-ink-faint">{ h.Slot }</span>
				</p>
				<h1 class="mt-0.5 font-display text-3xl font-semibold tracking-tight text-ink">{ h.Name }</h1>
				<p class="mt-2 flex flex-wrap items-center gap-2 font-pixel text-xs text-ink-muted">
					<span class={ h.Lamp } data-class={ h.LampSignals() }></span>
					<span data-text={ h.StateSignalExpr() }>{ h.StateLabel }</span>
					if h.Presence != "" {
						<span class="text-ink-faint" data-show={ h.PresenceShowExpr() } data-text={ h.PresenceExpr() }>{ h.Presence }</span>
					} else {
						<span class="text-ink-faint" data-show={ h.PresenceShowExpr() } data-text={ h.PresenceExpr() } style="display:none;"></span>
					}
				</p>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				if h.Blocked != "" {
					<span class="max-w-xs font-pixel text-[11px] text-ink-faint">{ h.Blocked }</span>
				}
				for _, a := range h.Actions {
					<button
						type="button"
						data-indicator={ actionIndicator(a.Label) }
						data-attr:disabled={ "$" + actionIndicator(a.Label) }
						data-on:click={ toastActionClick(a.Script) }
						class={ components.ButtonClass(instanceVariant(a.Kind)) }
					>
						<span data-show={ "!" + "$" + actionIndicator(a.Label) }>{ a.Label }</span>
						<span class="inline-flex items-center gap-1.5" data-show={ "$" + actionIndicator(a.Label) } style="display:none;">
							<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>
							<span>{ inFlightVerb(a.Label) }</span>
						</span>
					</button>
				}
			</div>
		</div>
		<nav class="-mx-6 mt-7 flex flex-wrap items-end gap-x-6 gap-y-2 border-b border-seam px-6 font-pixel text-xs">
			for _, t := range h.Tabs {
				<a href={ templ.SafeURL(t.Href) } class={ components.TabLinkClass(t.Active) }>{ t.Label }</a>
			}
		</nav>
	</header>
}

templ instanceOverview(o InstanceOverviewUI) {
	<div class="mt-8 space-y-8">
		for _, n := range o.Notices {
			<div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
				<div class="min-w-0">
					<p class="font-pixel text-[11px] text-accent">{ n.Label }</p>
					<p class="mt-1 max-w-prose font-display text-sm leading-relaxed text-ink-muted">{ n.Body }</p>
					if n.Note != "" {
						<p class="mt-1 font-pixel text-[11px] text-ink-faint">{ n.Note }</p>
					}
				</div>
				if n.Action != nil {
					<button
						type="button"
						data-indicator={ actionIndicator(n.Action.Label) }
						data-attr:disabled={ "$" + actionIndicator(n.Action.Label) }
						data-on:click={ toastActionClick(n.Action.Script) }
						class="focus-accent shrink-0 rounded-control border border-accent px-3 py-1.5 font-pixel text-xs text-accent transition-colors hover:bg-accent hover:text-accent-ink"
					>
						<span data-show={ "!" + "$" + actionIndicator(n.Action.Label) }>{ n.Action.Label }</span>
						<span class="inline-flex items-center gap-1.5" data-show={ "$" + actionIndicator(n.Action.Label) } style="display:none;">
							<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>
							<span>{ inFlightVerb(n.Action.Label) }</span>
						</span>
					</button>
				}
			</div>
		}
		<div>
			<div class="flex flex-wrap items-center gap-3">
				<button
					type="button"
					data-signals={ o.CopyInit() }
					data-on:click={ o.CopyClick() }
					class="focus-accent group flex max-w-full items-center gap-3 rounded-control border border-edge bg-surface-raised/40 px-3.5 py-2 text-left transition-colors hover:border-accent/60"
				>
					<span class="truncate font-pixel text-base sm:text-lg text-ink transition-colors group-hover:text-accent">{ o.Address }</span>
					<span class="shrink-0 rounded-control border border-edge/80 bg-surface px-2 py-0.5 font-pixel text-[11px] text-ink-muted transition-colors group-hover:border-accent group-hover:text-accent" data-text={ o.CopyLabelExpr() }>copy</span>
				</button>
				if o.Password != "" {
					<span class="font-pixel text-xs text-ink-muted">
						password <span class="text-ink">{ o.Password }</span>
					</span>
				}
			</div>
			if o.Password == "" {
				<p class="mt-2 font-pixel text-xs text-ink-faint">no password — anyone on the network can join</p>
			}
		</div>
		if len(o.Actions) > 0 || o.JoinHint != "" {
			<div class="space-y-3">
				if len(o.Actions) > 0 {
					<div class="flex flex-wrap items-center gap-2">
						for _, a := range o.Actions {
							@overviewAction(a)
						}
					</div>
				}
				if o.JoinHint != "" {
					<p class="max-w-prose font-display text-sm leading-relaxed text-ink-muted">{ o.JoinHint }</p>
				}
			</div>
		}
		<div class="rounded-control border border-edge bg-surface-raised/20 p-6">
			<h3 class="font-pixel text-xs uppercase tracking-wider text-ink-muted">Server telemetry</h3>
			<dl class="mt-4 grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-3">
				for _, f := range o.Facts {
					<div>
						<dt class="font-pixel text-xs text-ink-muted">{ f.Label }</dt>
						if f.SignalExpr != "" {
							<dd class="mt-1 font-pixel text-sm font-medium text-ink" data-text={ f.SignalExpr }>{ f.Value }</dd>
						} else {
							<dd class="mt-1 font-pixel text-sm font-medium text-ink">{ f.Value }</dd>
						}
						if f.Note != "" {
							<dd class="mt-0.5 font-pixel text-xs text-ink-faint">{ f.Note }</dd>
						}
					</div>
				}
			</dl>
		</div>
	</div>
}

templ instanceConsole(game string, instanceNumber int, note string, placeholder string) {
	<div class="mt-8 space-y-4" data-effect={ logStreamExpr(game, instanceNumber) }>
		<p class="max-w-prose font-display text-sm leading-relaxed text-ink-muted">{ note }</p>
		@components.LogPane("console-logs", placeholder)
	</div>
}

templ overviewAction(a ActionUI) {
	if a.Kind == "download" {
		<a href={ templ.SafeURL(a.Href) } download class="focus-accent rounded-control border border-accent px-3 py-1.5 font-pixel text-xs text-accent transition-colors hover:bg-accent hover:text-accent-ink">{ a.Label }</a>
	} else if a.Href != "" {
		<a href={ templ.SafeURL(a.Href) } class="focus-accent rounded-control border border-accent px-3 py-1.5 font-pixel text-xs text-accent transition-colors hover:bg-accent hover:text-accent-ink">{ a.Label }</a>
	} else {
		<button
			type="button"
			data-indicator={ actionIndicator(a.Label) }
			data-attr:disabled={ "$" + actionIndicator(a.Label) }
			data-on:click={ toastActionClick(a.Script) }
			class="focus-accent rounded-control border border-edge px-3 py-1.5 font-pixel text-xs text-ink-muted transition-colors hover:border-accent hover:text-accent"
		>
			<span data-show={ "!" + "$" + actionIndicator(a.Label) }>{ a.Label }</span>
			<span class="inline-flex items-center gap-1.5" data-show={ "$" + actionIndicator(a.Label) } style="display:none;">
				<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>
				<span>{ inFlightVerb(a.Label) }</span>
			</span>
		</button>
	}
}
