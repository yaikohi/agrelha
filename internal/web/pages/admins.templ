package pages

import (
	"fmt"
	"strconv"

	"agrelha/internal/domain"
	"agrelha/internal/web/components"
)

type AdminsProps struct {
	ActiveGame string
	FlashKind  string
	FlashMsg   string

	ValheimPlayers   []domain.Player
	ValheimAdminIDs  []string
	ValheimPasswords []ValheimWorldPasswordUI
	ValheimEnabled   bool

	MCOps             []string
	MCWhitelist       []string
	MCOnlinePlayers   []string
	MCWhitelistActive bool
	MCEnabled         bool

	GModPasswords []GModWorldPasswordUI
}

templ Admins(props AdminsProps) {
	@Layout("Access & Admins") {
		@nav(true)
		<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
			<div>
				<h1 class="text-2xl font-semibold text-zinc-100">Access & Administration</h1>
				<p class="mt-1 text-xs text-zinc-400">Manage server passwords, operator privileges, and player whitelists across all game servers.</p>
			</div>
			<div class="flex items-center gap-2">
				<a
					href={ templ.SafeURL("/" + props.ActiveGame) }
					class="rounded-lg border border-zinc-800 bg-zinc-900/80 px-3 py-1.5 text-xs text-zinc-400 hover:border-zinc-700 hover:text-zinc-200 transition"
				>
					&larr; Back to Dashboard
				</a>
			</div>
		</div>

		<div class="mb-6">
			@components.TabBar(components.TabBarProps{
				Tabs: []components.TabItem{
					{Label: "⚔️ Valheim", Href: "/admins?game=valheim", Active: props.ActiveGame == "valheim"},
					{Label: "⛏️ Minecraft", Href: "/admins?game=minecraft", Active: props.ActiveGame == "minecraft"},
					{Label: "🔧 Garry's Mod", Href: "/admins?game=gmod", Active: props.ActiveGame == "gmod"},
				},
			})
		</div>

		@flashBanner(props.FlashKind, props.FlashMsg)

		if props.ActiveGame == "minecraft" {
			@minecraftAccessTab(props)
		} else if props.ActiveGame == "gmod" {
			@gmodAccessTab(props)
		} else {
			@valheimAccessTab(props)
		}
	}
}

templ valheimAccessTab(props AdminsProps) {
	<div class="mb-6">
		<h2 class="text-xl font-semibold text-zinc-100">Valheim Access & Admins</h2>
		<p class="mt-0.5 text-xs text-zinc-400">Manage server passwords, operator privileges, and player roster.</p>
	</div>
	<div class="mb-8 rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
		<div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-zinc-800/80 pb-3">
			<div>
				<h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-200">Server Passwords</h2>
				<p class="text-xs text-zinc-400">Join passwords configured for Valheim worlds. Share these with trusted players.</p>
			</div>
			<span class="rounded-full border border-zinc-700/60 bg-zinc-800/60 px-2.5 py-0.5 text-xs font-medium text-zinc-300">
				🔒 Password Enforced
			</span>
		</div>
		if len(props.ValheimPasswords) == 0 {
			<div class="rounded-lg border border-zinc-800/60 bg-zinc-950/40 p-4 text-center text-xs text-zinc-500">
				No Valheim worlds configured yet.
			</div>
		} else {
			<div class="divide-y divide-zinc-800/80 overflow-hidden rounded-lg border border-zinc-800/80 bg-zinc-950/50">
				for _, w := range props.ValheimPasswords {
					<div
						class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between"
						data-signals={ fmt.Sprintf("{showPass%d: false}", w.Number) }
					>
						<div class="flex items-center gap-3">
							<span class="flex h-7 w-7 items-center justify-center rounded-md bg-zinc-800 font-mono text-xs font-semibold text-zinc-300 ring-1 ring-zinc-700/50">
								{ fmt.Sprintf("#%02d", w.Number) }
							</span>
							<div>
								<div class="flex items-center gap-2">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/valheim/%d/overview", w.Number)) }
										class="text-sm font-medium text-zinc-200 hover:text-zinc-100 transition"
									>
										{ w.Name }
									</a>
									if w.State == "running" {
										<span class="inline-flex items-center gap-1 rounded-full border border-emerald-800/60 bg-emerald-950/60 px-2 py-0.5 text-[10px] font-medium text-emerald-300">
											<span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
											running
										</span>
									} else if w.State == "stopped" {
										<span class="inline-flex items-center gap-1 rounded-full border border-zinc-700/60 bg-zinc-800/60 px-2 py-0.5 text-[10px] font-medium text-zinc-400">
											<span class="h-1.5 w-1.5 rounded-full bg-zinc-500"></span>
											stopped
										</span>
									} else {
										<span class="inline-flex items-center gap-1 rounded-full border border-amber-800/60 bg-amber-950/60 px-2 py-0.5 text-[10px] font-medium text-amber-300">
											{ w.State }
										</span>
									}
								</div>
								if w.Address != "" {
									<span class="font-mono text-xs text-zinc-500">{ w.Address }</span>
								}
							</div>
						</div>

						<div class="flex items-center gap-2 sm:self-auto">
							if w.Password != "" {
								<div class="flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1.5">
									<span class="text-xs text-zinc-500">Password:</span>
									<span
										data-show={ fmt.Sprintf("!$showPass%d", w.Number) }
										class="font-mono text-xs tracking-widest text-zinc-400 select-none"
									>
										••••••••
									</span>
									<span
										data-show={ fmt.Sprintf("$showPass%d", w.Number) }
										class="font-mono text-xs font-semibold text-zinc-100 select-all"
									>
										{ w.Password }
									</span>
									<button
										type="button"
										data-on:click={ fmt.Sprintf("$showPass%d = !$showPass%d", w.Number, w.Number) }
										class="ml-1 rounded border border-zinc-700/60 bg-zinc-800/80 px-2 py-0.5 text-[10px] font-medium text-zinc-300 hover:bg-zinc-700 hover:text-white transition"
										title="Toggle password visibility"
									>
										<span data-show={ fmt.Sprintf("!$showPass%d", w.Number) }>Show</span>
										<span data-show={ fmt.Sprintf("$showPass%d", w.Number) }>Hide</span>
									</button>
								</div>
								<button
									type="button"
									data-on:click={ w.CopyScript() }
									class="rounded-lg border border-zinc-700 bg-zinc-800/80 px-3 py-1.5 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white transition"
								>
									Copy
								</button>
							} else {
								<span class="rounded-lg border border-zinc-800/60 bg-zinc-900/50 px-3 py-1.5 text-xs italic text-zinc-500">
									No password required (public access)
								</span>
							}
						</div>
					</div>
				}
			</div>
		}
	</div>

	if !props.ValheimEnabled {
		<p class="mb-4 rounded bg-amber-900/40 p-3 text-sm text-amber-200">Declarative plane disabled — set the Codeberg token to grant/revoke admin.</p>
	}
	<form method="post" action="/admins/grant" class="mb-6 flex gap-2">
		<input name="steam_id" placeholder="76561198…" class="w-64 rounded bg-zinc-900 px-3 py-2 text-sm border border-zinc-800 focus:border-zinc-600"/>
		<button class="rounded bg-emerald-700 px-4 py-2 text-sm hover:bg-emerald-600 font-medium">Grant admin</button>
	</form>
	<p class="mb-6 text-xs text-zinc-500">Admin changes commit to git; they apply on the next server restart (ADMINLIST_IDS is rendered on start).</p>
	<h2 class="mb-2 text-sm font-medium text-zinc-400">Current admins ({ strconv.Itoa(len(props.ValheimAdminIDs)) })</h2>
	<ul class="mb-8 divide-y divide-zinc-800 overflow-hidden rounded bg-zinc-900 border border-zinc-800">
		if len(props.ValheimAdminIDs) == 0 {
			<li class="px-4 py-3 text-xs text-zinc-500">No admins configured.</li>
		}
		for _, id := range props.ValheimAdminIDs {
			<li class="flex items-center justify-between px-4 py-2 text-sm">
				<span class="font-mono text-xs text-zinc-300">{ id }</span>
				<form method="post" action="/admins/revoke">
					<input type="hidden" name="steam_id" value={ id }/>
					<button class="rounded bg-red-800 px-3 py-1 text-xs hover:bg-red-700 font-medium text-zinc-200">Revoke</button>
				</form>
			</li>
		}
	</ul>
	<h2 class="mb-2 text-sm font-medium text-zinc-400">Roster</h2>
	<div class="overflow-x-auto rounded border border-zinc-800 bg-zinc-950/40">
		<table class="w-full text-left text-sm">
			<thead class="text-xs uppercase text-zinc-500 border-b border-zinc-800 bg-zinc-900/60">
				<tr><th class="px-4 py-2">Character</th><th>Steam ID</th><th>Sessions</th><th>Last seen</th><th></th></tr>
			</thead>
			<tbody class="divide-y divide-zinc-800">
				if len(props.ValheimPlayers) == 0 {
					<tr><td colspan="5" class="px-4 py-3 text-xs text-zinc-500">No players recorded yet.</td></tr>
				}
				for _, p := range props.ValheimPlayers {
					<tr>
						<td class="px-4 py-2">
							if p.Online {
								<span class="mr-2 inline-block h-2 w-2 rounded-full bg-emerald-500 align-middle" title="online now"></span>
							}
							if p.Character != "" {
								{ p.Character }
							} else {
								<span class="text-zinc-600">—</span>
							}
						</td>
						<td class="font-mono text-xs text-zinc-300">{ p.SteamID }</td>
						<td>{ strconv.Itoa(p.Sessions) }</td>
						<td class="text-zinc-500">{ p.LastSeen.Format("Jan 2 15:04") }</td>
						<td class="px-4 text-right">
							if Contains(props.ValheimAdminIDs, p.SteamID) {
								<span class="text-xs text-emerald-400">admin</span>
							} else {
								<form method="post" action="/admins/grant">
									<input type="hidden" name="steam_id" value={ p.SteamID }/>
									<button class="rounded bg-emerald-800 px-3 py-1 text-xs hover:bg-emerald-700">Grant</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ minecraftAccessTab(props AdminsProps) {
	<div class="mb-6">
		<h2 class="text-xl font-semibold text-zinc-100">Minecraft Access Management</h2>
		<p class="mt-0.5 text-xs text-zinc-400">Configure operator privileges, connection whitelist, and live in-game admission.</p>
	</div>
	if !props.MCEnabled {
		<p class="mb-6 rounded bg-amber-900/40 p-3 text-sm text-amber-200">Declarative plane disabled — set the Codeberg token to manage ops or whitelist.</p>
	}

	<div class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
		<div>
			<div class="flex items-center gap-3">
				<h2 class="text-base font-medium text-zinc-100">Whitelist Enforcement</h2>
				if props.MCWhitelistActive {
					<span class="rounded bg-emerald-950 border border-emerald-800 px-2.5 py-0.5 text-xs font-medium text-emerald-400">ACTIVE (Enforced)</span>
				} else {
					<span class="rounded bg-amber-950 border border-amber-800 px-2.5 py-0.5 text-xs font-medium text-amber-400">DISABLED (Public)</span>
				}
			</div>
			<p class="mt-1 text-xs text-zinc-400">
				if props.MCWhitelistActive {
					Only players in the whitelist are permitted to join. Non-whitelisted players are rejected.
				} else {
					Whitelist is currently inactive in-game — any player with the server address can join.
				}
			</p>
		</div>
		<form method="post" action="/api/minecraft/access/whitelist/toggle">
			if props.MCWhitelistActive {
				<button class="rounded bg-amber-700 px-4 py-2 text-xs font-medium hover:bg-amber-600 text-white">Disable Whitelist</button>
			} else {
				<button class="rounded bg-emerald-700 px-4 py-2 text-xs font-medium hover:bg-emerald-600 text-white">Enforce Whitelist</button>
			}
		</form>
	</div>

	<div class="grid grid-cols-1 gap-8 md:grid-cols-2">
		<section class="rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
			<div class="mb-4">
				<h2 class="text-lg font-medium text-zinc-100">Server Operators ({ strconv.Itoa(len(props.MCOps)) })</h2>
				<p class="text-xs text-zinc-400">Operators hold in-game level-4 admin permissions. Synced live via RCON and stored in Git.</p>
			</div>
			<form method="post" action="/api/minecraft/access/op" class="mb-4 flex gap-2">
				<input name="username" placeholder="Mojang username…" class="w-full rounded bg-zinc-950 px-3 py-2 text-sm border border-zinc-800 focus:border-zinc-600"/>
				<button class="shrink-0 rounded bg-emerald-700 px-4 py-2 text-sm font-medium hover:bg-emerald-600">Op Player</button>
			</form>
			<ul class="divide-y divide-zinc-800 rounded border border-zinc-800 bg-zinc-950 overflow-hidden">
				if len(props.MCOps) == 0 {
					<li class="px-4 py-3 text-xs text-zinc-500">No server operators defined.</li>
				}
				for _, op := range props.MCOps {
					<li class="flex items-center justify-between px-4 py-2.5 text-sm">
						<span class="font-mono text-zinc-200">{ op }</span>
						<form method="post" action="/api/minecraft/access/deop">
							<input type="hidden" name="username" value={ op }/>
							<button class="rounded bg-red-900/60 px-2.5 py-1 text-xs text-red-200 hover:bg-red-800">Deop</button>
						</form>
					</li>
				}
			</ul>
		</section>

		<section class="rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
			<div class="mb-4">
				<h2 class="text-lg font-medium text-zinc-100">Whitelist ({ strconv.Itoa(len(props.MCWhitelist)) })</h2>
				<p class="text-xs text-zinc-400">Players permitted to connect. Synced live via RCON and stored in Git.</p>
			</div>
			<form method="post" action="/api/minecraft/access/whitelist/add" class="mb-4 flex gap-2">
				<input name="username" placeholder="Mojang username…" class="w-full rounded bg-zinc-950 px-3 py-2 text-sm border border-zinc-800 focus:border-zinc-600"/>
				<button class="shrink-0 rounded bg-emerald-700 px-4 py-2 text-sm font-medium hover:bg-emerald-600">Add to Whitelist</button>
			</form>
			<ul class="divide-y divide-zinc-800 rounded border border-zinc-800 bg-zinc-950 overflow-hidden">
				if len(props.MCWhitelist) == 0 {
					<li class="px-4 py-3 text-xs text-zinc-500">Whitelist is empty.</li>
				}
				for _, user := range props.MCWhitelist {
					<li class="flex items-center justify-between px-4 py-2.5 text-sm">
						<span class="font-mono text-zinc-200">{ user }</span>
						<form method="post" action="/api/minecraft/access/whitelist/remove">
							<input type="hidden" name="username" value={ user }/>
							<button class="rounded bg-red-900/60 px-2.5 py-1 text-xs text-red-200 hover:bg-red-800">Remove</button>
						</form>
					</li>
				}
			</ul>
		</section>
	</div>

	<section class="mt-8 rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
		<h2 class="mb-1 text-sm font-medium text-zinc-300">Online Players Now ({ strconv.Itoa(len(props.MCOnlinePlayers)) })</h2>
		<p class="mb-4 text-xs text-zinc-400">Players currently connected in-game. Live query via RCON.</p>
		if len(props.MCOnlinePlayers) == 0 {
			<p class="rounded-lg bg-zinc-950/60 border border-zinc-800/60 p-4 text-xs text-zinc-500">No players currently connected to the server.</p>
		} else {
			<div class="flex flex-wrap gap-3">
				for _, player := range props.MCOnlinePlayers {
					<div class="flex items-center gap-3 rounded-lg bg-zinc-950 px-3.5 py-2 border border-zinc-800">
						<div class="flex items-center gap-2">
							<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
							<span class="font-mono text-sm text-zinc-200">{ player }</span>
						</div>
						<div class="flex items-center gap-1.5 border-l border-zinc-800 pl-3">
							if Contains(props.MCOps, player) {
								<span class="rounded bg-amber-950/80 border border-amber-800/40 px-2 py-0.5 text-[10px] text-amber-400 font-mono">OP</span>
							} else {
								<form method="post" action="/api/minecraft/access/op" class="inline">
									<input type="hidden" name="username" value={ player }/>
									<button class="rounded bg-zinc-800 hover:bg-zinc-700 px-2 py-1 text-[11px] text-zinc-300">Make Op</button>
								</form>
							}
							if Contains(props.MCWhitelist, player) {
								<span class="rounded bg-emerald-950/80 border border-emerald-800/40 px-2 py-0.5 text-[10px] text-emerald-400 font-mono">Whitelisted</span>
							} else {
								<form method="post" action="/api/minecraft/access/whitelist/add" class="inline">
									<input type="hidden" name="username" value={ player }/>
									<button class="rounded bg-zinc-800 hover:bg-zinc-700 px-2 py-1 text-[11px] text-zinc-300">Whitelist</button>
								</form>
							}
						</div>
					</div>
				}
			</div>
		}
	</section>
}

templ gmodAccessTab(props AdminsProps) {
	<div class="mb-6">
		<h2 class="text-xl font-semibold text-zinc-100">Garry's Mod Access & Connection</h2>
		<p class="mt-0.5 text-xs text-zinc-400">Manage world admission passwords, direct connect endpoints, and Steam join links.</p>
	</div>
	<div class="mb-8 rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
		<div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-zinc-800/80 pb-3">
			<div>
				<h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-200">Server Passwords & Connection</h2>
				<p class="text-xs text-zinc-400">Join passwords and direct connect endpoints configured for Garry's Mod worlds.</p>
			</div>
			<span class="rounded-full border border-sky-800/60 bg-sky-950/60 px-2.5 py-0.5 text-xs font-medium text-sky-300">
				Source Engine
			</span>
		</div>
		if len(props.GModPasswords) == 0 {
			<div class="rounded-lg border border-zinc-800/60 bg-zinc-950/40 p-4 text-center text-xs text-zinc-500">
				No Garry's Mod worlds configured yet.
			</div>
		} else {
			<div class="divide-y divide-zinc-800/80 overflow-hidden rounded-lg border border-zinc-800/80 bg-zinc-950/50">
				for _, w := range props.GModPasswords {
					<div
						class="flex flex-col gap-4 p-4 lg:flex-row lg:items-center lg:justify-between"
						data-signals={ fmt.Sprintf("{showGModPass%d: false}", w.Number) }
					>
						<div class="flex items-center gap-3">
							<span class="flex h-7 w-7 items-center justify-center rounded-md bg-zinc-800 font-mono text-xs font-semibold text-zinc-300 ring-1 ring-zinc-700/50">
								{ fmt.Sprintf("#%02d", w.Number) }
							</span>
							<div>
								<div class="flex items-center gap-2">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/gmod/%d/overview", w.Number)) }
										class="text-sm font-medium text-zinc-200 hover:text-zinc-100 transition"
									>
										{ w.Name }
									</a>
									if w.State == "running" {
										<span class="inline-flex items-center gap-1 rounded-full border border-emerald-800/60 bg-emerald-950/60 px-2 py-0.5 text-[10px] font-medium text-emerald-300">
											<span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
											running
										</span>
									} else if w.State == "stopped" {
										<span class="inline-flex items-center gap-1 rounded-full border border-zinc-700/60 bg-zinc-800/60 px-2 py-0.5 text-[10px] font-medium text-zinc-400">
											<span class="h-1.5 w-1.5 rounded-full bg-zinc-500"></span>
											stopped
										</span>
									} else {
										<span class="inline-flex items-center gap-1 rounded-full border border-amber-800/60 bg-amber-950/60 px-2 py-0.5 text-[10px] font-medium text-amber-300">
											{ w.State }
										</span>
									}
								</div>
								if w.Address != "" {
									<span class="font-mono text-xs text-zinc-500">{ w.Address }</span>
								}
							</div>
						</div>

						<div class="flex flex-wrap items-center gap-2">
							if w.Password != "" {
								<div class="flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1.5">
									<span class="text-xs text-zinc-500">Password:</span>
									<span
										data-show={ fmt.Sprintf("!$showGModPass%d", w.Number) }
										class="font-mono text-xs tracking-widest text-zinc-400 select-none"
									>
										••••••••
									</span>
									<span
										data-show={ fmt.Sprintf("$showGModPass%d", w.Number) }
										class="font-mono text-xs font-semibold text-zinc-100 select-all"
									>
										{ w.Password }
									</span>
									<button
										type="button"
										data-on:click={ fmt.Sprintf("$showGModPass%d = !$showGModPass%d", w.Number, w.Number) }
										class="ml-1 rounded border border-zinc-700/60 bg-zinc-800/80 px-2 py-0.5 text-[10px] font-medium text-zinc-300 hover:bg-zinc-700 hover:text-white transition"
										title="Toggle password visibility"
									>
										<span data-show={ fmt.Sprintf("!$showGModPass%d", w.Number) }>Show</span>
										<span data-show={ fmt.Sprintf("$showGModPass%d", w.Number) }>Hide</span>
									</button>
								</div>
								<button
									type="button"
									data-on:click={ w.CopyPasswordScript() }
									class="rounded-lg border border-zinc-700 bg-zinc-800/80 px-3 py-1.5 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white transition"
								>
									Copy
								</button>
							} else {
								<span class="rounded-lg border border-zinc-800/60 bg-zinc-900/50 px-3 py-1.5 text-xs italic text-zinc-500">
									No password (public)
								</span>
							}

							if w.LBIP != "" {
								<button
									type="button"
									data-on:click={ w.CopyCommandScript() }
									class="rounded-lg border border-zinc-700 bg-zinc-800/80 px-3 py-1.5 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white transition"
								>
									Copy Connect Cmd
								</button>
								<a
									href={ templ.SafeURL(w.SteamURL()) }
									class="rounded-lg bg-zinc-100 px-3.5 py-1.5 text-xs font-semibold text-zinc-950 shadow hover:bg-white transition inline-flex items-center gap-1"
								>
									Join via Steam 🚀
								</a>
							}
						</div>
					</div>
				}
			</div>
		}
	</div>

	<div class="rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
		<h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-200 mb-2">Garry's Mod Administration Architecture</h2>
		<p class="text-xs text-zinc-400 mb-4">How admission gating, remote administration, and in-game operator permissions operate on Source Engine:</p>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-3 text-xs">
			<div class="rounded-lg border border-zinc-800 bg-zinc-950/60 p-4">
				<span class="font-semibold text-zinc-200 block mb-1">🔐 Password Admission</span>
				<p class="text-zinc-400">Server admission is gated at connection time via <code class="font-mono text-zinc-300">+sv_password</code>. Players connecting without the correct password are rejected by the engine.</p>
			</div>
			<div class="rounded-lg border border-zinc-800 bg-zinc-950/60 p-4">
				<span class="font-semibold text-zinc-200 block mb-1">⚡ In-Game Roles (Lua)</span>
				<p class="text-zinc-400">GMod has no static ops file. In-game admin powers (noclip, kick, ban, godmode) are managed through Workshop addons such as <span class="text-zinc-200 font-medium">ULX / ULib</span> or <span class="text-zinc-200 font-medium">SAM</span> configured inside the collection.</p>
			</div>
			<div class="rounded-lg border border-zinc-800 bg-zinc-950/60 p-4">
				<span class="font-semibold text-zinc-200 block mb-1">📡 Remote RCON</span>
				<p class="text-zinc-400">Source RCON protocol runs on TCP port <code class="font-mono text-zinc-300">27015</code>, authenticated via the cluster RCON secret, enabling direct console commands and remote management.</p>
			</div>
		</div>
	</div>
}

