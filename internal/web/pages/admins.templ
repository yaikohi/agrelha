package pages

import (
	"fmt"
	"strconv"

	"agrelha/internal/domain"
)

templ Admins(players []domain.Player, adminIDs []string, passwords []ValheimWorldPasswordUI, enabled bool, flashKind, flashMsg string) {
	@Layout("Admins") {
		@nav()
		<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
			<div>
				<h1 class="text-2xl font-semibold text-zinc-100">Valheim Access & Admins</h1>
				<p class="mt-1 text-xs text-zinc-400">Manage server passwords, operator privileges, and player roster.</p>
			</div>
			<div class="flex items-center gap-2">
				<a
					href="/valheim"
					class="rounded-lg border border-zinc-800 bg-zinc-900/80 px-3 py-1.5 text-xs text-zinc-400 hover:border-zinc-700 hover:text-zinc-200 transition"
				>
					&larr; Valheim Worlds
				</a>
			</div>
		</div>
		@flashBanner(flashKind, flashMsg)

		<!-- Server Passwords Card -->
		<div class="mb-8 rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
			<div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-zinc-800/80 pb-3">
				<div>
					<h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-200">Server Passwords</h2>
					<p class="text-xs text-zinc-400">Join passwords configured for Valheim worlds. Share these with trusted players.</p>
				</div>
				<span class="rounded-full border border-orange-800/60 bg-orange-950/60 px-2.5 py-0.5 text-xs font-medium text-orange-300">
					🔒 Password Enforced
				</span>
			</div>
			if len(passwords) == 0 {
				<div class="rounded-lg border border-zinc-800/60 bg-zinc-950/40 p-4 text-center text-xs text-zinc-500">
					No Valheim worlds configured yet.
				</div>
			} else {
				<div class="divide-y divide-zinc-800/80 overflow-hidden rounded-lg border border-zinc-800/80 bg-zinc-950/50">
					for _, w := range passwords {
						<div
							class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between"
							data-signals={ fmt.Sprintf("{showPass%d: false}", w.Number) }
						>
							<div class="flex items-center gap-3">
								<span class="flex h-7 w-7 items-center justify-center rounded-md bg-zinc-800 font-mono text-xs font-semibold text-zinc-300 ring-1 ring-zinc-700/50">
									{ fmt.Sprintf("#%02d", w.Number) }
								</span>
								<div>
									<div class="flex items-center gap-2">
										<a
											href={ templ.SafeURL(fmt.Sprintf("/valheim/instances/%d", w.Number)) }
											class="text-sm font-medium text-zinc-200 hover:text-orange-400 transition"
										>
											{ w.Name }
										</a>
										if w.State == "running" {
											<span class="inline-flex items-center gap-1 rounded-full border border-emerald-800/60 bg-emerald-950/60 px-2 py-0.5 text-[10px] font-medium text-emerald-300">
												<span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
												running
											</span>
										} else if w.State == "stopped" {
											<span class="inline-flex items-center gap-1 rounded-full border border-zinc-700/60 bg-zinc-800/60 px-2 py-0.5 text-[10px] font-medium text-zinc-400">
												<span class="h-1.5 w-1.5 rounded-full bg-zinc-500"></span>
												stopped
											</span>
										} else {
											<span class="inline-flex items-center gap-1 rounded-full border border-amber-800/60 bg-amber-950/60 px-2 py-0.5 text-[10px] font-medium text-amber-300">
												{ w.State }
											</span>
										}
									</div>
									if w.Address != "" {
										<span class="font-mono text-xs text-zinc-500">{ w.Address }</span>
									}
								</div>
							</div>

							<!-- Password Display & Controls -->
							<div class="flex items-center gap-2 sm:self-auto">
								if w.Password != "" {
									<div class="flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1.5">
										<span class="text-xs text-zinc-500">Password:</span>
										<span
											data-show={ fmt.Sprintf("!$showPass%d", w.Number) }
											class="font-mono text-xs tracking-widest text-zinc-400 select-none"
										>
											••••••••
										</span>
										<span
											data-show={ fmt.Sprintf("$showPass%d", w.Number) }
											class="font-mono text-xs font-semibold text-orange-300 select-all"
										>
											{ w.Password }
										</span>
										<button
											type="button"
											data-on:click={ fmt.Sprintf("$showPass%d = !$showPass%d", w.Number, w.Number) }
											class="ml-1 rounded border border-zinc-700/60 bg-zinc-800/80 px-2 py-0.5 text-[10px] font-medium text-zinc-300 hover:bg-zinc-700 hover:text-white transition"
											title="Toggle password visibility"
										>
											<span data-show={ fmt.Sprintf("!$showPass%d", w.Number) }>Show</span>
											<span data-show={ fmt.Sprintf("$showPass%d", w.Number) }>Hide</span>
										</button>
									</div>
									<button
										type="button"
										data-on:click={ w.CopyScript() }
										class="rounded-lg border border-zinc-700 bg-zinc-800/80 px-3 py-1.5 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white transition"
									>
										Copy
									</button>
								} else {
									<span class="rounded-lg border border-zinc-800/60 bg-zinc-900/50 px-3 py-1.5 text-xs italic text-zinc-500">
										No password required (public access)
									</span>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>
		if !enabled {
			<p class="mb-4 rounded bg-amber-900/40 p-3 text-sm text-amber-200">Declarative plane disabled — set the Codeberg token to grant/revoke admin.</p>
		}
		<form method="post" action="/admins/grant" class="mb-6 flex gap-2">
			<input name="steam_id" placeholder="76561198…" class="w-64 rounded bg-zinc-900 px-3 py-2 text-sm"/>
			<button class="rounded bg-emerald-700 px-4 py-2 text-sm hover:bg-emerald-600">Grant admin</button>
		</form>
		<p class="mb-6 text-xs text-zinc-500">Admin changes commit to git; they apply on the next server restart (ADMINLIST_IDS is rendered on start).</p>
		<h2 class="mb-2 text-sm font-medium text-zinc-400">Current admins ({ strconv.Itoa(len(adminIDs)) })</h2>
		<ul class="mb-8 divide-y divide-zinc-800 overflow-hidden rounded bg-zinc-900">
			for _, id := range adminIDs {
				<li class="flex items-center justify-between px-4 py-2 text-sm">
					<span class="font-mono text-xs">{ id }</span>
					<form method="post" action="/admins/revoke">
						<input type="hidden" name="steam_id" value={ id }/>
						<button class="rounded bg-red-800 px-3 py-1 text-xs hover:bg-red-700">Revoke</button>
					</form>
				</li>
			}
		</ul>
		<h2 class="mb-2 text-sm font-medium text-zinc-400">Roster</h2>
		<div class="overflow-x-auto">
			<table class="w-full text-left text-sm">
				<thead class="text-xs uppercase text-zinc-500">
					<tr><th class="py-2">Character</th><th>Steam ID</th><th>Sessions</th><th>Last seen</th><th></th></tr>
				</thead>
				<tbody class="divide-y divide-zinc-800">
					for _, p := range players {
						<tr>
							<td class="py-2">
								if p.Online {
									<span class="mr-2 inline-block h-2 w-2 rounded-full bg-emerald-500 align-middle" title="online now"></span>
								}
								if p.Character != "" {
									{ p.Character }
								} else {
									<span class="text-zinc-600">—</span>
								}
							</td>
							<td class="font-mono text-xs">{ p.SteamID }</td>
							<td>{ strconv.Itoa(p.Sessions) }</td>
							<td class="text-zinc-500">{ p.LastSeen.Format("Jan 2 15:04") }</td>
							<td class="text-right">
								if Contains(adminIDs, p.SteamID) {
									<span class="text-xs text-emerald-400">admin</span>
								} else {
									<form method="post" action="/admins/grant">
										<input type="hidden" name="steam_id" value={ p.SteamID }/>
										<button class="rounded bg-emerald-800 px-3 py-1 text-xs hover:bg-emerald-700">Grant</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
