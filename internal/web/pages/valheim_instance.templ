package pages

import (
	"agrelha/internal/web/components"
	"fmt"

	"agrelha/internal/web/shared"
)

templ ValheimInstanceDetail(d InstanceDetailUI) {
	@instancePage(valheimInstanceSpec, d) {
		if d.ActiveTab == "overview" {
			@IncidentPanel(d.LastIncident)
			@instanceOverview(buildInstanceOverview(valheimInstanceSpec, d))
		}
		if d.ActiveTab == "console" {
			@instanceConsole("valheim", d.Number, shared.LogSourceNote(d.Host), "Connecting to the Valheim container logs…")
		}
		if d.ActiveTab == "crashes" {
			@IncidentList(d)
		}
		if d.ActiveTab == "mods" {
			@valheimModsTab(d)
		}
		if d.ActiveTab == "configs" {
			@ValheimConfigsTab(d)
		}
		if d.ActiveTab == "backups" {
			@valheimBackupsTab(d)
		}
		if d.ActiveTab == "settings" {
			@valheimSettingsTab(d)
		}
	}
}

templ valheimModsTab(d InstanceDetailUI) {
	<div
		data-signals="{modQuery: '', modSearchLoading: false, addslug: '', showModDetail: false}"
		data-effect={ fmt.Sprintf("@post('/api/valheim/%d/mods/search', {payload: {q: ''}})", d.Number) }
	>
		@components.SectionHead("Search Thunderstore", "Search Valheim mods by name, author or keyword — mining, build, equipment, jotunn.")
		<div class="mt-4 flex flex-wrap gap-2">
			<input
				type="text"
				data-bind="modQuery"
				data-on:keydown={ fmt.Sprintf("if (evt.key === 'Enter') { evt.preventDefault(); @post('/api/valheim/%d/mods/search', {payload: {q: $modQuery}}) }", d.Number) }
				placeholder="Mining, Jotunn, EquipmentAndQuickSlots, PlantEasily…"
				class={ "flex-1 " + components.InputClass() }
			/>
			<button
				type="button"
				data-indicator="modSearchLoading"
				data-on:click={ fmt.Sprintf("@post('/api/valheim/%d/mods/search', {payload: {q: $modQuery}})", d.Number) }
				class={ components.ButtonClass(components.VariantPrimary) }
			>
				<span data-show="!$modSearchLoading">Search</span>
				<span data-show="$modSearchLoading">Searching…</span>
			</button>
			<a href="https://thunderstore.io/c/valheim/" target="_blank" rel="noopener noreferrer" class={ components.ButtonClass(components.VariantSecondary) }>Browse Thunderstore</a>
		</div>
		<div id="valheim-mod-results" class="mt-6 grid max-h-[640px] grid-cols-1 gap-3 overflow-y-auto pr-1 md:grid-cols-2">
			<p class="col-span-full py-12 text-center font-pixel text-xs text-ink-faint">Loading popular Thunderstore mods…</p>
		</div>
		<details class="mt-6 border-t border-seam pt-4">
			<summary class="focus-accent cursor-pointer font-pixel text-[11px] text-ink-muted transition-colors hover:text-accent">Install by exact package slug</summary>
			<p class="mt-2 max-w-prose font-display text-sm leading-relaxed text-ink-muted">
				Add a version to pin it exactly — Namespace-Name-1.2.3. That overwrites the pin of a mod that is already installed, which is how you go back to a version that worked.
			</p>
			<form
				class="mt-3 flex flex-wrap items-center gap-2"
				data-on:submit__prevent={ fmt.Sprintf("@post('/api/valheim/%d/mods/install', {payload: {slug: $addslug}}); $addslug = ''", d.Number) }
			>
				<input
					type="text"
					data-bind="addslug"
					placeholder="ValheimModding-Jotunn or Skarif-AutoRepairBuilding-1.2.15"
					class={ "flex-1 " + components.InputClass() }
				/>
				<button type="submit" class={ components.ButtonClass(components.VariantSecondary) }>Install</button>
			</form>
		</details>
		<div id="mod-updates-panel">
			@ModUpdatePanel(d)
		</div>
		@components.SectionHead("Installed mods", fmt.Sprintf("%d mods configured in mods.txt.", len(d.InstalledMods)))
		if len(d.InstalledMods) == 0 {
			@components.Prose("No mods installed. This world runs clean BepInEx.")
		} else {
			<div id="installed-mods-container">
				@components.RowList() {
					for _, modSlug := range d.InstalledMods {
						<div class={ components.RowClass() }>
							<span class="min-w-0 break-all font-pixel text-xs text-ink">{ modSlug }</span>
							<button
								type="button"
								data-on:click={ fmt.Sprintf("@post('/api/valheim/%d/mods/remove?slug=%s', {payload: {slug: '%s'}})", d.Number, modSlug, modSlug) }
								class={ components.ButtonClass(components.VariantDanger) }
							>Remove</button>
						</div>
					}
				}
			</div>
		}
		@components.Drawer("showModDetail", "valheim-mod-detail-content", "Loading mod details…")
	</div>
}

templ valheimBackupsTab(d InstanceDetailUI) {
	<div data-signals="{restoreModalOpen: false, selectedArchive: '', newWorldName: '', newWorldTier: 'medium'}">
		@components.SectionHead("World backups", "Backups live on the redundant TrueNAS share. A daily snapshot runs at 04:00 UTC.")
		<div class="mt-4">
			<button
				type="button"
				data-on:click={ fmt.Sprintf("@post('/api/valheim/%d/backups/create')", d.Number) }
				class={ components.ButtonClass(components.VariantPrimary) }
			>Back up now</button>
		</div>
		if len(d.Backups) == 0 {
			@components.Prose("No backups yet. They appear here once you make one or the daily snapshot runs.")
		} else {
			@components.RowList() {
				for _, b := range d.Backups {
					<div class={ components.RowClass() }>
						<div class="min-w-0">
							<p class="break-all font-pixel text-xs text-ink">{ b.Name }</p>
							<p class="mt-1 flex flex-wrap gap-x-4 font-pixel text-[11px] text-ink-faint">
								<span>{ fmt.Sprintf("%.1f MB", float64(b.SizeBytes)/(1024*1024)) }</span>
								<span>{ b.CreatedAt }</span>
							</p>
						</div>
						<div class="flex flex-wrap items-center gap-2">
							if d.State == "running" {
								<span title="Stop the world first to restore in place" class={ components.ButtonClass(components.VariantDisabled) }>Restore in place</span>
							} else {
								<button
									type="button"
									data-on:click={ fmt.Sprintf("if (confirm('Restore %s in-place over current Valheim world data?')) @post('/api/valheim/%d/backups/restore-inplace?archive=%s', {payload: {archive: '%s'}})", b.Name, d.Number, b.Name, b.Name) }
									class={ components.ButtonClass(components.VariantPrimary) }
								>Restore in place</button>
							}
							<a href={ templ.SafeURL(fmt.Sprintf("/api/valheim/%d/backups/download?f=%s", d.Number, b.Name)) } class={ components.ButtonClass(components.VariantSecondary) }>Download</a>
							<button
								type="button"
								data-on:click={ fmt.Sprintf("if (confirm('Permanently delete backup %s from NAS?')) @post('/api/valheim/%d/backups/delete?file=%s', {payload: {file: '%s'}})", b.Name, d.Number, b.Name, b.Name) }
								class={ components.ButtonClass(components.VariantDanger) }
							>Delete</button>
						</div>
					</div>
				}
			}
		}
	</div>
}

templ valheimSettingsTab(d InstanceDetailUI) {
	<div class="max-w-xl">
		@components.SectionHead("Settings", "Change how this Valheim world is configured.")
		<form
			class="mt-6 space-y-5"
			data-on:submit__prevent={ fmt.Sprintf("@post('/api/valheim/%d/settings', {contentType: 'form'})", d.Number) }
		>
			<div>
				<label for="valheim-name" class="block font-pixel text-[11px] text-ink-faint">World name</label>
				<input id="valheim-name" type="text" name="name" value={ d.Name } required class={ "mt-1.5 " + components.InputClass() }/>
			</div>
			<div>
				<label for="valheim-password" class="block font-pixel text-[11px] text-ink-faint">Password</label>
				<input id="valheim-password" type="text" name="password" value={ d.Password } placeholder="at least 5 characters, or blank for no password" class={ "mt-1.5 " + components.InputClass() }/>
			</div>
			<div>
				<label for="valheim-tier" class="block font-pixel text-[11px] text-ink-faint">Resource tier</label>
				<select id="valheim-tier" name="tier" class={ "mt-1.5 " + components.InputClass() }>
					for _, t := range valheimTiers() {
						if d.Tier == t.Value {
							<option value={ t.Value } selected>{ t.Label }</option>
						} else {
							<option value={ t.Value }>{ t.Label }</option>
						}
					}
				</select>
			</div>
			<div class="flex justify-end pt-2">
				<button type="submit" class={ components.ButtonClass(components.VariantPrimary) }>Save changes</button>
			</div>
		</form>
	</div>
}
