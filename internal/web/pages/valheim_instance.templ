package pages

import (
	"fmt"
	"agrelha/internal/web/components"
)

templ ValheimInstanceDetail(d InstanceDetailUI) {
	@Layout(d.Name + " · Valheim") {
		@nav()
		<div class="space-y-6">
			<!-- Breadcrumb & Top Bar -->
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<div class="flex items-center gap-2 text-xs text-zinc-500">
						<a href="/valheim" class="hover:text-zinc-300">Valheim</a>
						<span>/</span>
						<span class="font-mono text-zinc-400">{ fmt.Sprintf("#%02d", d.Number) }</span>
						<span>/</span>
						<span class="font-semibold text-zinc-200">{ d.Name }</span>
					</div>
					<div class="mt-1 flex items-center gap-3">
						<h1 class="text-xl font-bold text-zinc-100">{ d.Name }</h1>
						@components.StatusPill(components.StatusPillProps{State: d.State})
					</div>
				</div>

				<!-- Header quick controls -->
				<div class="flex items-center gap-2">
					if d.State == "running" {
						@components.Button(components.ButtonProps{
							Variant: components.VariantWarning,
							Size:    components.SizeSm,
							OnClick: fmt.Sprintf("@post('/api/valheim/instances/%d/stop')", d.Number),
							Text:    "Stop Server",
						})
						@components.Button(components.ButtonProps{
							Variant: components.VariantSecondary,
							Size:    components.SizeSm,
							OnClick: fmt.Sprintf("@post('/api/valheim/instances/%d/restart')", d.Number),
							Text:    "Restart",
						})
					} else {
						@components.Button(components.ButtonProps{
							Variant: components.VariantSuccess,
							Size:    components.SizeSm,
							OnClick: fmt.Sprintf("@post('/api/valheim/instances/%d/start')", d.Number),
							Text:    "Start Server",
						})
					}
				</div>
			</div>

			<!-- Tabs Navigation -->
			@components.TabBar(components.TabBarProps{
				Tabs: []components.TabItem{
					{Label: "Overview", Href: fmt.Sprintf("/valheim/%d/overview", d.Number), Active: d.ActiveTab == "overview"},
					{Label: "Mods", Href: fmt.Sprintf("/valheim/%d/mods", d.Number), Active: d.ActiveTab == "mods"},
					{Label: "Configs", Href: fmt.Sprintf("/valheim/%d/configs", d.Number), Active: d.ActiveTab == "configs"},
					{Label: "Console & Logs", Href: fmt.Sprintf("/valheim/%d/console", d.Number), Active: d.ActiveTab == "console"},
					{Label: "Backups", Href: fmt.Sprintf("/valheim/%d/backups", d.Number), Active: d.ActiveTab == "backups"},
					{Label: "Settings", Href: fmt.Sprintf("/valheim/%d/settings", d.Number), Active: d.ActiveTab == "settings"},
				},
			})

			<!-- TAB 1: OVERVIEW -->
			if d.ActiveTab == "overview" {
				<div class="space-y-6">
					@IncidentPanel(d.LastIncident)
					<!-- Connection address hero banner -->
					<div class="flex flex-col gap-3 rounded-2xl border border-zinc-800 bg-zinc-900/70 p-6 sm:flex-row sm:items-center sm:justify-between">
						<div>
							<span class="text-xs font-medium text-zinc-400 uppercase tracking-wider">Server Connection</span>
							<div class="mt-1 flex items-center gap-3">
								<code class="font-mono text-lg font-bold text-white">{ ConnectAddress(d.LBIP, 2456) }</code>
								<button
									type="button"
									data-on:click={ fmt.Sprintf("navigator.clipboard.writeText('%s:2456')", d.LBIP) }
									class="rounded-lg border border-zinc-700 bg-zinc-800/80 px-2.5 py-1 text-[11px] text-zinc-300 hover:bg-zinc-700 hover:text-white"
								>
									Copy
								</button>
							</div>
							if d.Password != "" {
								<p class="mt-1 text-xs text-zinc-400">
									Password: <code class="font-mono text-zinc-200 font-semibold">{ d.Password }</code>
								</p>
							} else {
								<p class="mt-1 text-xs text-zinc-500">No password required (public access)</p>
							}
						</div>
						<div class="flex items-center gap-2">
							<a
								href={ templ.SafeURL(fmt.Sprintf("/api/valheim/%d/mods/export", d.Number)) }
								class="rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-2 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white"
							>
								Download .r2z Profile
							</a>
						</div>
					</div>

					<!-- Client modpack info -->
					<div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5">
						<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
							<div>
								<span class="text-xs font-semibold text-zinc-300 uppercase tracking-wider">How to join with friends</span>
								<p class="mt-1 text-xs text-zinc-400 leading-relaxed">
									Download the <strong>.r2z modpack profile</strong> above and import it into <strong>r2modman</strong> or <strong>Thunderstore Mod Manager</strong> (<em>Import &rarr; From file</em>) to match the server mod-for-mod. Connect in Valheim to <code class="rounded border border-zinc-700 bg-zinc-800 px-1.5 py-0.5 font-mono text-zinc-200">{ d.LBIP }:2456</code>.
								</p>
							</div>
						</div>
					</div>

					<!-- Details Grid -->
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
						<div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-5">
							<span class="text-xs text-zinc-500">Engine / Modding</span>
							<p class="mt-1 text-base font-semibold text-zinc-100 uppercase">Valheim</p>
							<p class="text-xs font-mono text-zinc-400">BepInEx Enabled</p>
						</div>

						<div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-5">
							<span class="text-xs text-zinc-500">Resource Tier</span>
							<p class="mt-1 text-base font-semibold text-zinc-100 capitalize">{ d.Tier }</p>
							<p class="text-xs text-zinc-400">{ fmt.Sprintf("%d GiB RAM limit", d.MemoryGiB) }</p>
						</div>

						<div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-5">
							<span class="text-xs text-zinc-500">Installed Mods</span>
							<p class="mt-1 text-base font-semibold text-zinc-100">{ fmt.Sprintf("%d mods", len(d.InstalledMods)) }</p>
							<p class="text-xs text-zinc-400">Thunderstore & BepInEx</p>
						</div>
					</div>

					if d.Seed != "" {
						<div class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-4">
							<span class="text-xs text-zinc-500">World Seed:</span>
							<p class="mt-1 font-mono text-xs text-zinc-300">{ d.Seed }</p>
						</div>
					}
				</div>
			}

			<!-- TAB 2: MODS -->
			if d.ActiveTab == "mods" {
				<div
					class="space-y-6"
					data-signals="{modQuery: '', modSearchLoading: false, addslug: '', showModDetail: false}"
					data-effect={ fmt.Sprintf("@post('/api/valheim/%d/mods/search', {payload: {q: ''}})", d.Number) }
				>
					<!-- Search Thunderstore Mods Panel -->
					<div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-5 shadow-sm">
						<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
							<div>
								<h3 class="text-sm font-semibold text-zinc-100">Search & Install Thunderstore Mods</h3>
								<p class="text-xs text-zinc-400">Search for Valheim mods by name, author, or keyword (e.g. mining, build, equipment, jotunn).</p>
							</div>
							<a href="https://thunderstore.io/c/valheim/" target="_blank" rel="noopener noreferrer" class="text-xs text-zinc-400 hover:text-zinc-200 transition">
								Browse Thunderstore ↗
							</a>
						</div>

						<div class="flex gap-2">
							<input
								type="text"
								data-bind="modQuery"
								data-on:keydown={ fmt.Sprintf("if (evt.key === 'Enter') { evt.preventDefault(); @post('/api/valheim/%d/mods/search', {payload: {q: $modQuery}}) }", d.Number) }
								placeholder="Search mods (e.g. Mining, Jotunn, EquipmentAndQuickSlots, PlantEasily)..."
								class="flex-1 rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none"
							/>
							<button
								type="button"
								data-indicator="modSearchLoading"
								data-on:click={ fmt.Sprintf("@post('/api/valheim/%d/mods/search', {payload: {q: $modQuery}})", d.Number) }
								class="rounded-xl bg-zinc-100 px-5 py-2.5 text-xs font-semibold text-zinc-950 hover:bg-white transition"
							>
								<span data-show="!$modSearchLoading">Search</span>
								<span data-show="$modSearchLoading" class="animate-pulse">Searching...</span>
							</button>
						</div>

						<!-- Results container populated via SSE -->
						<div id="valheim-mod-results" class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3 max-h-[640px] overflow-y-auto pr-1">
							<div class="col-span-full py-12 text-center text-xs text-zinc-500 animate-pulse">
								Loading popular Thunderstore mods...
							</div>
						</div>

						<!-- Collapsible exact slug install -->
						<details class="mt-4 pt-3 border-t border-zinc-800/80">
							<summary class="text-xs text-zinc-500 cursor-pointer hover:text-zinc-300">Or install via exact package slug / identifier...</summary>
							<form
								class="mt-2 flex items-center gap-2"
								data-on:submit__prevent={ fmt.Sprintf("@post('/api/valheim/%d/mods/install', {payload: {slug: $addslug}}); $addslug = ''", d.Number) }
							>
								<input
									type="text"
									data-bind="addslug"
									placeholder="e.g. denikson-BepInExPack_Valheim or ValheimModding-Jotunn"
									class="flex-1 rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-1.5 text-xs text-zinc-100 placeholder-zinc-500 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none font-mono"
								/>
								<button
									type="submit"
									class="rounded-lg bg-zinc-800 border border-zinc-700 px-3 py-1.5 text-xs font-medium text-zinc-200 hover:bg-zinc-700 hover:text-white transition"
								>
									Install Slug
								</button>
							</form>
						</details>
					</div>

					<div class="flex items-center justify-between">
						<div>
							<h2 class="text-base font-semibold text-zinc-100">Installed Mods</h2>
							<p class="mt-0.5 text-xs text-zinc-400">{ fmt.Sprintf("%d mods configured in mods.txt", len(d.InstalledMods)) }</p>
						</div>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/api/valheim/%d/mods/export", d.Number)) }
							class="rounded-lg border border-zinc-700 bg-zinc-800 px-3.5 py-1.5 text-xs font-semibold text-zinc-200 hover:bg-zinc-700 hover:text-white transition"
						>
							Export Profile (.r2z)
						</a>
					</div>

					<div id="installed-mods-container" class="rounded-xl border border-zinc-800 bg-zinc-900/80 overflow-hidden">
						if len(d.InstalledMods) == 0 {
							<div class="p-8 text-center text-xs text-zinc-500">
								No custom mods installed in this world. Server runs clean BepInEx.
							</div>
						} else {
							<table class="w-full text-left text-xs">
								<thead class="border-b border-zinc-800 bg-zinc-950/60 text-zinc-400">
									<tr>
										<th class="px-4 py-2.5 font-medium">Mod Package</th>
										<th class="px-4 py-2.5 font-medium text-right">Actions</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-zinc-800/60">
									for _, modSlug := range d.InstalledMods {
										<tr class="hover:bg-zinc-800/30">
											<td class="px-4 py-2.5 font-mono text-zinc-200">{ modSlug }</td>
											<td class="px-4 py-2.5 text-right">
												<button
													type="button"
													data-on:click={ fmt.Sprintf("@post('/api/valheim/%d/mods/remove?slug=%s', {payload: {slug: '%s'}})", d.Number, modSlug, modSlug) }
													class="text-red-400 hover:text-red-300 transition"
												>Remove</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</div>

					<!-- Slide-over Mod Detail Drawer Modal -->
					<div
						data-show="$showModDetail"
						class="fixed inset-0 z-50 flex justify-end bg-black/60 backdrop-blur-xs transition-opacity duration-300"
						style="display: none;"
					>
						<!-- Backdrop dismiss click -->
						<div class="fixed inset-0" data-on:click="$showModDetail = false"></div>
						<!-- Drawer Panel -->
						<div class="relative z-10 w-full max-w-2xl bg-zinc-900 border-l border-zinc-800 shadow-2xl overflow-y-auto h-full flex flex-col">
							<div id="valheim-mod-detail-content">
								<div class="p-8 text-center text-zinc-500 text-sm animate-pulse">Loading mod details...</div>
							</div>
						</div>
					</div>
				</div>
			}

			<!-- TAB 3: CONFIGS -->
			if d.ActiveTab == "configs" {
				<div
					class="space-y-6"
					data-signals="{selectedFile: '', fileContent: '', isNew: false, saveLoading: false, showEditor: false}"
				>
					<div class="flex items-center justify-between">
						<div>
							<h2 class="text-base font-semibold text-zinc-100">BepInEx Configurations</h2>
							<p class="mt-0.5 text-xs text-zinc-400">Custom .cfg and .json files synced to BepInEx config directory on container startup.</p>
						</div>
						<button
							type="button"
							data-on:click="$selectedFile = ''; $fileContent = ''; $isNew = true; $showEditor = true"
							class="rounded-lg bg-zinc-100 px-3.5 py-1.5 text-xs font-semibold text-zinc-950 hover:bg-white"
						>
							+ New Config File
						</button>
					</div>

					<!-- Config Editor Modal / Panel -->
					<div data-show="$showEditor" class="rounded-xl border border-zinc-800 bg-zinc-900/95 p-5 space-y-4 shadow-xl">
						<div class="flex items-center justify-between border-b border-zinc-800 pb-3">
							<h3 class="text-sm font-semibold text-zinc-200">
								<span data-show="$isNew">Create New Config File</span>
								<span data-show="!$isNew">Editing: <code class="font-mono text-zinc-300 font-semibold" data-text="$selectedFile"></code></span>
							</h3>
							<button
								type="button"
								data-on:click="$showEditor = false"
								class="text-xs text-zinc-400 hover:text-zinc-200"
							>
								✕ Close
							</button>
						</div>

						<div data-show="$isNew">
							<label class="block text-xs font-medium text-zinc-300">File Name (.cfg, .json, .yaml)</label>
							<input
								type="text"
								data-bind="selectedFile"
								placeholder="e.g. org.bepinex.plugins.valheim_plus.cfg"
								class="mt-1 w-full max-w-md rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-2 text-xs font-mono text-zinc-100 placeholder-zinc-500 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none"
							/>
						</div>

						<div>
							<label class="block text-xs font-medium text-zinc-300">File Contents</label>
							<textarea
								data-bind="fileContent"
								rows="16"
								spellcheck="false"
								placeholder="# Paste or type config contents here..."
								class="mt-1 w-full rounded-xl border border-zinc-700 bg-zinc-950 p-3 font-mono text-xs text-zinc-200 placeholder-zinc-600 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none leading-relaxed"
							></textarea>
						</div>

						<div class="flex items-center justify-between pt-2">
							<button
								type="button"
								data-on:click="$showEditor = false"
								class="rounded-lg border border-zinc-700 px-4 py-2 text-xs text-zinc-300 hover:bg-zinc-800"
							>
								Cancel
							</button>
							<button
								type="button"
								data-indicator="saveLoading"
								data-on:click={ fmt.Sprintf("@post('/api/valheim/%d/configs/save', {payload: {file: $selectedFile, content: $fileContent}})", d.Number) }
								class="rounded-lg bg-zinc-100 px-5 py-2 text-xs font-semibold text-zinc-950 shadow-md hover:bg-white"
							>
								<span data-show="!$saveLoading">Save & Apply on Restart</span>
								<span data-show="$saveLoading" class="animate-pulse">Saving...</span>
							</button>
						</div>
					</div>

					<!-- Config Files List -->
					<div class="rounded-xl border border-zinc-800 bg-zinc-900/80 overflow-hidden">
						if len(d.ConfigFiles) == 0 {
							<div class="p-8 text-center text-xs text-zinc-500">
								No custom BepInEx configs configured for this world yet. Mods use default configurations.
							</div>
						} else {
							<table class="w-full text-left text-xs">
								<thead class="border-b border-zinc-800 bg-zinc-950/60 text-zinc-400">
									<tr>
										<th class="px-4 py-2.5 font-medium">Config File</th>
										<th class="px-4 py-2.5 font-medium text-right">Actions</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-zinc-800/60">
									for _, cfgFile := range d.ConfigFiles {
										<tr class="hover:bg-zinc-800/30">
											<td class="px-4 py-2.5 font-mono text-zinc-200">{ cfgFile }</td>
											<td class="px-4 py-2.5 text-right space-x-2">
												<button
													type="button"
													data-on:click={ fmt.Sprintf("@get('/api/valheim/%d/configs/file?f=%s')", d.Number, cfgFile) }
													class="rounded bg-zinc-800 px-2.5 py-1 text-xs text-zinc-300 hover:bg-zinc-700 hover:text-white"
												>
													Edit
												</button>
												<button
													type="button"
													data-on:click={ fmt.Sprintf("if (confirm('Delete %s?')) { @post('/api/valheim/%d/configs/delete?file=%s', {payload: {file: '%s'}})", cfgFile, d.Number, cfgFile, cfgFile) }
													class="rounded bg-red-950/50 px-2.5 py-1 text-xs text-red-400 hover:bg-red-900/80 hover:text-red-200"
												>
													Delete
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</div>
				</div>
			}

			<!-- TAB 4: CONSOLE & LOGS -->
			if d.ActiveTab == "console" {
				<div
					class="space-y-4"
					data-effect={ fmt.Sprintf("@get('/api/valheim/%d/logs/stream')", d.Number) }
				>
					<div class="flex items-center justify-between">
						<div>
							<h2 class="text-base font-semibold text-zinc-100">Live Console & Logs</h2>
							<p class="mt-0.5 text-xs text-zinc-400">Real-time pod logs stream from Valheim container</p>
						</div>
					</div>

					<!-- Terminal log box -->
					<div
						id="console-logs"
						class="h-96 w-full overflow-y-auto rounded-xl border border-zinc-800 bg-zinc-950 p-4 font-mono text-xs text-zinc-300 leading-relaxed space-y-1 shadow-inner"
					>
						<p class="text-zinc-500">Connected to Valheim container logs...</p>
					</div>
				</div>
			}

			<!-- TAB 5: BACKUPS -->
			if d.ActiveTab == "backups" {
				<div
					class="space-y-6"
					data-signals="{restoreModalOpen: false, selectedArchive: '', newWorldName: '', newWorldTier: 'medium'}"
				>
					<div class="flex items-center justify-between">
						<div>
							<h2 class="text-base font-semibold text-zinc-100">World Backups (NAS)</h2>
							<p class="mt-0.5 text-xs text-zinc-400">Backups are stored on the redundant TrueNAS NFS share. Daily auto-backup runs at 04:00 AM UTC.</p>
						</div>
						<button
							type="button"
							data-on:click={ fmt.Sprintf("@post('/api/valheim/%d/backups/create')", d.Number) }
							class="rounded-lg bg-zinc-100 px-3.5 py-1.5 text-xs font-semibold text-zinc-950 hover:bg-white shadow-sm"
						>
							+ Create Backup Now
						</button>
					</div>

					<!-- Backups Table -->
					<div class="rounded-xl border border-zinc-800 bg-zinc-900/80 overflow-hidden">
						if len(d.Backups) == 0 {
							<div class="p-8 text-center text-xs text-zinc-500">
								No backups created for this instance yet. Snapshots will appear here after manual creation or daily schedule.
							</div>
						} else {
							<table class="w-full text-left text-xs">
								<thead class="border-b border-zinc-800 bg-zinc-950/60 text-zinc-400">
									<tr>
										<th class="px-4 py-2.5 font-medium">Backup File</th>
										<th class="px-4 py-2.5 font-medium">Size</th>
										<th class="px-4 py-2.5 font-medium">Date</th>
										<th class="px-4 py-2.5 font-medium text-right">Actions</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-zinc-800/60">
									for _, b := range d.Backups {
										<tr class="hover:bg-zinc-800/30">
											<td class="px-4 py-2.5 font-mono text-zinc-200">{ b.Name }</td>
											<td class="px-4 py-2.5 text-zinc-400">{ fmt.Sprintf("%.1f MB", float64(b.SizeBytes)/(1024*1024)) }</td>
											<td class="px-4 py-2.5 text-zinc-400">{ b.CreatedAt }</td>
											<td class="px-4 py-2.5 text-right space-x-2">
												if d.State == "running" {
													<button
														type="button"
														disabled
														title="Stop server first to restore in-place"
														class="cursor-not-allowed rounded bg-zinc-800/50 px-2 py-1 text-[11px] text-zinc-500"
													>
														Restore In-Place
													</button>
												} else {
													<button
														type="button"
														data-on:click={ fmt.Sprintf("if (confirm('Restore %s in-place over current Valheim world data?')) @post('/api/valheim/%d/backups/restore-inplace?archive=%s', {payload: {archive: '%s'}})", b.Name, d.Number, b.Name, b.Name) }
														class="rounded bg-amber-950/50 border border-amber-800/60 px-2 py-1 text-[11px] font-medium text-amber-200 hover:bg-amber-900/60"
													>
														Restore In-Place
													</button>
												}

												<a
													href={ templ.SafeURL(fmt.Sprintf("/api/valheim/%d/backups/download?f=%s", d.Number, b.Name)) }
													class="inline-block rounded bg-zinc-800 px-2 py-1 text-[11px] text-zinc-300 hover:bg-zinc-700 hover:text-white"
												>
													Download
												</a>

												<button
													type="button"
													data-on:click={ fmt.Sprintf("if (confirm('Permanently delete backup %s from NAS?')) @post('/api/valheim/%d/backups/delete?file=%s', {payload: {file: '%s'}})", b.Name, d.Number, b.Name, b.Name) }
													class="rounded px-1.5 py-1 text-[11px] text-red-400 hover:bg-red-950/40 hover:text-red-300"
												>
													Delete
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</div>
				</div>
			}

			<!-- TAB 6: SETTINGS -->
			if d.ActiveTab == "settings" {
				<div class="rounded-2xl border border-zinc-800 bg-zinc-900/80 p-6 shadow-sm max-w-xl">
					<h2 class="text-base font-semibold text-zinc-100">Instance Settings</h2>
					<p class="mt-0.5 text-xs text-zinc-400">Update configuration parameters for this Valheim server.</p>

					<form
						class="mt-6 space-y-4"
						data-on:submit__prevent={ fmt.Sprintf("@post('/api/valheim/%d/settings', {contentType: 'form'})", d.Number) }
					>
						<div>
							<label class="block text-xs font-medium text-zinc-300">Server / World Name</label>
							<input
								type="text"
								name="name"
								value={ d.Name }
								required
								class="mt-1 w-full rounded-xl border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-zinc-100 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none"
							/>
						</div>

						<div>
							<label class="block text-xs font-medium text-zinc-300">Server Password (minimum 5 characters, or leave blank for public)</label>
							<input
								type="text"
								name="password"
								value={ d.Password }
								placeholder="e.g. secret123"
								class="mt-1 w-full rounded-xl border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-zinc-100 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none"
							/>
						</div>

						<div>
							<label class="block text-xs font-medium text-zinc-300">Resource Tier</label>
							<select
								name="tier"
								class="mt-1 w-full rounded-xl border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-zinc-100 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none"
							>
								if d.Tier == "small" {
									<option value="small" selected>Small (4 GiB) - Up to 4 players</option>
								} else {
									<option value="small">Small (4 GiB) - Up to 4 players</option>
								}
								if d.Tier == "medium" {
									<option value="medium" selected>Medium (6 GiB) - Standard (Recommended)</option>
								} else {
									<option value="medium">Medium (6 GiB) - Standard (Recommended)</option>
								}
								if d.Tier == "large" {
									<option value="large" selected>Large (8 GiB) - Heavy modded</option>
								} else {
									<option value="large">Large (8 GiB) - Heavy modded</option>
								}
							</select>
						</div>

						<div class="pt-4 flex justify-end">
							<button
								type="submit"
								class="rounded-xl bg-zinc-100 px-5 py-2 text-xs font-semibold text-zinc-950 hover:bg-white"
							>
								Save Changes
							</button>
						</div>
					</form>
				</div>
			}
		</div>
	}
}
