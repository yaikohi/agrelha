package pages

templ cardActions(a CardActionsUI) {
	<div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-edge pt-4">
		<div class="flex flex-wrap items-center gap-1.5">
			for _, act := range a.Lifecycle {
				<button
					type="button"
					data-indicator={ actionIndicator(act.Label) }
					data-attr:disabled={ "$" + actionIndicator(act.Label) }
					data-on:click={ toastActionClick(act.Script) }
					class={ "rounded-control px-2.5 py-1 text-xs font-medium " + actionStyle(act.Kind) }
				>
					<span data-show={ "!" + "$" + actionIndicator(act.Label) }>{ act.Label }</span>
					<span class="inline-flex items-center gap-1.5" data-show={ "$" + actionIndicator(act.Label) } style="display:none;">
						<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>
						<span>{ inFlightVerb(act.Label) }</span>
					</span>
				</button>
			}
			for _, act := range a.Special {
				if act.Href != "" {
					<a
						href={ templ.SafeURL(act.Href) }
						title="Only available for this game"
						class={ "rounded-control px-2.5 py-1 text-xs font-medium " + actionStyle(act.Kind) }
					>{ act.Label }</a>
				} else {
					<button
						type="button"
						data-indicator={ actionIndicator(act.Label) }
						data-attr:disabled={ "$" + actionIndicator(act.Label) }
						data-on:click={ toastActionClick(act.Script) }
						title="Only available for this game"
						class={ "rounded-control px-2.5 py-1 text-xs font-medium " + actionStyle(act.Kind) }
					>
						<span data-show={ "!" + "$" + actionIndicator(act.Label) }>{ act.Label }</span>
						<span class="inline-flex items-center gap-1.5" data-show={ "$" + actionIndicator(act.Label) } style="display:none;">
							<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>
							<span>{ inFlightVerb(act.Label) }</span>
						</span>
					</button>
				}
			}
			if len(a.Links) > 0 {
				<span class="mx-1 h-4 w-px bg-surface-raised"></span>
				for _, l := range a.Links {
					<a
						href={ templ.SafeURL(l.Href) }
						class={ "rounded-control px-2.5 py-1 text-xs " + actionStyle(l.Kind) }
					>{ l.Label }</a>
				}
			}
		</div>
		if a.Manager.Href != "" {
			<a
				href={ templ.SafeURL(a.Manager.Href) }
				class="rounded-control bg-accent px-4 py-1.5 text-xs font-semibold text-accent-ink transition hover:bg-ink"
			>{ a.Manager.Label }</a>
		}
	</div>
}
