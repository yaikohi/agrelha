package pages

import "fmt"

type AccountGrantUI struct {
	Target string
	Label  string
}

type AccountUI struct {
	Subject   string
	Email     string
	Name      string
	Label     string
	Admin     bool
	FirstSeen string
	LastSeen  string
	Grants    []AccountGrantUI
}

type InstanceOptionUI struct {
	Target string
	Label  string
}

templ Accounts(accounts []AccountUI, instances []InstanceOptionUI, registryReady bool, registryNote string, flashKind, flashMsg string) {
	@Layout("Accounts") {
		@nav(true)
		<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
			<div>
				<h1 class="text-2xl font-semibold text-zinc-100">Accounts & Grants</h1>
				<p class="mt-1 text-xs text-zinc-400">
					Who can sign in to agrelha, and which worlds each of them may operate.
				</p>
			</div>
		</div>
		@flashBanner(flashKind, flashMsg)

		if !registryReady {
			<div class="mb-6 rounded-xl border border-amber-800/60 bg-amber-950/30 p-4 text-xs text-amber-200">
				<p class="font-semibold">Granting is unavailable.</p>
				<p class="mt-1 text-amber-300/80">{ registryNote }</p>
			</div>
		}

		<div class="mb-8 rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
			<div class="mb-4 border-b border-zinc-800/80 pb-3">
				<h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-200">Accounts</h2>
				<p class="text-xs text-zinc-400">
					An account appears here the first time it signs in. You cannot grant access to someone who has never signed in.
				</p>
			</div>

			if len(accounts) == 0 {
				<div class="rounded-lg border border-zinc-800/60 bg-zinc-950/40 p-4 text-center text-xs text-zinc-500">
					Nobody has signed in yet. Ask them to open agrelha and sign in once, then grant them a world here.
				</div>
			} else {
				<div class="space-y-4">
					for _, a := range accounts {
						<div class="rounded-lg border border-zinc-800/80 bg-zinc-950/50 p-4">
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div>
									<div class="flex items-center gap-2">
										<span class="text-sm font-medium text-zinc-100">{ a.Label }</span>
										if a.Admin {
											<span class="rounded-full border border-emerald-700/60 bg-emerald-900/40 px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-emerald-300">
												Admin
											</span>
										}
									</div>
									<p class="mt-1 font-mono text-[11px] text-zinc-500">{ a.Subject }</p>
									<p class="mt-1 text-[11px] text-zinc-500">
										{ fmt.Sprintf("first seen %s · last seen %s", a.FirstSeen, a.LastSeen) }
									</p>
								</div>
								<form method="POST" action="/accounts/sessions/revoke">
									<input type="hidden" name="subject" value={ a.Subject }/>
									<button
										type="submit"
										class="rounded-lg border border-zinc-800 bg-zinc-900/80 px-3 py-1.5 text-xs text-zinc-400 hover:border-red-800 hover:text-red-300 transition"
									>
										Sign out everywhere
									</button>
								</form>
							</div>

							<div class="mt-4 border-t border-zinc-800/60 pt-3">
								if a.Admin {
									<p class="text-xs text-zinc-500">Administrators can operate every world; per-world grants are not needed.</p>
								} else if len(a.Grants) == 0 {
									<p class="text-xs text-zinc-500">No worlds granted.</p>
								} else {
									<div class="flex flex-wrap gap-2">
										for _, g := range a.Grants {
											<form method="POST" action="/accounts/revoke" class="inline-flex">
												<input type="hidden" name="subject" value={ a.Subject }/>
												<input type="hidden" name="target" value={ g.Target }/>
												<button
													type="submit"
													title="Revoke this grant"
													class="inline-flex items-center gap-1.5 rounded-full border border-zinc-700/60 bg-zinc-800/60 px-2.5 py-1 text-xs text-zinc-300 hover:border-red-800 hover:text-red-300 transition"
												>
													<span>{ g.Label }</span>
													<span class="text-zinc-500">&times;</span>
												</button>
											</form>
										}
									</div>
								}

								if registryReady && !a.Admin {
									<form method="POST" action="/accounts/grant" class="mt-3 flex flex-wrap items-center gap-2">
										<input type="hidden" name="subject" value={ a.Subject }/>
										<select
											name="target"
											class="rounded-lg border border-zinc-800 bg-zinc-950/70 px-2.5 py-1.5 text-xs text-zinc-200 focus:border-emerald-700 focus:outline-none"
										>
											for _, o := range instances {
												<option value={ o.Target }>{ o.Label }</option>
											}
										</select>
										<button
											type="submit"
											class="rounded-lg border border-emerald-800/60 bg-emerald-900/40 px-3 py-1.5 text-xs font-medium text-emerald-200 hover:border-emerald-600 hover:text-emerald-100 transition"
										>
											Grant access
										</button>
									</form>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}
