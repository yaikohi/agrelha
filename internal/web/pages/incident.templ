package pages

import "fmt"

templ IncidentPanel(in *IncidentUI) {
	if in != nil {
		<div class="-mx-6 border-y border-seam px-6 py-5">
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
				<div class="min-w-0">
					<p class="font-pixel text-[11px] text-danger">Last failure</p>
					<p class="mt-1 font-display text-lg font-semibold text-ink">{ in.Summary }</p>
					<p class="mt-1 font-pixel text-[11px] text-ink-faint">{ in.When }</p>
				</div>
				<div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
					@incidentBadges(*in)
					@dismissIncidentButton(*in)
				</div>
			</div>
			@incidentLog(in.LogTail)
			<a
				href={ templ.SafeURL(fmt.Sprintf("/%s/%d/crashes", in.GamePath, in.Number)) }
				class="focus-accent mt-3 inline-block font-pixel text-[11px] text-ink-muted underline underline-offset-4 transition-colors hover:text-accent"
			>
				See all failures
			</a>
		</div>
	}
}
