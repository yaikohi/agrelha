package pages

import "agrelha/internal/domain"

templ hearthNav(isAdmin, signedIn bool, grafanaURL string) {
	<header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
		<a href="/" class="focus-accent font-display text-3xl font-semibold tracking-tight text-ink transition-colors hover:text-accent">agrelha</a>
		<div class="flex items-center gap-4 font-pixel text-xs">
			if grafanaURL != "" {
				<a href={ templ.SafeURL(grafanaURL) } target="_blank" rel="noopener noreferrer" class="focus-accent text-ink-muted transition-colors hover:text-accent">Grafana</a>
			}
			if signedIn {
				<a href="/auth/logout" class="focus-accent text-ink-muted transition-colors hover:text-accent">Sign out</a>
			} else {
				<a href="/auth/login" class="focus-accent text-ink-muted transition-colors hover:text-accent">Sign in</a>
			}
		</div>
		if signedIn {
			<nav class="flex w-full flex-wrap items-center gap-x-5 gap-y-2 font-pixel text-xs">
				for _, p := range domain.Profiles() {
					<a href={ templ.SafeURL("/" + string(p.ID)) } class="focus-accent inline-flex items-baseline gap-1.5 text-ink-muted transition-colors hover:text-accent">
						{ hearthNavLabel(p.Display.Name) }
						if p.Capabilities.Mods {
							<span
								data-show={ "$" + p.Prefix + "_updates > 0" }
								class="text-accent"
								title="Mod updates available"
								data-text={ "$" + p.Prefix + "_updates" }
							></span>
						}
					</a>
				}
				if isAdmin {
					<span class="h-3 w-px bg-edge" aria-hidden="true"></span>
					for _, l := range adminNavLinks() {
						<a href={ templ.SafeURL(l.Href) } class="focus-accent text-ink-muted transition-colors hover:text-accent">{ l.Label }</a>
					}
				}
			</nav>
		}
	</header>
}
