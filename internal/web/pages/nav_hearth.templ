package pages

import "agrelha/internal/domain"

templ hearthNav(current string, isAdmin, signedIn bool, grafanaURL string) {
	<header class="border-b border-seam pb-5">
		<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
			<a href="/" class="focus-accent font-display text-3xl font-semibold tracking-tight text-ink transition-colors hover:text-accent">agrelha</a>
			<div class="flex items-center gap-5 font-pixel text-xs">
				if grafanaURL != "" {
					<a href={ templ.SafeURL(grafanaURL) } target="_blank" rel="noopener noreferrer" class="focus-accent text-ink-faint transition-colors hover:text-accent">grafana</a>
				}
				if signedIn {
					<a href="/auth/logout" class="focus-accent text-ink-faint transition-colors hover:text-accent">sign out</a>
				} else {
					<a href="/auth/login" class="focus-accent text-ink-muted transition-colors hover:text-accent">sign in</a>
				}
			</div>
		</div>
		if signedIn {
			<nav class="mt-5 flex flex-wrap items-end justify-between gap-x-10 gap-y-4 font-pixel text-xs">
				<div class="flex flex-wrap items-end gap-x-5 gap-y-3">
					for _, p := range domain.Profiles() {
						<a href={ templ.SafeURL("/" + string(p.ID)) } class={ hearthNavClass(current == string(p.ID)) }>
							{ hearthNavLabel(p.Display.Name) }
							if p.Capabilities.Mods {
								<span
									data-show={ "$" + p.Prefix + "_updates > 0" }
									class="text-accent"
									title="Mod updates available"
									data-text={ "'(' + $" + p.Prefix + "_updates + ')'" }
								></span>
							}
						</a>
					}
				</div>
				if isAdmin {
					<div class="flex flex-wrap items-end gap-x-5 gap-y-3">
						for _, l := range adminNavLinks() {
							<a href={ templ.SafeURL(l.Href) } class={ hearthNavClass(current == l.Label) }>{ l.Label }</a>
						}
					</div>
				}
			</nav>
		}
	</header>
}
