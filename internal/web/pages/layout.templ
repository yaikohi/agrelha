package pages

import (
	"fmt"

	"agrelha/internal/platform/build"
	"agrelha/internal/web/components"
	"agrelha/internal/web/shared"
)

// Base HTML shell. Datastar drives interactivity over SSE (vendored at
// /assets/js/datastar.js — see Taskfile `assets:datastar`). Tailwind output at
// /assets/css/output.css.
templ Layout(title string) {
	@layoutShell(title, "bg-surface font-display text-ink", "mx-auto max-w-5xl overflow-x-hidden px-6 py-8", false) {
		{ children... }
	}
}

templ LayoutHearth(title string) {
	@layoutShell(title, "bg-surface font-display text-ink", "mx-auto max-w-5xl overflow-x-hidden px-6 py-8", true) {
		{ children... }
	}
}

templ layoutShell(title, bodyClass, mainClass string, hearth bool) {
	<!DOCTYPE html>
	<html lang="en" class="h-full" data-theme={ shared.ThemeOf(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · agrelha</title>
			<script>
				(() => {
					const KEY = "agrelha-theme";
					const COOKIE = "agrelha_theme";
					const YEAR = 31536000;

					const normalize = (value) => (value === "light" ? "light" : "dark");
					const hasCookie = () =>
						document.cookie.split("; ").some((pair) => pair.startsWith(COOKIE + "="));

					const read = () => {
						try {
							return localStorage.getItem(KEY);
						} catch {
							return null;
						}
					};

					const stored = read();
					let activeTheme;
					if (stored === "light" || stored === "dark") {
						activeTheme = stored;
					} else if (!hasCookie()) {
						activeTheme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
					}
					if (activeTheme) {
						document.documentElement.setAttribute("data-theme", activeTheme);
						if (!hasCookie()) {
							const secure = location.protocol === "https:" ? ";secure" : "";
							document.cookie = COOKIE + "=" + activeTheme + ";path=/;max-age=" + YEAR + ";samesite=lax" + secure;
						}
					}

					window.agrelhaTheme = (next) => {
						const theme = normalize(next);
						document.documentElement.setAttribute("data-theme", theme);
						try {
							localStorage.setItem(KEY, theme);
						} catch {}
						const secure = location.protocol === "https:" ? ";secure" : "";
						document.cookie = COOKIE + "=" + theme + ";path=/;max-age=" + YEAR + ";samesite=lax" + secure;
						return theme;
					};
				})();
			</script>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Fraunces-Variable.woff2" crossorigin/>
			<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/DepartureMono-Regular.woff2" crossorigin/>
			<script type="module" src="/assets/js/datastar.js"></script>
			<script>
				window.agrelhaCopy = (text) => {
					if (navigator.clipboard && window.isSecureContext) {
						return navigator.clipboard.writeText(text);
					}
					const field = document.createElement("textarea");
					field.value = text;
					field.setAttribute("readonly", "");
					field.style.position = "fixed";
					field.style.opacity = "0";
					document.body.appendChild(field);
					field.select();
					try {
						return document.execCommand("copy")
							? Promise.resolve()
							: Promise.reject(new Error("copy command rejected"));
					} finally {
						field.remove();
					}
				};
			</script>
		</head>
		<body
			class={ "h-full antialiased " + bodyClass }
			data-signals={ fmt.Sprintf("{players:'—',cpu:'—',mem:'—',uptime:'—',state:'unknown',online:false,backup:'—',backupinfo:'',updates:0,valheim_updates:0,mc_updates:0,selected:{},toast:'',toastkind:'',mc_players:'—',mc_cpu:'—',mc_mem:'—',mc_uptime:'—',mc_state:'unknown',theme:'%s'}", shared.ThemeOf(ctx)) }
			data-effect="@get('/sse')"
		>
			<script>
				window.addEventListener("pageshow", (event) => {
					if (event.persisted) {
						window.location.reload();
					}
				});
			</script>
			<main class={ mainClass }>
				{ children... }
			</main>
			if !hearth {
				@siteFooter()
			}
			@components.Toast()
			<script>
				(() => {
					const MAX_LINES = 500;
					const BOTTOM_SLACK = 24;

					for (const pane of document.querySelectorAll("[data-log-pane]")) {
						const wrap = pane.closest("[data-log-pane-wrap]");
						const status = wrap?.querySelector("[data-log-status]");
						const jump = wrap?.querySelector("[data-log-jump]");
						let follow = true;

						const atBottom = () =>
							pane.scrollHeight - pane.scrollTop - pane.clientHeight < BOTTOM_SLACK;
						const toBottom = () => {
							pane.scrollTop = pane.scrollHeight;
						};

						const render = () => {
							if (status) {
								status.textContent = follow ? "Following" : "Paused — scrolled up";
							}
							jump?.classList.toggle("hidden", follow);
							jump?.classList.toggle("inline-flex", !follow);
						};

						const trim = () => {
							if (pane.childElementCount <= MAX_LINES) {
								return;
							}
							const before = pane.scrollHeight;
							while (pane.childElementCount > MAX_LINES) {
								pane.firstElementChild.remove();
							}
							if (!follow) {
								pane.scrollTop = Math.max(0, pane.scrollTop - (before - pane.scrollHeight));
							}
						};

						pane.addEventListener("scroll", () => {
							const bottom = atBottom();
							if (bottom !== follow) {
								follow = bottom;
								render();
							}
						});

						jump?.addEventListener("click", () => {
							follow = true;
							toBottom();
							render();
						});

						new MutationObserver(() => {
							trim();
							if (follow) {
								toBottom();
							}
						}).observe(pane, { childList: true });

						render();
						toBottom();
					}
				})();
			</script>
		</body>
	</html>
}

// AGPL section 13: anyone running a modified agrelha over a network owes its
// users the corresponding source. SOURCE_URL lets a fork point at its own.
templ siteFooter() {
	<footer class="mx-auto max-w-5xl px-6 pb-8 font-pixel text-xs text-ink-faint">
		<div class="flex items-center justify-between border-t border-seam pt-4">
			<span>agrelha { build.Version } · AGPL-3.0-only</span>
			<a href={ templ.URL(build.SourceURL) } rel="noopener" target="_blank" class="focus-accent transition-colors hover:text-ink-muted">Source</a>
		</div>
	</footer>
}
