package pages

import "agrelha/internal/web/components"

type RequestUI struct {
	ID string
	Requester string
	Game string
	Name string
	Tier string
	Mods int
	Created string
	Status string
	Note string
	Decided string
	DecidedBy string
	Number int
}

templ Requests(pending []RequestUI, decided []RequestUI, flashKind, flashMsg string) {
	@Layout("World requests") {
		@components.Nav(components.NavProps{Current: "requests", IsAdmin: true, SignedIn: true})
		<div class="mb-6">
			<h1 class="text-2xl font-semibold text-ink">World requests</h1>
			<p class="mt-1 text-xs text-ink-muted">
				An account that already runs a world must ask before creating another. Approving one creates the world and grants them access to it.
			</p>
		</div>
		@flashBanner(flashKind, flashMsg)

		<div class="mb-8 rounded-control border border-edge bg-surface-raised p-5 ">
			<div class="mb-4 border-b border-edge pb-3">
				<h2 class="text-sm font-semibold uppercase tracking-wider text-ink">
					Awaiting your decision
					if len(pending) > 0 {
						<span class="ml-2 rounded-full border border-accent px-2 py-0.5 text-[10px] font-medium text-accent">
							{ len(pending) }
						</span>
					}
				</h2>
			</div>

			if len(pending) == 0 {
				<div class="rounded-control border border-edge bg-seam p-4 text-center text-xs text-ink-faint">
					Nothing waiting.
				</div>
			} else {
				<div class="space-y-3">
					for _, r := range pending {
						<div class="rounded-control border border-edge bg-seam/50 p-4">
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div>
									<div class="flex items-center gap-2">
										<span class="rounded-full border border-edge bg-surface-raised px-2 py-0.5 text-[10px] uppercase tracking-wide text-ink">
											{ r.Game }
										</span>
										<span class="text-sm font-medium text-ink">{ r.Name }</span>
									</div>
									<p class="mt-1 text-[11px] text-ink-faint">
										requested by { r.Requester } on { r.Created }
									</p>
									<p class="mt-1 text-[11px] text-ink-faint">
										tier { r.Tier } &middot; { r.Mods } mods
									</p>
								</div>
								<div class="flex flex-wrap items-center gap-2">
									<form method="POST" action="/requests/approve">
										<input type="hidden" name="id" value={ r.ID }/>
										<button
											type="submit"
											class="rounded-control border border-accent px-3 py-1.5 text-xs font-medium text-accent hover:bg-accent hover:text-accent-ink transition"
										>
											Approve &amp; create
										</button>
									</form>
									<form method="POST" action="/requests/deny" class="flex items-center gap-2">
										<input type="hidden" name="id" value={ r.ID }/>
										<input
											type="text"
											name="note"
											placeholder="reason (optional)"
											class="w-44 rounded-control border border-edge bg-seam/70 px-2.5 py-1.5 text-xs text-ink placeholder:text-ink-faint focus-accent "
										/>
										<button
											type="submit"
											class="rounded-control border border-edge bg-surface-raised px-3 py-1.5 text-xs text-ink-muted hover:text-danger hover:text-danger transition"
										>
											Deny
										</button>
									</form>
								</div>
							</div>
						</div>
					}
				</div>
			}
		</div>

		if len(decided) > 0 {
			<div class="rounded-control border border-edge bg-surface-raised p-5 ">
				<div class="mb-4 border-b border-edge pb-3">
					<h2 class="text-sm font-semibold uppercase tracking-wider text-ink">Already decided</h2>
				</div>
				<div class="divide-y divide-seam overflow-hidden rounded-control border border-edge bg-seam/50">
					for _, r := range decided {
						<div class="flex flex-wrap items-center justify-between gap-2 p-3 text-xs">
							<div>
								<span class="text-ink">{ r.Game } &middot; { r.Name }</span>
								<span class="ml-2 text-ink-faint">{ r.Requester }</span>
								if r.Note != "" {
									<p class="mt-1 text-[11px] text-ink-faint">{ r.Note }</p>
								}
							</div>
							<div class="flex items-center gap-3">
								if r.Status == "approved" {
									<span class="rounded-full border border-accent px-2 py-0.5 text-[10px] text-accent">approved</span>
								} else {
									<span class="rounded-full border border-edge bg-surface-raised px-2 py-0.5 text-[10px] text-ink-muted">denied</span>
								}
								<span class="text-[11px] text-ink-faint">{ r.Decided }</span>
							</div>
						</div>
					}
				</div>
			</div>
		}
	}
}
