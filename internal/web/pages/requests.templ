package pages

type RequestUI struct {
	ID        string
	Requester string
	Game      string
	Name      string
	Tier      string
	Mods      int
	Created   string
	Status    string
	Note      string
	Decided   string
	DecidedBy string
	Number    int
}

templ Requests(pending []RequestUI, decided []RequestUI, flashKind, flashMsg string) {
	@Layout("World requests") {
		@nav(true)
		<div class="mb-6">
			<h1 class="text-2xl font-semibold text-zinc-100">World requests</h1>
			<p class="mt-1 text-xs text-zinc-400">
				An account that already runs a world must ask before creating another. Approving one creates the world and grants them access to it.
			</p>
		</div>
		@flashBanner(flashKind, flashMsg)

		<div class="mb-8 rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
			<div class="mb-4 border-b border-zinc-800/80 pb-3">
				<h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-200">
					Awaiting your decision
					if len(pending) > 0 {
						<span class="ml-2 rounded-full border border-amber-700/60 bg-amber-900/40 px-2 py-0.5 text-[10px] font-medium text-amber-300">
							{ len(pending) }
						</span>
					}
				</h2>
			</div>

			if len(pending) == 0 {
				<div class="rounded-lg border border-zinc-800/60 bg-zinc-950/40 p-4 text-center text-xs text-zinc-500">
					Nothing waiting.
				</div>
			} else {
				<div class="space-y-3">
					for _, r := range pending {
						<div class="rounded-lg border border-zinc-800/80 bg-zinc-950/50 p-4">
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div>
									<div class="flex items-center gap-2">
										<span class="rounded-full border border-zinc-700/60 bg-zinc-800/60 px-2 py-0.5 text-[10px] uppercase tracking-wide text-zinc-300">
											{ r.Game }
										</span>
										<span class="text-sm font-medium text-zinc-100">{ r.Name }</span>
									</div>
									<p class="mt-1 text-[11px] text-zinc-500">
										requested by { r.Requester } on { r.Created }
									</p>
									<p class="mt-1 text-[11px] text-zinc-500">
										tier { r.Tier } &middot; { r.Mods } mods
									</p>
								</div>
								<div class="flex flex-wrap items-center gap-2">
									<form method="POST" action="/requests/approve">
										<input type="hidden" name="id" value={ r.ID }/>
										<button
											type="submit"
											class="rounded-lg border border-emerald-800/60 bg-emerald-900/40 px-3 py-1.5 text-xs font-medium text-emerald-200 hover:border-emerald-600 hover:text-emerald-100 transition"
										>
											Approve &amp; create
										</button>
									</form>
									<form method="POST" action="/requests/deny" class="flex items-center gap-2">
										<input type="hidden" name="id" value={ r.ID }/>
										<input
											type="text"
											name="note"
											placeholder="reason (optional)"
											class="w-44 rounded-lg border border-zinc-800 bg-zinc-950/70 px-2.5 py-1.5 text-xs text-zinc-200 placeholder:text-zinc-600 focus:border-zinc-600 focus:outline-none"
										/>
										<button
											type="submit"
											class="rounded-lg border border-zinc-800 bg-zinc-900/80 px-3 py-1.5 text-xs text-zinc-400 hover:border-red-800 hover:text-red-300 transition"
										>
											Deny
										</button>
									</form>
								</div>
							</div>
						</div>
					}
				</div>
			}
		</div>

		if len(decided) > 0 {
			<div class="rounded-xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-sm">
				<div class="mb-4 border-b border-zinc-800/80 pb-3">
					<h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-200">Already decided</h2>
				</div>
				<div class="divide-y divide-zinc-800/80 overflow-hidden rounded-lg border border-zinc-800/80 bg-zinc-950/50">
					for _, r := range decided {
						<div class="flex flex-wrap items-center justify-between gap-2 p-3 text-xs">
							<div>
								<span class="text-zinc-300">{ r.Game } &middot; { r.Name }</span>
								<span class="ml-2 text-zinc-500">{ r.Requester }</span>
								if r.Note != "" {
									<p class="mt-1 text-[11px] text-zinc-500">{ r.Note }</p>
								}
							</div>
							<div class="flex items-center gap-3">
								if r.Status == "approved" {
									<span class="rounded-full border border-emerald-800/60 bg-emerald-900/30 px-2 py-0.5 text-[10px] text-emerald-300">approved</span>
								} else {
									<span class="rounded-full border border-zinc-700/60 bg-zinc-800/60 px-2 py-0.5 text-[10px] text-zinc-400">denied</span>
								}
								<span class="text-[11px] text-zinc-600">{ r.Decided }</span>
							</div>
						</div>
					}
				</div>
			</div>
		}
	}
}
