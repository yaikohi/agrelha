package pages

import "agrelha/internal/web/components"

templ MinecraftConfigEdit(name, content string, isNew, enabled bool) {
	@Layout("Edit Minecraft Config") {
		@components.Nav(components.NavProps{Current: "minecraft", IsAdmin: true, SignedIn: true})
		<div class="mb-6 flex items-center gap-3">
			<a href="/minecraft/configs" class="text-sm text-ink-muted hover:text-ink">← Minecraft Configs</a>
			<h1 class="text-2xl font-semibold">
				if isNew {
					New Minecraft Config File
				} else {
					<span class="font-pixel text-xl">{ name }</span>
				}
			</h1>
		</div>
		if !enabled {
			<p class="mb-4 rounded text-accent p-3 text-sm text-accent">Declarative plane disabled — set the Codeberg token to save.</p>
		}
		<form method="post" action="/minecraft/configs/save" class="space-y-4">
			if isNew {
				<div>
					<label class="mb-1 block text-xs text-ink-muted">File name (.toml, .json, .yaml, .cfg)</label>
					<input name="file" placeholder="jei-server.ini or mod.toml" class="w-80 rounded bg-surface-raised px-3 py-2 font-pixel text-sm border border-edge focus-accent"/>
				</div>
			} else {
				<input type="hidden" name="file" value={ name }/>
			}
			<div>
				<label class="mb-1 block text-xs text-ink-muted">Contents</label>
				<textarea name="content" spellcheck="false" rows="24" class="w-full rounded border border-edge bg-seam p-3 font-pixel text-xs text-ink">{ content }</textarea>
			</div>
			<div class="flex items-center gap-3">
				<button class="rounded bg-accent text-accent-ink font-semibold px-4 py-2 text-sm hover:bg-ink">Save &amp; apply on restart</button>
				<a href="/minecraft/configs" class="rounded border border-edge px-4 py-2 text-sm hover:bg-surface-raised">Cancel</a>
			</div>
		</form>
		if !isNew {
			<form method="post" action="/minecraft/configs/delete" class="mt-4" onsubmit="return confirm('Delete this config file?')">
				<input type="hidden" name="file" value={ name }/>
				<button class="rounded text-danger px-4 py-2 text-sm hover:text-danger">Delete file</button>
			</form>
		}
	}
}
