package pages

import (
	"fmt"
	"agrelha/internal/web/components"
)

templ ValheimDashboard(instances []InstanceUI, budget BudgetUI) {
	@Layout("Valheim") {
		@nav()
		<div class="space-y-6">
			<!-- Header & Budget bar -->
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<h1 class="text-xl font-bold tracking-tight text-zinc-100">Valheim Instances</h1>
					<p class="mt-0.5 text-xs text-zinc-400">Manage up to 4 dedicated Valheim worlds. Up to 2 can run concurrently.</p>
				</div>
				@components.BudgetBar(components.BudgetBarProps{
					UsedGiB:        budget.UsedGiB,
					TotalBudgetGiB: budget.TotalBudgetGiB,
					RunningCount:   budget.RunningCount,
					MaxRunning:     budget.MaxRunning,
					TotalInstances: budget.TotalInstances,
					MaxInstances:   budget.MaxInstances,
					ActionHref:     "/admins",
					ActionText:     "Access (Admins)",
				})
			</div>

			if len(instances) == 0 {
				@components.EmptyState(components.EmptyStateProps{
					Icon:        "⚔️",
					Title:       "Create your first Valheim world",
					Description: "Spin up a dedicated Valheim server with BepInEx modding support, custom seed, and persistent storage.",
					ActionHref:  "/valheim/create",
					ActionText:  "+ Create New World",
				})
			} else {
				<!-- Instances grid -->
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
					for _, inst := range instances {
						<div class="flex flex-col justify-between rounded-xl border border-zinc-800 bg-zinc-900/80 p-5 shadow-sm">
							<div>
								<!-- Card top: name + number + status -->
								<div class="flex items-start justify-between">
									<div>
										<div class="flex items-center gap-2">
											<span class="font-mono text-xs text-zinc-500">{ fmt.Sprintf("#%02d", inst.Number) }</span>
											<a href={ templ.SafeURL(fmt.Sprintf("/valheim/%d", inst.Number)) } class="text-base font-semibold text-zinc-100 hover:text-zinc-300 transition">
												{ inst.Name } &rarr;
											</a>
										</div>
										<p class="mt-0.5 font-mono text-xs text-zinc-400">{ ConnectAddress(inst.LBIP, 2456) }</p>
									</div>
									<div>
										@components.StatusPill(components.StatusPillProps{State: inst.State})
									</div>
								</div>

								<!-- Badges: Game, Tier, Password, Version -->
								<div class="mt-4 flex flex-wrap gap-1.5">
									<span class="rounded bg-zinc-800 px-2 py-0.5 text-[11px] font-medium text-zinc-300 ring-1 ring-zinc-700/60">Valheim</span>
									<span class="rounded bg-zinc-800 px-2 py-0.5 text-[11px] font-medium text-zinc-300">{ modBadge(inst.Source, "BepInEx") }</span>

									<span class="rounded bg-zinc-800 px-2 py-0.5 text-[11px] text-zinc-400">
										{ fmt.Sprintf("%s (%d GiB)", inst.Tier, inst.MemoryGiB) }
									</span>

									if inst.Password != "" {
										<span class="rounded bg-zinc-800 px-2 py-0.5 text-[11px] font-medium text-zinc-300">
											🔒 Password
										</span>
									}

									if inst.ModUpdates > 0 {
										<a
											href={ templ.SafeURL(fmt.Sprintf("/valheim/%d/mods", inst.Number)) }
											class="rounded bg-amber-950/60 px-2 py-0.5 text-[11px] font-medium text-amber-300 ring-1 ring-amber-800/60 hover:bg-amber-900/60 transition"
											title="Newer versions of installed mods are published on Thunderstore"
										>
											{ fmt.Sprintf("↻ %d mod update(s)", inst.ModUpdates) }
										</a>
									}
								</div>

								if inst.Seed != "" {
									<div class="mt-3 flex items-center gap-1.5 text-xs text-zinc-500">
										<span>Seed:</span>
										<code class="font-mono text-zinc-400">{ inst.Seed }</code>
									</div>
								}
							</div>

							<!-- Actions & Direct Links -->
							<div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-zinc-800/60 pt-3">
								<div class="flex flex-wrap items-center gap-1.5">
									@components.Button(components.ButtonProps{
										Variant: components.VariantSecondary,
										Size:    components.SizeXs,
										Href:    fmt.Sprintf("/valheim/%d/overview", inst.Number),
										Text:    "Manage",
									})
									@components.Button(components.ButtonProps{
										Variant: components.VariantLink,
										Size:    components.SizeXs,
										Href:    fmt.Sprintf("/valheim/%d/configs", inst.Number),
										Text:    "Configs",
									})
									@components.Button(components.ButtonProps{
										Variant: components.VariantLink,
										Size:    components.SizeXs,
										Href:    fmt.Sprintf("/valheim/%d/mods", inst.Number),
										Text:    "Mods",
									})
									@components.Button(components.ButtonProps{
										Variant: components.VariantLink,
										Size:    components.SizeXs,
										Href:    fmt.Sprintf("/valheim/%d/console", inst.Number),
										Text:    "Console",
									})
								</div>

								<div class="flex items-center gap-2">
									if inst.State == "running" {
										@components.Button(components.ButtonProps{
											Variant: components.VariantWarning,
											Size:    components.SizeXs,
											OnClick: fmt.Sprintf("@post('/api/valheim/instances/%d/stop')", inst.Number),
											Text:    "Stop",
										})
									} else {
										if inst.CanStart {
											@components.Button(components.ButtonProps{
												Variant: components.VariantSuccess,
												Size:    components.SizeXs,
												OnClick: fmt.Sprintf("@post('/api/valheim/instances/%d/start')", inst.Number),
												Text:    "Start",
											})
										} else {
											@components.Button(components.ButtonProps{
												Variant:       components.VariantSecondary,
												Size:          components.SizeXs,
												Disabled:      true,
												DisabledTitle: inst.StartBlockedReason,
												Text:          "Start",
											})
										}
									}

									if inst.State != "running" {
										@components.Button(components.ButtonProps{
											Variant: components.VariantDanger,
											Size:    components.SizeXs,
											OnClick: fmt.Sprintf("if (confirm('Delete Valheim instance #%02d (%s)? World data and configurations will be removed.')) @delete('/api/valheim/instances/%d')", inst.Number, inst.Name, inst.Number),
											Text:    "Delete",
										})
									}
								</div>
							</div>
						</div>
					}

					if len(instances) < budget.MaxInstances {
						<!-- "+ New Instance" card -->
						<a
							href="/valheim/create"
							class="flex min-h-[160px] flex-col items-center justify-center rounded-xl border border-dashed border-zinc-800 bg-zinc-900/30 p-6 text-center transition hover:border-zinc-700 hover:bg-zinc-900/60"
						>
							<span class="flex h-10 w-10 items-center justify-center rounded-xl bg-zinc-800 text-lg text-zinc-300">+</span>
							<span class="mt-3 text-sm font-medium text-zinc-300">Create New World</span>
							<span class="mt-0.5 text-xs text-zinc-500">{ fmt.Sprintf("%d slots available", budget.MaxInstances - len(instances)) }</span>
						</a>
					}
				</div>
			}
		</div>
	}
}
