package pages

import "agrelha/internal/domain"

templ HostUnreachableBanner(host domain.Host) {
	<div class="-mx-6 mt-6 border-y border-seam px-6 py-4">
		<p class="font-pixel text-xs text-danger">Host unreachable</p>
		<p class="mt-1 max-w-prose font-display text-sm leading-relaxed text-ink-muted">
			agrelha cannot reach the Host
			if host != "" {
				{ host.String() }
			}
			. Everything below is the last state it saw, not the current one, and lifecycle
			controls stay disabled until the Host answers.
		</p>
	</div>
}
