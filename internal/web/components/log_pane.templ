package components

templ LogPane(id, placeholder string) {
	<div data-log-pane-wrap class="space-y-2">
		<div class="flex items-center justify-end gap-3 font-pixel text-[11px]">
			<span data-log-status class="text-ink-faint">Following</span>
			<button
				type="button"
				data-log-jump
				class="focus-accent hidden items-center rounded-control border border-edge px-2.5 py-1 text-ink-muted transition-colors hover:border-accent hover:text-accent"
			>
				Jump to newest
			</button>
		</div>
		<div
			id={ id }
			data-log-pane
			class="h-96 w-full space-y-1 overflow-y-auto rounded-control border border-seam bg-seam p-4 font-pixel text-[11px] leading-relaxed text-ink-muted"
		>
			<p class="text-ink-faint">{ placeholder }</p>
		</div>
	</div>
}
