package components

templ Toast() {
	<div
		data-show="$toast != ''"
		data-class="{'text-danger border-danger/60': $toastkind == 'err', 'text-ink-muted border-edge': $toastkind == 'loading', 'text-accent border-accent/40': $toastkind == 'ok' || ($toastkind != 'err' && $toastkind != 'loading')}"
		data-effect="if ($toast && $toastkind != 'loading') { setTimeout(() => { if ($toastkind != 'loading') { $toast = '' } }, 4500) }"
		style="display: none;"
		class="fixed bottom-4 left-4 z-30 flex items-center gap-3 rounded-control border bg-surface-raised px-4 py-3 font-pixel text-xs shadow-lg transition-all"
	>
		<span data-show="$toastkind == 'loading'" class="inline-block h-2 w-2 shrink-0 animate-pulse rounded-full bg-accent" style="display: none;"></span>
		<span data-text="$toast"></span>
		<button type="button" data-on:click="$toast = ''" class="focus-accent text-ink-faint transition-colors hover:text-accent">Dismiss</button>
	</div>
}
