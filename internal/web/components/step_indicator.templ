package components

import (
	"fmt"
)

type StepItem struct {
	Number int
	Label  string
}

type StepIndicatorProps struct {
	Signal string // Datastar signal name (default "step")
	Steps  []StepItem
	Class  string
}

func (p StepIndicatorProps) signalName() string {
	if p.Signal != "" {
		return p.Signal
	}
	return "step"
}

templ StepIndicator(props StepIndicatorProps) {
	{{ sig := props.signalName() }}
	<nav aria-label="Progress" class="border-b border-seam pb-5">
		<div class="flex flex-wrap items-center gap-2 sm:gap-3 font-pixel text-xs">
			for i, s := range props.Steps {
				if i > 0 {
					<span class="text-edge select-none">/</span>
				}
				<div
					class="flex items-center gap-2"
					data-class={ fmt.Sprintf("{'text-ink': $%s == %d, 'text-ink-faint': $%s != %d}", sig, s.Number, sig, s.Number) }
				>
					<span
						class="rounded-control border px-2 py-0.5 text-[11px] transition-colors"
						data-class={ fmt.Sprintf("{'border-accent bg-accent text-accent-ink font-semibold': $%s == %d, 'border-edge bg-surface-raised/80 text-ink': $%s > %d, 'border-edge/60 bg-surface/40 text-ink-faint': $%s < %d}", sig, s.Number, sig, s.Number, sig, s.Number) }
					>
						{ fmt.Sprintf("%02d", s.Number) }
					</span>
					<span>{ s.Label }</span>
				</div>
			}
		</div>
	</nav>
}
