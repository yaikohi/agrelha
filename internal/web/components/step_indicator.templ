package components

import (
	"fmt"
	"strconv"
)

type StepItem struct {
	Number int
	Label  string
}

type StepIndicatorProps struct {
	Signal string // Datastar signal name (default "step")
	Steps  []StepItem
	Class  string
}

func (p StepIndicatorProps) signalName() string {
	if p.Signal != "" {
		return p.Signal
	}
	return "step"
}

templ StepIndicator(props StepIndicatorProps) {
	{{ sig := props.signalName() }}
	<div class="border-b border-seam pb-5">
		<div class="flex items-center justify-between text-xs font-medium">
			for i, s := range props.Steps {
				if i > 0 {
					<div class="h-px flex-1 max-w-[3.5rem] bg-edge mx-2"></div>
				}
				<div
					class="flex items-center gap-2"
					data-class={ fmt.Sprintf("{'text-ink': $%s == %d, 'text-ink-faint': $%s != %d}", sig, s.Number, sig, s.Number) }
				>
					<span
						class="flex h-6 w-6 items-center justify-center rounded-full text-xs"
						data-class={ fmt.Sprintf("{'bg-accent text-accent-ink': $%s == %d, 'bg-surface-raised text-ink-faint': $%s != %d}", sig, s.Number, sig, s.Number) }
					>
						{ strconv.Itoa(s.Number) }
					</span>
					<span>{ s.Label }</span>
				</div>
			}
		</div>
	</div>
}
