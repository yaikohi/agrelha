package components

import (
	"strconv"
	"strings"
)

type InputProps struct {
	Type        string // text, password, file, number, etc. Default "text"
	Name        string
	Value       string
	Placeholder string
	Required    bool
	Disabled    bool
	ReadOnly    bool
	Bind        string // Evaluated by Datastar (data-bind)
	OnKeyDown   string // Evaluated by Datastar (data-on:keydown)
	OnChange    string // Evaluated by Datastar (data-on:change)
	Label       string
	HelperText  string
	ErrorText   string
	Class       string
	ID          string
	Mono        bool
}

func (p InputProps) inputClasses() string {
	base := "w-full rounded-xl border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-zinc-100 placeholder-zinc-500 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none transition"
	if p.Mono {
		base += " font-mono"
	}
	if p.Disabled {
		base += " cursor-not-allowed opacity-60 bg-zinc-900 border-zinc-800 text-zinc-400"
	}
	if p.Class != "" {
		base = strings.Join([]string{base, p.Class}, " ")
	}
	return base
}

templ Input(props InputProps) {
	<div class="space-y-1">
		if props.Label != "" {
			<label class="block text-xs font-medium text-zinc-300">
				{ props.Label }
				if props.Required {
					<span class="text-red-400 ml-0.5">*</span>
				}
			</label>
		}
		<input
			if props.ID != "" {
				id={ props.ID }
			}
			if props.Type != "" {
				type={ props.Type }
			} else {
				type="text"
			}
			if props.Name != "" {
				name={ props.Name }
			}
			if props.Value != "" {
				value={ props.Value }
			}
			if props.Placeholder != "" {
				placeholder={ props.Placeholder }
			}
			if props.Required {
				required
			}
			if props.Disabled {
				disabled
			}
			if props.ReadOnly {
				readonly
			}
			if props.Bind != "" {
				data-bind={ props.Bind }
			}
			if props.OnKeyDown != "" {
				data-on:keydown={ props.OnKeyDown }
			}
			if props.OnChange != "" {
				data-on:change={ props.OnChange }
			}
			class={ props.inputClasses() }
		/>
		if props.HelperText != "" {
			<p class="text-[11px] text-zinc-500 leading-relaxed">{ props.HelperText }</p>
		}
		if props.ErrorText != "" {
			<p class="text-xs text-red-400">{ props.ErrorText }</p>
		}
	</div>
}

type TextareaProps struct {
	Name        string
	Value       string
	Placeholder string
	Rows        int
	Required    bool
	Disabled    bool
	ReadOnly    bool
	Bind        string
	OnKeyDown   string
	Label       string
	HelperText  string
	ErrorText   string
	Class       string
	ID          string
	Mono        bool
	Spellcheck  bool
}

func (p TextareaProps) textareaClasses() string {
	base := "w-full rounded-xl border border-zinc-700 bg-zinc-800 p-3 text-sm text-zinc-100 placeholder-zinc-500 focus:border-zinc-400 focus:ring-1 focus:ring-zinc-400 focus:outline-none leading-relaxed transition"
	if p.Mono {
		base += " font-mono text-xs"
	}
	if p.Disabled {
		base += " cursor-not-allowed opacity-60 bg-zinc-900 border-zinc-800 text-zinc-400"
	}
	if p.Class != "" {
		base = strings.Join([]string{base, p.Class}, " ")
	}
	return base
}

templ Textarea(props TextareaProps) {
	<div class="space-y-1">
		if props.Label != "" {
			<label class="block text-xs font-medium text-zinc-300">
				{ props.Label }
				if props.Required {
					<span class="text-red-400 ml-0.5">*</span>
				}
			</label>
		}
		<textarea
			if props.ID != "" {
				id={ props.ID }
			}
			if props.Name != "" {
				name={ props.Name }
			}
			if props.Rows > 0 {
				rows={ strconv.Itoa(props.Rows) }
			} else {
				rows="4"
			}
			if props.Placeholder != "" {
				placeholder={ props.Placeholder }
			}
			if props.Required {
				required
			}
			if props.Disabled {
				disabled
			}
			if props.ReadOnly {
				readonly
			}
			if !props.Spellcheck {
				spellcheck="false"
			}
			if props.Bind != "" {
				data-bind={ props.Bind }
			}
			if props.OnKeyDown != "" {
				data-on:keydown={ props.OnKeyDown }
			}
			class={ props.textareaClasses() }
		>{ props.Value }</textarea>
		if props.HelperText != "" {
			<p class="text-[11px] text-zinc-500 leading-relaxed">{ props.HelperText }</p>
		}
		if props.ErrorText != "" {
			<p class="text-xs text-red-400">{ props.ErrorText }</p>
		}
	</div>
}
