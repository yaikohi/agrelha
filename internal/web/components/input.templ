package components

import (
	"strconv"
	"strings"
)

type InputProps struct {
	Type        string // text, password, file, number, etc. Default "text"
	Name        string
	Value       string
	Placeholder string
	Required    bool
	Disabled    bool
	ReadOnly    bool
	Bind        string // Evaluated by Datastar (data-bind)
	OnKeyDown   string // Evaluated by Datastar (data-on:keydown)
	OnChange    string // Evaluated by Datastar (data-on:change)
	Label       string
	HelperText  string
	ErrorText   string
	Class       string
	ID          string
	Mono        bool
}

func (p InputProps) inputClasses() string {
	base := "focus-accent w-full rounded-control border border-edge bg-seam px-3 py-2 font-pixel text-xs text-ink placeholder:text-ink-faint"
	if p.Mono {
		base += ""
	}
	if p.Disabled {
		base += " cursor-not-allowed text-ink-faint"
	}
	if p.Class != "" {
		base = strings.Join([]string{base, p.Class}, " ")
	}
	return base
}

templ Input(props InputProps) {
	<div class="space-y-1">
		if props.Label != "" {
			<label class="block font-pixel text-[11px] text-ink-faint">
				{ props.Label }
				if props.Required {
					<span class="ml-0.5 text-danger">*</span>
				}
			</label>
		}
		<input
			if props.ID != "" {
				id={ props.ID }
			}
			if props.Type != "" {
				type={ props.Type }
			} else {
				type="text"
			}
			if props.Name != "" {
				name={ props.Name }
			}
			if props.Value != "" {
				value={ props.Value }
			}
			if props.Placeholder != "" {
				placeholder={ props.Placeholder }
			}
			if props.Required {
				required
			}
			if props.Disabled {
				disabled
			}
			if props.ReadOnly {
				readonly
			}
			if props.Bind != "" {
				data-bind={ props.Bind }
			}
			if props.OnKeyDown != "" {
				data-on:keydown={ props.OnKeyDown }
			}
			if props.OnChange != "" {
				data-on:change={ props.OnChange }
			}
			class={ props.inputClasses() }
		/>
		if props.HelperText != "" {
			<p class="max-w-prose font-display text-sm leading-relaxed text-ink-muted">{ props.HelperText }</p>
		}
		if props.ErrorText != "" {
			<p class="font-pixel text-[11px] text-danger">{ props.ErrorText }</p>
		}
	</div>
}

type TextareaProps struct {
	Name        string
	Value       string
	Placeholder string
	Rows        int
	Required    bool
	Disabled    bool
	ReadOnly    bool
	Bind        string
	OnKeyDown   string
	Label       string
	HelperText  string
	ErrorText   string
	Class       string
	ID          string
	Mono        bool
	Spellcheck  bool
}

func (p TextareaProps) textareaClasses() string {
	base := "focus-accent w-full rounded-control border border-edge bg-seam p-3 font-pixel text-xs leading-relaxed text-ink placeholder:text-ink-faint"
	if p.Mono {
		base += " font-mono text-xs"
	}
	if p.Disabled {
		base += " cursor-not-allowed text-ink-faint"
	}
	if p.Class != "" {
		base = strings.Join([]string{base, p.Class}, " ")
	}
	return base
}

templ Textarea(props TextareaProps) {
	<div class="space-y-1">
		if props.Label != "" {
			<label class="block font-pixel text-[11px] text-ink-faint">
				{ props.Label }
				if props.Required {
					<span class="ml-0.5 text-danger">*</span>
				}
			</label>
		}
		<textarea
			if props.ID != "" {
				id={ props.ID }
			}
			if props.Name != "" {
				name={ props.Name }
			}
			if props.Rows > 0 {
				rows={ strconv.Itoa(props.Rows) }
			} else {
				rows="4"
			}
			if props.Placeholder != "" {
				placeholder={ props.Placeholder }
			}
			if props.Required {
				required
			}
			if props.Disabled {
				disabled
			}
			if props.ReadOnly {
				readonly
			}
			if !props.Spellcheck {
				spellcheck="false"
			}
			if props.Bind != "" {
				data-bind={ props.Bind }
			}
			if props.OnKeyDown != "" {
				data-on:keydown={ props.OnKeyDown }
			}
			class={ props.textareaClasses() }
		>{ props.Value }</textarea>
		if props.HelperText != "" {
			<p class="max-w-prose font-display text-sm leading-relaxed text-ink-muted">{ props.HelperText }</p>
		}
		if props.ErrorText != "" {
			<p class="font-pixel text-[11px] text-danger">{ props.ErrorText }</p>
		}
	</div>
}
