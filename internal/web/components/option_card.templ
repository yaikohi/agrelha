package components

import (
	"fmt"
	"strings"
)

type OptionCardProps struct {
	Name        string
	Value       string
	BindSignal  string // Datastar signal (e.g. "source" or "tier")
	Title       string
	Subtitle    string
	Description string
	Icon        string
	Badge       string
	OnClick     string
	Class       string
}

func (p OptionCardProps) cardClasses() string {
	base := "flex cursor-pointer select-none flex-col rounded-control border p-4 transition-colors hover:border-accent"
	if p.Class != "" {
		base = strings.Join([]string{base, p.Class}, " ")
	}
	return base
}

templ OptionCard(props OptionCardProps) {
	<label
		class={ props.cardClasses() }
		if props.BindSignal != "" && props.Value != "" {
			data-class={ fmt.Sprintf("{'border-accent': $%s == '%s', 'border-edge': $%s != '%s'}", props.BindSignal, props.Value, props.BindSignal, props.Value) }
		}
		if props.OnClick != "" {
			data-on:click={ props.OnClick }
		}
	>
		if props.Name != "" && props.Value != "" {
			<input
				type="radio"
				name={ props.Name }
				value={ props.Value }
				if props.BindSignal != "" {
					data-bind={ props.BindSignal }
				}
				class="sr-only"
			/>
		}
		<div class="flex items-start justify-between">
			<div class="flex items-center gap-3">
				if props.Icon != "" {
					<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-control border border-edge text-xl text-ink-muted">
						{ props.Icon }
					</div>
				}
				<div>
					<div class="flex items-center gap-2">
						<span class="font-display text-base font-semibold text-ink">{ props.Title }</span>
						if props.Badge != "" {
							<span class="font-pixel text-[11px] text-ink-faint">
								{ props.Badge }
							</span>
						}
					</div>
					if props.Subtitle != "" {
						<p class="mt-0.5 font-pixel text-[11px] text-ink-faint">{ props.Subtitle }</p>
					}
				</div>
			</div>
		</div>
		if props.Description != "" {
			<p class="mt-2 max-w-prose font-display text-sm leading-relaxed text-ink-muted">{ props.Description }</p>
		}
		{ children... }
	</label>
}
