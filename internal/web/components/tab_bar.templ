package components

import (
	"strings"
)

type TabItem struct {
	ID     string
	Label  string
	Href   string
	Active bool
	Badge  string
}

type TabBarProps struct {
	Tabs  []TabItem
	Class string
}

func (p TabBarProps) navClasses() string {
	base := "-mb-px flex flex-wrap gap-x-6 gap-y-2 font-pixel text-xs"
	if p.Class != "" {
		base = strings.Join([]string{base, p.Class}, " ")
	}
	return base
}

func tabStyle(active bool) string {
	if active {
		return TabLinkClass(true)
	}
	return TabLinkClass(false)
}

templ TabBar(props TabBarProps) {
	<div class="border-b border-seam">
		<nav class={ props.navClasses() }>
			for _, tab := range props.Tabs {
				<a
					href={ templ.SafeURL(tab.Href) }
					class={ tabStyle(tab.Active) }
				>
					{ tab.Label }
					if tab.Badge != "" {
						<span class="ml-1.5 font-pixel text-[11px] text-ink-faint">
							{ tab.Badge }
						</span>
					}
				</a>
			}
		</nav>
	</div>
}
