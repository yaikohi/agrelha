package components

type Variant string
type Size string

const (
	VariantPrimary   Variant = "primary"
	VariantSecondary Variant = "secondary"
	VariantSuccess   Variant = "success"
	VariantWarning   Variant = "warning"
	VariantDanger    Variant = "danger"
	VariantGhost     Variant = "ghost"
	VariantLink      Variant = "link"
	VariantDisabled  Variant = "disabled"

	SizeXs Size = "xs"
	SizeSm Size = "sm"
	SizeMd Size = "md"
	SizeLg Size = "lg"
)

type ButtonProps struct {
	Variant       Variant
	Size          Size
	Text          string
	Href          string
	OnClick       string
	Indicator     string
	LoadingText   string
	Type          string
	ID            string
	Disabled      bool
	DisabledTitle string
	Download      bool
	Title         string
	Class         string
}

func ButtonClass(v Variant) string {
	base := "focus-accent inline-flex items-center gap-2 rounded-control px-3 py-1.5 font-pixel text-xs transition-colors "
	if v == VariantDisabled {
		return base + "border border-edge text-ink-faint cursor-not-allowed"
	}
	return base + variantClass(v)
}

func InputClass() string {
	return "focus-accent w-full rounded-control border border-edge bg-seam px-3 py-2 font-pixel text-xs text-ink placeholder:text-ink-faint"
}

func TextareaClass() string {
	return "focus-accent w-full rounded-control border border-edge bg-seam p-3 font-pixel text-xs leading-relaxed text-ink placeholder:text-ink-faint"
}

func variantClass(v Variant) string {
	switch v {
	case VariantDanger:
		return "border border-edge text-ink-muted hover:border-danger hover:text-danger"
	case VariantSecondary, VariantGhost:
		return "border border-edge text-ink-muted hover:border-accent hover:text-accent"
	case VariantLink:
		return "text-ink-muted hover:text-accent"
	default:
		return "border border-accent text-accent hover:bg-accent hover:text-accent-ink"
	}
}

func sizeClass(s Size) string {
	switch s {
	case SizeLg:
		return "px-4 py-2 text-sm"
	case SizeMd:
		return "px-3.5 py-2 text-xs"
	default:
		return "px-3 py-1.5 text-xs"
	}
}

func (p ButtonProps) classes() string {
	base := "focus-accent inline-flex items-center gap-2 rounded-control font-pixel transition-colors "
	if p.Disabled {
		base += "border border-edge text-ink-faint cursor-not-allowed "
	} else {
		base += variantClass(p.Variant) + " "
	}
	base += sizeClass(p.Size)
	if p.Class != "" {
		base += " " + p.Class
	}
	return base
}

func (p ButtonProps) buttonType() string {
	if p.Type != "" {
		return p.Type
	}
	return "button"
}

func (p ButtonProps) title() string {
	if p.Disabled && p.DisabledTitle != "" {
		return p.DisabledTitle
	}
	return p.Title
}

templ Button(p ButtonProps) {
	if p.Href != "" && !p.Disabled {
		<a href={ templ.SafeURL(p.Href) } download?={ p.Download } title={ p.title() } class={ p.classes() }>{ p.Text }</a>
	} else {
		<button
			type={ p.buttonType() }
			disabled?={ p.Disabled }
			title={ p.title() }
			if p.OnClick != "" {
				data-on:click={ p.OnClick }
			}
			if p.Indicator != "" {
				data-indicator={ p.Indicator }
			}
			class={ p.classes() }
		>
			if p.Indicator != "" && p.LoadingText != "" {
				<span data-show={ "!$" + p.Indicator }>{ p.Text }</span>
				<span data-show={ "$" + p.Indicator }>{ p.LoadingText }</span>
			} else {
				{ p.Text }
			}
		</button>
	}
}
