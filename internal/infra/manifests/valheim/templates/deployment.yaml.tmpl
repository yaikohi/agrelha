apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .DeploymentName }}
  namespace: {{ .Namespace }}
  labels:
    app: {{ .DeploymentName }}
    role: valheim-instance
    instance: "{{ .Number }}"
    world: "{{ .Slug }}"
spec:
  replicas: {{ if eq .State "running" }}1{{ else }}0{{ end }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ .DeploymentName }}
  template:
    metadata:
      labels:
        app: {{ .DeploymentName }}
        role: valheim-instance
        instance: "{{ .Number }}"
        world: "{{ .Slug }}"
    spec:
{{- if .NodeSelectorKey }}
      nodeSelector:
        {{ .NodeSelectorKey }}: "{{ .NodeSelectorValue }}"
{{- end }}
      tolerations:
        - key: "dedicated"
          operator: "Equal"
          value: "gameserver"
          effect: "NoSchedule"
{{- if not .IsVanilla }}
      initContainers:
        - name: mod-reconciler
          image: alpine:3.20
          command: ["sh", "-c"]
          args:
            - |
              set -eu
              MODS=/config-mods/mods.txt
              DEST=/config/bepinex/plugins/managed
              CACHE=/config/bepinex/.cache

              rm -rf "$DEST"
              mkdir -p "$DEST" "$CACHE"

              if [ ! -s "$MODS" ] || ! grep -qvE '^[[:space:]]*(#|$)' "$MODS"; then
                echo ">> no mods declared - running clean BepInEx"
                chown -R 1000:1000 /config/bepinex 2>/dev/null || true
                exit 0
              fi

              apk add --no-cache curl unzip jq >/dev/null 2>&1

              ACTIVE=$(mktemp)
              grep -vE '^[[:space:]]*(#|$)' "$MODS" | tr -d '\r' | sed 's/[[:space:]]*$//; s/?$//' | while read -r entry; do
                [ -n "$entry" ] || continue
                case "$entry" in
                  */*/*) ns=${entry%%/*}; rest=${entry#*/}; name=${rest%%/*}; ver=${rest#*/} ;;
                  *-*)   ns=${entry%%-*}; name=${entry#*-}; ver="" ;;
                  *)     echo "ERROR: cannot parse mod entry '$entry'" >&2; exit 1 ;;
                esac

                if [ -z "$ver" ]; then
                  ver=$(curl -fsSL "https://thunderstore.io/api/experimental/package/$ns/$name/" | jq -re '.latest.version_number') || {
                    echo "ERROR: could not resolve latest version of $ns/$name" >&2
                    exit 1
                  }
                  echo ">> [resolved] $ns/$name -> $ver"
                fi

                zip="$CACHE/$ns-$name-$ver.zip"
                echo "$ns-$name-$ver.zip" >> "$ACTIVE"

                if [ ! -f "$zip" ]; then
                  echo ">> [downloading] $ns/$name/$ver"
                  tmpzip=$(mktemp)
                  if curl -fsSL "https://thunderstore.io/package/download/$ns/$name/$ver/" -o "$tmpzip"; then
                    mv "$tmpzip" "$zip"
                  else
                    rm -f "$tmpzip"
                    echo "ERROR: failed to download $ns/$name/$ver" >&2
                    exit 1
                  fi
                else
                  echo ">> [cached] $ns/$name/$ver"
                fi

                tmp=$(mktemp -d)
                unzip -oq "$zip" -d "$tmp"
                mkdir -p "$DEST/$name"
                find "$tmp" -iname '*.dll' -exec cp {} "$DEST/$name/" \;
                rm -rf "$tmp"
              done

              for f in "$CACHE"/*.zip; do
                [ -e "$f" ] || continue
                if ! grep -qxF "$(basename "$f")" "$ACTIVE" 2>/dev/null; then
                  echo ">> [pruning cache] $(basename "$f")"
                  rm -f "$f"
                fi
              done
              rm -f "$ACTIVE"

              echo ">> installed $(find "$DEST" -iname '*.dll' | wc -l) plugin dll(s)"
              chown -R 1000:1000 /config/bepinex 2>/dev/null || true
          volumeMounts:
            - name: config-volume
              mountPath: /config
            - name: mods-config
              mountPath: /config-mods
              readOnly: true
        - name: sync-configs
          image: busybox:1.36
          command: ["sh", "-c"]
          args:
            - |
              mkdir -p /config/bepinex/config
              if [ -d /custom-configs ] && [ "$(ls -A /custom-configs 2>/dev/null)" ]; then
                echo ">> Syncing custom mod configs to /config/bepinex/config..."
                cp -Lf /custom-configs/* /config/bepinex/config/ 2>/dev/null || true
              fi
          volumeMounts:
            - name: config-volume
              mountPath: /config
            - name: custom-configs
              mountPath: /custom-configs
{{- end }}
      containers:
        - name: valheim
          image: lloesche/valheim-server:latest
          imagePullPolicy: IfNotPresent
          envFrom:
            - configMapRef:
                name: {{ .ConfigCMName }}
          env:
            - name: SERVER_NAME
              value: {{ quote .Name }}
            - name: WORLD_NAME
              value: {{ quote .Slug }}
            - name: SERVER_PASS
              value: {{ quote .Password }}
            - name: SERVER_PUBLIC
              value: "true"
            - name: BEPINEX
              value: "{{ if .IsVanilla }}false{{ else }}true{{ end }}"
            - name: STATUS_HTTP
              value: "true"
            - name: SERVER_ARGS
              value: "-savedir /config/worlds_local"
            - name: TZ
              value: "Europe/Amsterdam"
          ports:
            - containerPort: 2456
              name: game
              protocol: UDP
            - containerPort: 2457
              name: query
              protocol: UDP
            - containerPort: 9001
              name: status
              protocol: TCP
          startupProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - ss -lun | grep -qE ':2456[[:space:]]'
            initialDelaySeconds: 15
            periodSeconds: 10
            failureThreshold: 60
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - ss -lun | grep -qE ':2456[[:space:]]'
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 3
          resources:
            requests:
              cpu: 2000m
              memory: {{ .MemoryGiB }}Gi
            limits:
              memory: {{ .MemoryLimitGiB }}Gi
          volumeMounts:
            - name: config-volume
              mountPath: /config
            - name: server-volume
              mountPath: /opt/valheim
            - name: backups-volume
              mountPath: /backups
{{- if not .IsVanilla }}
            - name: mods-config
              mountPath: /config-mods
              readOnly: true
            - name: custom-configs
              mountPath: /custom-configs
{{- end }}
      volumes:
        - name: config-volume
          persistentVolumeClaim:
            claimName: {{ .PVCName }}
        - name: server-volume
          emptyDir: {}
        - name: backups-volume
          persistentVolumeClaim:
            claimName: valheim-backups
{{- if not .IsVanilla }}
        - name: mods-config
          configMap:
            name: {{ .ModsCMName }}
            optional: true
        - name: custom-configs
          configMap:
            name: {{ .ConfigsCMName }}
            optional: true

{{- end }}