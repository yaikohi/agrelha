apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .DeploymentName }}
  namespace: {{ .Namespace }}
  labels:
    app: {{ .DeploymentName }}
    role: valheim-instance
    instance: "{{ .Number }}"
    world: "{{ .Slug }}"
spec:
  replicas: {{ if eq .State "running" }}1{{ else }}0{{ end }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ .DeploymentName }}
  template:
    metadata:
      labels:
        app: {{ .DeploymentName }}
        role: valheim-instance
        instance: "{{ .Number }}"
        world: "{{ .Slug }}"
    spec:
      imagePullSecrets:
        - name: agrelha-regcred
{{- if .NodeSelectorKey }}
      nodeSelector:
        {{ .NodeSelectorKey }}: "{{ .NodeSelectorValue }}"
{{- end }}
      tolerations:
        - key: "dedicated"
          operator: "Equal"
          value: "gameserver"
          effect: "NoSchedule"
{{- if not .IsVanilla }}
      initContainers:
        - name: mod-reconciler
          image: alpine:3.20
          command: ["sh", "-c"]
          args:
            - |
              set -eu
              MODS=/config-mods/mods.txt
              DEST=/config/bepinex/plugins/managed
              CACHE=/config/bepinex/.cache

              rm -rf "$DEST"
              mkdir -p "$DEST" "$CACHE"

              if [ ! -s "$MODS" ] || ! grep -qvE '^[[:space:]]*(#|$)' "$MODS"; then
                echo ">> no mods declared - running clean BepInEx"
                chown -R 1000:1000 /config/bepinex 2>/dev/null || true
                exit 0
              fi

              apk add --no-cache curl unzip jq >/dev/null 2>&1

              # Thunderstore being down and a mod being deleted are different
              # problems. curl -f collapses both into exit 22, so ask for the
              # status: 404/410 is permanent and reported at once, 5xx and
              # connection failures are retried. Kubernetes retries a failed
              # init container too, but its backoff grows to five minutes -
              # far too blunt for a momentary blip.
              ATTEMPTS=3
              RETRY_SLEEP=3

              http_get() { # url outfile -> prints status
                # curl already prints 000 for a connection failure, so only
                # substitute when it printed nothing at all.
                code=$(curl -sSL -o "$2" -w '%{http_code}' "$1" 2>/dev/null) || true
                [ -n "$code" ] || code=000
                printf '%s' "$code"
              }

              fetch_file() { # url outfile
                url=$1; out=$2; n=1
                while :; do
                  code=$(http_get "$url" "$out")
                  case "$code" in
                    2??) return 0 ;;
                    404|410)
                      echo "ERROR: $url no longer exists on Thunderstore (HTTP $code)" >&2
                      return 1 ;;
                  esac
                  if [ "$n" -ge "$ATTEMPTS" ]; then
                    echo "ERROR: $url failed after $n attempts (last HTTP $code)" >&2
                    return 1
                  fi
                  echo ">> [retry $n/$ATTEMPTS] HTTP $code from $url"
                  n=$((n+1)); sleep "$RETRY_SLEEP"
                done
              }

              fetch_latest() { # ns name -> prints version
                body=$(mktemp)
                if ! fetch_file "https://thunderstore.io/api/experimental/package/$1/$2/" "$body"; then
                  rm -f "$body"; return 1
                fi
                ver=$(jq -re '.latest.version_number' < "$body" 2>/dev/null) || {
                  echo "ERROR: $1/$2 returned no version" >&2; rm -f "$body"; return 1
                }
                rm -f "$body"; printf '%s' "$ver"
              }

              ACTIVE=$(mktemp)
              grep -vE '^[[:space:]]*(#|$)' "$MODS" | tr -d '\r' | sed 's/[[:space:]]*$//; s/?$//' | while read -r entry; do
                [ -n "$entry" ] || continue
                case "$entry" in
                  */*/*) ns=${entry%%/*}; rest=${entry#*/}; name=${rest%%/*}; ver=${rest#*/} ;;
                  *-*)
                    # Thunderstore's canonical id is Namespace-Name-Version, which
                    # is what its own copy button gives you. Package names never
                    # contain hyphens (they use underscores), so a trailing
                    # semver segment is the version and not part of the name.
                    ns=${entry%%-*}; rest=${entry#*-}
                    case "$rest" in
                      *-[0-9]*.[0-9]*.[0-9]*) name=${rest%-*}; ver=${rest##*-} ;;
                      *)                      name=$rest;      ver="" ;;
                    esac
                    ;;
                  *)     echo "ERROR: cannot parse mod entry '$entry'" >&2; exit 1 ;;
                esac

                if [ -z "$ver" ]; then
                  ver=$(fetch_latest "$ns" "$name") || exit 1
                  echo ">> [resolved] $ns/$name -> $ver"
                fi

                zip="$CACHE/$ns-$name-$ver.zip"
                echo "$ns-$name-$ver.zip" >> "$ACTIVE"

                if [ ! -f "$zip" ]; then
                  echo ">> [downloading] $ns/$name/$ver"
                  tmpzip=$(mktemp)
                  if fetch_file "https://thunderstore.io/package/download/$ns/$name/$ver/" "$tmpzip"; then
                    mv "$tmpzip" "$zip"
                  else
                    rm -f "$tmpzip"
                    exit 1
                  fi
                else
                  echo ">> [cached] $ns/$name/$ver"
                fi

                tmp=$(mktemp -d)
                # unzip exits 1 for warnings, not just errors - a mod packed on
                # Windows warns about backslash separators and would otherwise
                # take the whole server down under set -e. Only 2+ is fatal.
                rc=0
                unzip -oq "$zip" -d "$tmp" || rc=$?
                if [ "$rc" -gt 1 ]; then
                  echo "ERROR: cannot unpack $ns/$name/$ver (unzip exit $rc)" >&2
                  exit 1
                fi
                mkdir -p "$DEST/$name"
                find "$tmp" -iname '*.dll' -exec cp {} "$DEST/$name/" \;
                rm -rf "$tmp"
              done

              for f in "$CACHE"/*.zip; do
                [ -e "$f" ] || continue
                if ! grep -qxF "$(basename "$f")" "$ACTIVE" 2>/dev/null; then
                  echo ">> [pruning cache] $(basename "$f")"
                  rm -f "$f"
                fi
              done
              rm -f "$ACTIVE"

              echo ">> installed $(find "$DEST" -iname '*.dll' | wc -l) plugin dll(s)"
              chown -R 1000:1000 /config/bepinex 2>/dev/null || true
          volumeMounts:
            - name: config-volume
              mountPath: /config
            - name: mods-config
              mountPath: /config-mods
              readOnly: true
        - name: config-merge
          image: registry.ykhi.xyz/agrelha:0.29.2
          command: ["/app/main", "bepinex", "merge"]
          args:
            - "--generated=/config/bepinex"
            - "--overrides=/custom-configs"
            - "--out=/config/bepinex"
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 128Mi
          volumeMounts:
            - name: config-volume
              mountPath: /config
            - name: custom-configs
              mountPath: /custom-configs
{{- end }}
      containers:
        - name: valheim
          # Pinned: the game self-updates from Steam regardless, so the tag only
          # controls the wrapper. Unpinned, a bad wrapper release lands on every
          # world at once on the next restart.
          image: lloesche/valheim-server@sha256:bbda47cbbc9fd7b0385803ba0a70ba2084df4cb87ec6170a145aec5df06be07e
          imagePullPolicy: IfNotPresent
          envFrom:
            - configMapRef:
                name: {{ .ConfigCMName }}
            - configMapRef:
                name: valheim-admins
                optional: true
          env:
            - name: SERVER_NAME
              value: {{ quote .Name }}
            - name: WORLD_NAME
              value: {{ quote .Slug }}
            - name: SERVER_PASS
              value: {{ quote .Password }}
            - name: SERVER_PUBLIC
              value: "true"
            - name: BEPINEX
              value: "{{ if .IsVanilla }}false{{ else }}true{{ end }}"
            - name: STATUS_HTTP
              value: "true"
            # The image serves status.json on :80 by default, but containerPort
            # and the Service both declare 9001 - so status.json would be
            # reachable only from inside the pod, and agrelha could not tell
            # whether anyone was playing. Make served and declared agree.
            - name: STATUS_HTTP_PORT
              value: "9001"
            - name: SERVER_ARGS
              value: "-savedir /config/worlds_local"
            # Without this the image backs up to /config/backups - the SAME
            # node-local PVC as the world, so one lost disk takes the world and
            # every backup of it together. /backups is the NAS NFS export.
            # Per-instance subdir: every archive is named worlds-<ts>.zip, so a
            # shared directory would collide across instances.
            - name: BACKUPS_DIRECTORY
              value: "/backups/{{ .BackupsSubdir }}"
            - name: BACKUPS_MAX_AGE
              value: "14"
            - name: TZ
              value: "Europe/Amsterdam"
            - name: POST_BOOTSTRAP_HOOK
              value: "mkdir -p /config/worlds_local && cp -f /config/adminlist.txt /config/bannedlist.txt /config/permittedlist.txt /config/worlds_local/ 2>/dev/null || true"
{{- if not .IsVanilla }}
            - name: PRE_BEPINEX_CONFIG_HOOK
              value: "mkdir -p \"$plugins_path\""
            - name: PRE_SERVER_RUN_HOOK
              value: "mkdir -p /config/worlds_local /opt/valheim/bepinex/BepInEx/plugins && cp -f /config/adminlist.txt /config/bannedlist.txt /config/permittedlist.txt /config/worlds_local/ 2>/dev/null || true; [ -d /config/bepinex/plugins ] && rsync -a --delete /config/bepinex/plugins/ /opt/valheim/bepinex/BepInEx/plugins/ || true"
{{- else }}
            - name: PRE_SERVER_RUN_HOOK
              value: "mkdir -p /config/worlds_local && cp -f /config/adminlist.txt /config/bannedlist.txt /config/permittedlist.txt /config/worlds_local/ 2>/dev/null || true"
{{- end }}
          ports:
            - containerPort: 2456
              name: game
              protocol: UDP
            - containerPort: 2457
              name: query
              protocol: UDP
            - containerPort: 9001
              name: status
              protocol: TCP
          startupProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - ss -lun | grep -qE ':2456[[:space:]]'
            initialDelaySeconds: 15
            periodSeconds: 10
            failureThreshold: 60
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - ss -lun | grep -qE ':2456[[:space:]]'
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 3
          resources:
            requests:
              cpu: 2000m
              memory: {{ .MemoryGiB }}Gi
            limits:
              memory: {{ .MemoryLimitGiB }}Gi
          volumeMounts:
            - name: config-volume
              mountPath: /config
            - name: server-volume
              mountPath: /opt/valheim
            - name: backups-volume
              mountPath: /backups
{{- if not .IsVanilla }}
            - name: mods-config
              mountPath: /config-mods
              readOnly: true
            - name: custom-configs
              mountPath: /custom-configs
{{- end }}

        # Publishes "is a Valheim server update available?" for agrelha, which
        # cannot work it out itself: it has no pods/exec here (deliberate, see
        # agrelha-rbac.yaml) and the log is no help either - valheim-updater's
        # update() returns silently when players are online, without ever asking
        # Steam. So nothing is logged while an update sits waiting.
        # Same image as the server (already on the node, already has steamcmd),
        # so this adds no new image, no RBAC and no third-party service.
        - name: build-watch
          image: lloesche/valheim-server@sha256:bbda47cbbc9fd7b0385803ba0a70ba2084df4cb87ec6170a145aec5df06be07e
          imagePullPolicy: IfNotPresent
          command: ["/bin/bash", "-c"]
          args:
            - |
              set -uo pipefail
              OUT=/backups/{{ .BackupsSubdir }}/server-build.json
              MANIFEST=/opt/valheim/dl/server/steamapps/appmanifest_896660.acf
              mkdir -p "$(dirname "$OUT")"
              while true; do
                installed=$(grep -oE '"buildid"[[:space:]]+"[0-9]+"' "$MANIFEST" 2>/dev/null \
                  | grep -oE '[0-9]+' | head -1)

                # /opt/valheim is an emptyDir, so on a fresh pod the server has not
                # finished downloading yet and there is no installed build to read.
                # Retry soon instead of sleeping the full interval - otherwise every
                # restart leaves the build report stale for half an hour. Skipping
                # the Steam call here too: it cannot answer a question we have no
                # local half of.
                if [ -z "${installed:-}" ] || [ "$installed" = "0" ]; then
                  echo "build-watch: no installed build yet, retrying in 30s" >&2
                  sleep 30
                  continue
                fi

                # cd first: steamcmd needs its own directory as cwd, which is how
                # valheim-updater invokes it too.
                latest=$(cd /opt/steamcmd && timeout 300 ./steamcmd.sh +login anonymous \
                  +app_info_update 1 +app_info_print 896660 +quit 2>/dev/null \
                  | awk '/"branches"/,0' | awk '/"public"/,0' \
                  | grep -m1 -oE '"buildid"[[:space:]]+"[0-9]+"' | grep -oE '[0-9]+')

                # A failed Steam query must not erase a good answer, or the UI would
                # flap to "unknown" on any transient network blip.
                if [ -z "${latest:-}" ]; then
                  echo "build-watch: steam query failed, retrying in 60s" >&2
                  sleep 60
                  continue
                fi

                printf '{"instance":"{{ .BackupsSubdir }}","installed":"%s","latest":"%s","checked_at":"%s"}\n' \
                  "$installed" "$latest" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$OUT"
                sleep 1800
              done
          resources:
            requests:
              cpu: 10m
              memory: 64Mi
            limits:
              memory: 256Mi
          volumeMounts:
            - name: server-volume
              mountPath: /opt/valheim
              readOnly: true
            - name: backups-volume
              mountPath: /backups
{{- if not .IsVanilla }}
        - name: config-publish
          image: busybox:1.36
          command: ["sh", "-c"]
          args:
            - |
              SRC=/config/bepinex
              DST=/backups/{{ .BackupsSubdir }}/bepinex-configs
              last=""
              while true; do
                # Cheap change detection: names, sizes and mtimes of the .cfg
                # files. The 651 KB copy only happens when a mod actually
                # rewrote something, which is rare; the listing is free.
                stamp=$(ls -l "$SRC"/*.cfg 2>/dev/null | sha256sum)
                if [ "$stamp" != "$last" ]; then
                  tmp="${DST}.tmp"
                  rm -rf "$tmp"
                  mkdir -p "$tmp"

                  # Depth 1 only: plugins/, .cache/ and AdminPanelCompanion/ are
                  # siblings of the config files, not part of them. *.default is
                  # BepInEx's shipped copy, not live configuration.
                  copied=0
                  for f in "$SRC"/*.cfg; do
                    [ -f "$f" ] || continue
                    case "$f" in *.default) continue ;; esac
                    cp -f "$f" "$tmp/" 2>/dev/null && copied=$((copied+1))
                  done

                  # index.json is written LAST and is what agrelha looks for, so
                  # a half-finished publish is never read as a complete one.
                  {
                    printf '{"instance":"{{ .BackupsSubdir }}","published_at":"%s","files":[' \
                      "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
                    first=1
                    for f in "$tmp"/*.cfg; do
                      [ -f "$f" ] || continue
                      [ "$first" -eq 1 ] || printf ','
                      first=0
                      printf '{"name":"%s","size":%s,"sha256":"%s","modified":"%s"}' \
                        "$(basename "$f")" \
                        "$(wc -c < "$f" | tr -d ' ')" \
                        "$(sha256sum "$f" | cut -d' ' -f1)" \
                        "$(date -u -r "$f" +%Y-%m-%dT%H:%M:%SZ)"
                    done
                    printf ']}\n'
                  } > "$tmp/index.json"

                  rm -rf "$DST"
                  mv "$tmp" "$DST"
                  echo "config-publish: published $copied config(s)" >&2
                  last="$stamp"
                fi
                sleep 60
              done
          resources:
            requests:
              cpu: 10m
              memory: 64Mi
            limits:
              memory: 128Mi
          volumeMounts:
            - name: config-volume
              mountPath: /config
              readOnly: true
            - name: backups-volume
              mountPath: /backups
{{- end }}
      volumes:
        - name: config-volume
          persistentVolumeClaim:
            claimName: {{ .PVCName }}
        - name: server-volume
          emptyDir: {}
        - name: backups-volume
          persistentVolumeClaim:
            claimName: valheim-backups
{{- if not .IsVanilla }}
        - name: mods-config
          configMap:
            name: {{ .ModsCMName }}
            optional: true
        - name: custom-configs
          configMap:
            name: {{ .ConfigsCMName }}
            optional: true

{{- end }}