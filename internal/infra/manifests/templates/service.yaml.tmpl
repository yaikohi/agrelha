apiVersion: v1
kind: Service
metadata:
  name: {{ .ServiceName }}
  namespace: {{ .Namespace }}
  labels:
    app: {{ .DeploymentName }}
    instance: "{{ .Number }}"
{{- if .LBIP }}
  annotations:
    io.cilium/lb-ipam-ips: "{{ .LBIP }}"
{{- end }}
spec:
  type: LoadBalancer
{{- if .LBIP }}
  loadBalancerIP: {{ .LBIP }}
{{- end }}
  selector:
    app: {{ .DeploymentName }}
  ports:
    - name: minecraft
      port: 25565
      targetPort: 25565
      protocol: TCP
    - name: query
      port: 25565
      targetPort: 25565
      protocol: UDP
    - name: rcon
      port: 25575
      targetPort: 25575
      protocol: TCP
