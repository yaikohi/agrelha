# Local dev env for agrelha (loaded via godotenv/autoload). In-cluster these come
# from the agrelha-config ConfigMap + agrelha-env Secret. Copy to .env for `task watch`.
LISTEN_ADDR=:8080
DB_PATH=./agrelha.db

# Auth (leave OIDC_ISSUER empty to disable auth in local dev)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
ALLOWED_EMAIL=some.one@gmail.com

# Declarative plane (git)
GIT_REPO_URL=https://codeberg.org/ykhi/yaya-ops.git
GIT_BRANCH=main
# Git forge credentials (any forge: GitHub, GitLab, Gitea, Codeberg…).
# CODEBERG_USERNAME / CODEBERG_TOKEN are still read as a fallback.
GIT_USERNAME=
GIT_TOKEN=
GIT_AUTHOR_NAME=agrelha
GIT_AUTHOR_EMAIL=agrelha@ykhi.xyz
MODS_PATH=manifests/valheim-mods.yaml
ADMINS_PATH=manifests/valheim-admins.yaml
MOD_CONFIGS_PATH=manifests/valheim-mod-configs.yaml

# Mods (Thunderstore)
THUNDERSTORE_API=https://thunderstore.io/c/valheim/api/v1

# Imperative plane (k8s) — unset in local dev; only works in-cluster
VALHEIM_NAMESPACE=valheim
VALHEIM_DEPLOYMENT=valheim
VALHEIM_STATUS_URL=

# Observability
INFLUXDB_URL=
GRAFANA_DASHBOARD_URL=https://grafana.ykhi.xyz/d/valheim
# Read-only mount of the NAS backup export; empty disables the backup tile
BACKUPS_DIR=
# slog: LOG_LEVEL=debug|info|warn|error, LOG_FORMAT=text|json
LOG_LEVEL=info
LOG_FORMAT=text

# --- Deployment shape (all optional; defaults suit a fresh cluster) ---
# Restrict game workloads to labelled nodes, e.g. "gameserver=true".
# Empty (default) schedules anywhere.
GAME_NODE_SELECTOR=
# Cosmetic: node name shown in the UI.
GAME_NODE_NAME=
# Where per-Instance manifests are written in the ops repo.
MC_INSTANCES_PATH=manifests/minecraft-modded
# First LoadBalancer address; Instance N gets the Nth address after it.
MC_LB_BASE_IP=
# Valheim connect address shown to players, e.g. "10.0.0.10:2456".
VALHEIM_ADDRESS=
